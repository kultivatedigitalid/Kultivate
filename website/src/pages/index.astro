---
const site = Astro.site ?? new URL('https://kultivate.id');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="refresh" content="0;url=/en/" />
  <link rel="canonical" href={new URL('/en/', site).href} />
  <title>Kultivate - Structured Search Growth</title>
  <meta name="robots" content="noindex, follow" />
  <script is:inline>
    window.location.replace('/en/');
  </script>
</head>
<body style="background-color: #070B12; color: #F4F7FB; font-family: sans-serif; display: flex; align-items: center; justify-content: center; min-height: 100vh;">
  <div style="text-align: center;">
    <p>Opening the English site...</p>
    <p style="margin-top: 10px; font-size: 0.875rem; color: #7A8798;">
      If the page does not redirect, <a href="/en/" style="color: #176BFF; text-decoration: underline;">continue here</a>.
    </p>
  </div>
</body>
</html>
