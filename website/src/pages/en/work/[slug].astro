---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CaseStudy from '../../../components/work/CaseStudy.astro';
import FinalCTA from '../../../components/home/FinalCTA.astro';
import { getProjects } from '../../../data/work';
import { render } from 'astro:content';

const locale = 'en';
export async function getStaticPaths() {
  const projects = await getProjects('en');
  return projects.map((project, index) => ({
    params: { slug: project.data.slug },
    props: { project, nextProject: projects.length > 1 ? projects[(index + 1) % projects.length] : null },
  }));
}
const { project, nextProject } = Astro.props;
const { Content } = await render(project);
---
<BaseLayout locale={locale} title={project.data.seoTitle || project.data.title} description={project.data.seoDescription || project.data.summary} socialImage={project.data.coverImage} socialImageAlt={project.data.coverAlt}>
  <CaseStudy project={project} nextProject={nextProject} locale={locale}><Content /></CaseStudy>
  <FinalCTA locale={locale} />
</BaseLayout>
