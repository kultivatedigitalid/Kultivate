---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrivacyPolicy from '../../components/legal/PrivacyPolicy.astro';
import { siteConfig } from '../../data/site';

const locale = 'en';
const privacyRequestHref = `mailto:${siteConfig.email}?subject=${encodeURIComponent('Data deletion request')}&body=${encodeURIComponent('Full name:\nEmail address or WhatsApp number used on the form:\nApproximate form submission date:\n\nPlease delete the data I submitted through the Kultivate website form.')}`;
const sections = [
  { id: 'data-collected', title: 'Data We Collect' },
  { id: 'use-and-access', title: 'Use and Access' },
  { id: 'form-processing', title: 'Form Processing' },
  { id: 'retention-and-deletion', title: 'Retention and Deletion' },
  { id: 'analytics-and-cookies', title: 'Analytics and Cookies' },
  { id: 'privacy-contact', title: 'Privacy Contact' }
];
---

<BaseLayout
  locale={locale}
  title="Privacy Policy - Kultivate"
  description="Kultivate privacy policy regarding visitor personal data protection and form submissions."
>
  <PrivacyPolicy locale={locale} intro="What we collect, why it is needed, and how you stay in control." updated="Effective date: August 13, 2026" sections={sections}>
    <section id="data-collected">
      <h2>1. Data We Collect</h2>
      <p>
        We retain the information you submit through the contact form: name, company, email, WhatsApp number, service interest, project summary, and target timeline.
      </p>
    </section>
    <section id="use-and-access">
      <h2>2. Use and Access</h2>
      <p>
        We use this data to review your needs, respond to inquiries, prepare a scope of work, and communicate about the project. Access is limited to Kultivate team members who need it for these purposes.
      </p>
    </section>
    <section id="form-processing">
      <h2>3. Form Processing</h2>
      <p>
        Form submissions are delivered through Formspree as our form processor. Beyond that technical processing, Kultivate does not sell or share form data with other parties for marketing.
      </p>
    </section>
    <section id="retention-and-deletion">
      <h2>4. Retention and Deletion</h2>
      <p>
        Kultivate retains form data until you request deletion. Use our <a href={privacyRequestHref}>data deletion email template</a> so we can locate the correct information and confirm when the request is complete.
      </p>
    </section>
    <section id="analytics-and-cookies">
      <h2>5. Analytics and Cookies</h2>
      <p>
        This website currently does not use analytics or tracking cookies. Cookies required by third-party services are limited to the technical needs of those services.
      </p>
    </section>
    <section id="privacy-contact">
      <h2>6. Privacy Contact</h2>
      <p>
        Questions, corrections, or deletion requests can be sent to <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>.
      </p>
    </section>
  </PrivacyPolicy>
</BaseLayout>
