---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InteriorHero from '../../components/shared/InteriorHero.astro';
import FinalCTA from '../../components/home/FinalCTA.astro';
import { siteConfig } from '../../data/site';

const locale = 'en';
---

<BaseLayout 
  locale={locale} 
  title="Privacy Policy - Kultivate" 
  description="Kultivate privacy policy regarding visitor personal data protection and form submissions."
>
  <InteriorHero
    label="PRIVACY"
    title="Privacy without the puzzle."
    description="What we collect, why it is needed, and how you stay in control."
    image="/assets/why/visible-decisions.webp"
    imageAlt="Transparent planes moving into exact alignment"
    compact
  />

  <section class="section privacy-content-section">
    <div class="container">
      <div class="privacy-card card">
        <h2>1. Information Collection</h2>
        <p>
          We collect personal information directly provided by you when submitting forms on this website, including your full name, email address, WhatsApp contact number, company/brand name, and project requirements.
        </p>

        <h2>2. Use of Information</h2>
        <p>
          Collected data is strictly used to evaluate and respond to your project inquiries, prepare service scope proposals, and communicate regarding project deliverables. We do not sell or share personal data with third parties for marketing purposes.
        </p>

        <h2>3. Static Form Processing</h2>
        <p>
          Forms on this static site are processed using encrypted static form providers ({siteConfig.formEndpoint.includes('formspree') ? 'Formspree' : 'Approved Form Processor'}). Submitted data is securely handled via industry-standard HTTPS protocols.
        </p>

        <h2>4. Analytics & Cookie Policy</h2>
        <p>
          This website may utilize anonymous analytical cookies (such as Google Analytics) to monitor traffic patterns and improve user experience. You may configure or reject cookies via your browser preference settings.
        </p>

        <h2>5. Data Protection Contact</h2>
        <p>
          If you have questions regarding this Privacy Policy or wish to request data updates/removal, please contact us directly via email at <strong>{siteConfig.email}</strong>.
        </p>

        <p class="last-updated text-mono">Last updated: August 6, 2026</p>
      </div>
    </div>
  </section>

  <FinalCTA locale={locale} />
</BaseLayout>

<style>
  .privacy-hero {
    padding-top: var(--spacing-xxl);
    padding-bottom: var(--spacing-xl);
    border-bottom: 1px solid var(--slate);
  }

  .section-label {
    display: inline-block;
    font-size: 0.75rem;
    color: var(--cyan-glow);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--spacing-xs);
  }

  .page-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    color: var(--cloud-white);
    line-height: 1.1;
    margin-bottom: var(--spacing-sm);
  }

  .page-intro {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    color: var(--mist);
    max-width: 720px;
    line-height: 1.5;
  }

  .privacy-content-section {
    padding-top: var(--spacing-xxl);
    padding-bottom: var(--spacing-xxl);
  }

  .privacy-card {
    padding: 0;
    background: transparent;
    max-width: 760px;
    margin: 0 auto;
  }

  .privacy-card h2 {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--cyan-glow);
    margin-top: var(--spacing-lg);
    margin-bottom: var(--spacing-sm);
  }

  .privacy-card h2:first-of-type {
    margin-top: 0;
  }

  .privacy-card p {
    font-size: 1rem;
    color: var(--mist);
    line-height: 1.7;
    margin-bottom: var(--spacing-md);
  }

  .last-updated {
    font-size: 0.8125rem;
    color: var(--steel);
    margin-top: var(--spacing-xl);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--slate);
  }
</style>
