---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ServiceHero from '../../../components/services/ServiceHero.astro';
import ServiceProblems from '../../../components/services/ServiceProblems.astro';
import ServiceScope from '../../../components/services/ServiceScope.astro';
import ServiceProcess from '../../../components/services/ServiceProcess.astro';
import ServiceFAQ from '../../../components/services/ServiceFAQ.astro';
import FinalCTA from '../../../components/home/FinalCTA.astro';
import { servicesData } from '../../../data/services';

const locale = 'en';

export async function getStaticPaths() {
  const items = servicesData['en'];
  return items.map(service => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

const { service } = Astro.props;

// Format data for subcomponents
const problemItems = service.problemsSolved.map(p => ({ title: p, description: '' }));

const scopeItems = [
  {
    title: 'Scope options',
    items: service.scope
  },
  {
    title: 'Typical deliverables',
    items: service.deliverables
  },
  {
    title: 'Useful for',
    items: service.whoItIsFor
  }
];

const processSteps = service.process.map(p => {
  const parts = p.split(': ');
  return {
    step: parts[0].toUpperCase(),
    name: parts[0],
    description: parts[1] || p
  };
});

const defaultFaqs = [
  {
    question: `How do you decide the scope of a ${service.title} project?`,
    answer: `We begin with your current position, priorities, and internal capacity. The scope covers the work that needs attention and leaves out work that does not.`
  },
  {
    question: `Can ${service.title} be used on its own?`,
    answer: `Yes. Each service can stand on its own or be combined with others when the work overlaps. We recommend the smallest useful scope for your priorities.`
  },
  {
    question: `How will we communicate during the project?`,
    answer: `We agree on a practical update rhythm before work begins and explain decisions, dependencies, and deliverables in plain language.`
  }
];
---

<BaseLayout 
  locale={locale} 
  title={`${service.title} - Kultivate Services`} 
  description={service.description}
>
  <ServiceHero
    title={service.title}
    tagline={service.tagline}
    description={service.description}
    systemRole="KULTIVATE SERVICE"
    locale={locale}
  />

  <ServiceProblems
    heading="Start with what you need"
    problems={problemItems}
    locale={locale}
  />

  <ServiceScope
    heading="What we can take care of"
    scopes={scopeItems}
    locale={locale}
  />

  <ServiceProcess
    heading="How we approach the work"
    steps={processSteps}
    locale={locale}
  />

  <ServiceFAQ
    heading="What teams usually want to know"
    faqs={defaultFaqs}
  />

  <FinalCTA locale={locale} />
</BaseLayout>
