---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InteriorHero from '../../components/shared/InteriorHero.astro';
import FinalCTA from '../../components/home/FinalCTA.astro';
import { useTranslations } from '../../i18n/routes';

const locale = 'en';
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  title="Consult with Kultivate"
  description="Tell us what needs attention. We will review the context before recommending any work."
>
  <InteriorHero
    label="CONTACT"
    variant="contact"
    title="Tell us what needs attention"
    description="Share your current position, priorities, and the support you are considering. We will review the context before recommending any work."
    image="/assets/banners/contact.webp"
    imageAlt="Blue paths of light joining into one structure"
    compact
  />

  <section class="section contact-section flow-section" data-scroll-key="contact-form">
    <div class="container">
      <div class="contact-grid" data-reveal>
        <!-- Form Column -->
        <div class="contact-form-col card">
          <form id="contact-form" class="contact-form" data-submission-enabled="false">
            <p class="form-preview-note" role="note">This form previews the planned fields. Submission is disabled until the endpoint and contact details are confirmed.</p>
            <div class="form-row">
              <div class="form-group">
                <label for="name" class="form-label">{t('contact.name')} <span class="required">*</span></label>
                <input type="text" id="name" name="name" required placeholder={t('contact.placeholder_name')} class="form-input" />
              </div>
              <div class="form-group">
                <label for="company" class="form-label">{t('contact.company')} <span class="required">*</span></label>
                <input type="text" id="company" name="company" required placeholder={t('contact.placeholder_company')} class="form-input" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="email" class="form-label">{t('contact.email')} <span class="required">*</span></label>
                <input type="email" id="email" name="email" required placeholder={t('contact.placeholder_email')} class="form-input" />
              </div>
              <div class="form-group">
                <label for="whatsapp" class="form-label">{t('contact.whatsapp')} <span class="required">*</span></label>
                <input type="tel" id="whatsapp" name="whatsapp" required placeholder={t('contact.placeholder_whatsapp')} class="form-input" />
              </div>
            </div>

            <div class="form-group">
              <label for="service" class="form-label">{t('contact.service_interest')} <span class="required">*</span></label>
              <select id="service" name="service" required class="form-select">
                <option value="">-- Select Service --</option>
                <option value="seo">{t('contact.service_seo')}</option>
                <option value="aeo-geo">{t('contact.service_system')}</option>
                <option value="web-services">{t('contact.service_web')}</option>
                <option value="content-management">{t('contact.service_social')}</option>
              </select>
            </div>

            <div class="form-group">
              <label for="summary" class="form-label">{t('contact.summary')} <span class="required">*</span></label>
              <textarea id="summary" name="summary" rows="4" required placeholder={t('contact.placeholder_summary')} class="form-textarea"></textarea>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="timeline" class="form-label">{t('contact.timeline')}</label>
                <select id="timeline" name="timeline" class="form-select">
                  <option value="">{t('contact.placeholder_timeline')}</option>
                  <option value="asap">As soon as possible</option>
                  <option value="1-2months">Within 1–2 months</option>
                  <option value="flexible">Still planning</option>
                </select>
              </div>
              <div class="form-group">
                <label for="budget" class="form-label">{t('contact.budget')}</label>
                <select id="budget" name="budget" class="form-select">
                  <option value="">{t('contact.placeholder_budget')}</option>
                  <option value="tier1">&lt; IDR 15 million</option>
                  <option value="tier2">IDR 15 million - IDR 35 million</option>
                  <option value="tier3">&gt; IDR 35 million</option>
                </select>
              </div>
            </div>

            <div class="form-group checkbox-group">
              <input type="checkbox" id="consent" name="consent" required class="form-checkbox" />
              <label for="consent" class="checkbox-label">
                {t('contact.consent')}
              </label>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary btn-cta w-full" disabled aria-disabled="true">
                {t('contact.submit')}
              </button>
            </div>
            <p class="form-status" data-form-status role="status" aria-live="polite"></p>
          </form>
        </div>

        <!-- Contact details remain visibly pending until confirmed. -->
        <div class="contact-info-col">
          <div class="info-card card contact-pending" role="note">
            <span class="text-mono">CONTACT DETAILS</span>
            <h2 class="info-title">Contact details are being finalized</h2>
            <p class="info-desc">
              Public WhatsApp, email, address, and legal details will appear after confirmation.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <FinalCTA locale={locale} />
</BaseLayout>

<style>
  .contact-section {
    margin-top: -1px;
    padding-top: clamp(44px, 6vw, 76px);
    background: linear-gradient(180deg, #070b12 0%, #05080e 58%, #070b12 100%);
    padding-bottom: var(--spacing-xxl);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xxl);
  }

  @media (min-width: 992px) {
    .contact-grid {
      grid-template-columns: 3fr 2fr;
    }
  }

  .contact-form-col {
    padding: var(--spacing-xl);
    background-color: var(--deep-navy);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md);
  }

  @media (min-width: 640px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .form-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--cloud-white);
  }

  .required {
    color: var(--error);
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    padding: 12px var(--spacing-sm);
    background-color: var(--void-black);
    border: 1px solid var(--slate);
    border-radius: var(--border-radius-sm);
    color: var(--cloud-white);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--electric-blue);
  }

  .checkbox-group {
    flex-direction: row;
    align-items: flex-start;
    gap: var(--spacing-xs);
    margin-top: var(--spacing-xs);
  }

  .form-checkbox {
    margin-top: 4px;
  }

  .checkbox-label {
    font-size: 0.8125rem;
    color: var(--mist);
    line-height: 1.4;
  }

  .form-preview-note { border-left: 2px solid rgba(103, 217, 255, 0.48); padding-left: 14px; color: var(--steel); font-size: 0.84rem; }

  .form-actions .btn:disabled { opacity: 0.62; cursor: not-allowed; }

  .form-status { min-height: 1.5em; color: var(--error); font-size: 0.875rem; }

  .contact-info-col {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .info-card,
  .office-card {
    padding: var(--spacing-xl);
    background-color: var(--deep-navy);
  }

  .info-title,
  .office-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--cloud-white);
    margin-bottom: var(--spacing-xs);
  }

  .info-desc {
    font-size: 0.9375rem;
    color: var(--mist);
    margin-bottom: var(--spacing-lg);
  }

  .contact-pending { min-height: 260px; display: flex; flex-direction: column; justify-content: flex-end; border-color: rgba(103, 217, 255, 0.18); background: radial-gradient(circle at 84% 18%, rgba(103, 217, 255, 0.1), transparent 36%), var(--deep-navy); }

  .contact-pending > .text-mono { margin-bottom: auto; color: rgba(201, 211, 223, 0.5); }
</style>
