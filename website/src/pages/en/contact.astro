---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FinalCTA from '../../components/home/FinalCTA.astro';
import ContactSuccessModal from '../../components/contact/ContactSuccessModal.astro';
import ContactNextSteps from '../../components/contact/ContactNextSteps.astro';
import { siteConfig } from '../../data/site';
import { useTranslations } from '../../i18n/routes';

const locale = 'en';
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  title="Consult with Kultivate"
  description="Tell us what needs attention. We will review the context before recommending any work."
>
  <div class="contact-page page-flow">
    <section class="section contact-section flow-section" aria-labelledby="contact-title">
    <div class="container">
      <header class="contact-intro">
        <h1 id="contact-title">Tell us what needs attention.</h1>
        <p>Share your priorities, current challenges, and the support you are considering. We will review the context before recommending the right next step.</p>
      </header>

      <div class="contact-grid">
        <!-- Form Column -->
        <div class="contact-form-col card">
          <form id="contact-form" action={siteConfig.formEndpoint} method="POST" class="contact-form">
            <div class="form-row">
              <div class="form-group">
                <label for="name" class="form-label">{t('contact.name')} <span class="required">*</span></label>
                <input type="text" id="name" name="name" required placeholder={t('contact.placeholder_name')} class="form-input" />
              </div>
              <div class="form-group">
                <label for="company" class="form-label">{t('contact.company')} <span class="required">*</span></label>
                <input type="text" id="company" name="company" required placeholder={t('contact.placeholder_company')} class="form-input" />
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="email" class="form-label">{t('contact.email')} <span class="required">*</span></label>
                <input type="email" id="email" name="email" required placeholder={t('contact.placeholder_email')} class="form-input" />
              </div>
              <div class="form-group">
                <label for="whatsapp" class="form-label">{t('contact.whatsapp')} <span class="required">*</span></label>
                <input type="tel" id="whatsapp" name="whatsapp" required placeholder={t('contact.placeholder_whatsapp')} class="form-input" />
              </div>
            </div>

            <div class="form-group">
              <label for="service" class="form-label">{t('contact.service_interest')} <span class="required">*</span></label>
              <select id="service" name="service" required class="form-select">
                <option value="">-- Select Service --</option>
                <option value="seo">{t('contact.service_seo')}</option>
                <option value="aeo-geo">{t('contact.service_system')}</option>
                <option value="web-services">{t('contact.service_web')}</option>
                <option value="content-management">{t('contact.service_social')}</option>
              </select>
            </div>

            <div class="form-group">
              <label for="summary" class="form-label">{t('contact.summary')} <span class="required">*</span></label>
              <textarea id="summary" name="summary" rows="4" required placeholder={t('contact.placeholder_summary')} class="form-textarea"></textarea>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label for="timeline" class="form-label">{t('contact.timeline')}</label>
                <select id="timeline" name="timeline" class="form-select">
                  <option value="">{t('contact.placeholder_timeline')}</option>
                  <option value="asap">As soon as possible</option>
                  <option value="1-2months">Within 1–2 months</option>
                  <option value="flexible">Still planning</option>
                </select>
              </div>
              <div class="form-group">
                <label for="budget" class="form-label">{t('contact.budget')}</label>
                <select id="budget" name="budget" class="form-select">
                  <option value="">{t('contact.placeholder_budget')}</option>
                  <option value="tier1">&lt; IDR 15 million</option>
                  <option value="tier2">IDR 15 million - IDR 35 million</option>
                  <option value="tier3">&gt; IDR 35 million</option>
                </select>
              </div>
            </div>

            <div class="form-group checkbox-group">
              <input type="checkbox" id="consent" name="consent" required class="form-checkbox" />
              <label for="consent" class="checkbox-label">
                {t('contact.consent')}
              </label>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn btn-primary btn-cta">
                {t('contact.submit')}
              </button>
            </div>
            <p class="form-status" data-form-status role="status" aria-live="polite"></p>
          </form>
        </div>

        <!-- Direct Contact Info Column -->
        <div class="contact-info-col">
          <div class="info-card card">
            <h2 class="info-title">Prefer a direct message?</h2>
            <p class="info-desc">
              Contact us by WhatsApp or email.
            </p>

            <div class="contact-links">
              <a href={siteConfig.whatsappLink} target="_blank" rel="noopener noreferrer" class="contact-link-item">
                <div class="icon-box">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                  </svg>
                </div>
                <div>
                  <span class="link-label text-mono">WhatsApp Business</span>
                  <span class="link-val">{siteConfig.phone}</span>
                </div>
              </a>

              <a href={`mailto:${siteConfig.email}`} class="contact-link-item">
                <div class="icon-box">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                  </svg>
                </div>
                <div>
                  <span class="link-label text-mono">Email</span>
                  <span class="link-val">{siteConfig.email}</span>
                </div>
              </a>
            </div>
          </div>

          <ContactNextSteps locale="en" />

          <div class="office-card card border-subtle">
            <h3 class="office-title text-mono">Our base</h3>
            <p class="office-address">{siteConfig.address}</p>
            <span class="office-legal text-mono">{siteConfig.companyLegalName} ({siteConfig.addressClassification})</span>
          </div>
        </div>
      </div>
    </div>
    </section>
  </div>

  <ContactSuccessModal locale={locale} />
  <FinalCTA locale={locale} />
</BaseLayout>

<style>
  .contact-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: 0;
    padding-top: clamp(132px, 14vw, 184px);
    padding-bottom: clamp(96px, 11vw, 148px);
    background: transparent;
  }

  .contact-section::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    z-index: 0;
    height: clamp(620px, 72vw, 920px);
    pointer-events: none;
    background:
      radial-gradient(ellipse 62% 48% at 14% 12%, rgba(70, 134, 183, 0.3), transparent 72%),
      radial-gradient(ellipse 50% 42% at 86% 18%, rgba(103, 217, 255, 0.14), transparent 74%),
      radial-gradient(ellipse 44% 32% at 58% 42%, rgba(23, 107, 255, 0.1), transparent 76%),
      linear-gradient(180deg, rgba(9, 28, 44, 0.88) 0%, rgba(8, 21, 34, 0.62) 38%, transparent 100%);
  }

  .contact-section > .container {
    position: relative;
    z-index: 1;
  }

  .contact-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: end;
    margin-bottom: clamp(52px, 7vw, 88px);
  }

  .contact-intro h1 {
    max-width: 15ch;
    margin: 0;
    color: var(--cloud-white);
    font-family: var(--font-sans);
    font-size: clamp(2.75rem, 1.85rem + 4.3vw, 6rem);
    font-weight: 550;
    letter-spacing: -0.04em;
    line-height: 0.96;
    overflow-wrap: normal;
    text-wrap: balance;
  }

  .contact-intro p {
    max-width: 48ch;
    margin: 0;
    color: rgba(226, 234, 243, 0.8);
    font-family: var(--font-sans);
    font-size: clamp(1rem, 0.93rem + 0.3vw, 1.18rem);
    line-height: 1.58;
    text-wrap: pretty;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: 100%;
    min-width: 0;
    gap: var(--spacing-xxl);
  }

  @media (max-width: 760px) {
    .contact-section {
      padding-top: 112px;
    }

    .contact-intro {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      margin-bottom: 44px;
    }

    .contact-intro h1 {
      max-width: 15ch;
      font-size: clamp(2.35rem, 11vw, 3.5rem);
      line-height: 0.98;
    }
  }

  @media (min-width: 992px) {
    .contact-grid {
      grid-template-columns: minmax(0, 3fr) minmax(280px, 2fr);
    }
  }

  .contact-form-col {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    padding: clamp(22px, 4vw, 48px);
    background-color: var(--deep-navy);
  }

  .contact-form {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .form-row {
    min-width: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-md);
  }

  @media (min-width: 640px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-group {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .form-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--cloud-white);
  }

  .required {
    color: var(--error);
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    padding: 12px var(--spacing-sm);
    background-color: var(--void-black);
    border: 1px solid var(--slate);
    border-radius: var(--border-radius-sm);
    color: var(--cloud-white);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
  }

  .form-textarea {
    resize: vertical;
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--electric-blue);
  }

  .checkbox-group {
    flex-direction: row;
    align-items: flex-start;
    gap: var(--spacing-xs);
    margin-top: var(--spacing-xs);
  }

  .form-checkbox {
    margin-top: 4px;
  }

  .checkbox-label {
    font-size: 0.8125rem;
    color: var(--mist);
    line-height: 1.4;
  }

  .form-actions {
    display: flex;
    justify-content: flex-end;
  }

  .form-actions .btn {
    width: auto;
    max-width: 100%;
  }

  .form-status { min-height: 1.5em; color: var(--error); font-size: 0.875rem; }

  .contact-info-col {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .info-card,
  .office-card {
    padding: var(--spacing-xl);
    background-color: var(--deep-navy);
  }

  .info-title,
  .office-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--cloud-white);
    margin-bottom: var(--spacing-xs);
  }

  .info-desc {
    font-size: 0.9375rem;
    color: var(--mist);
    margin-bottom: var(--spacing-lg);
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .contact-link-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    padding: var(--spacing-sm);
    background-color: var(--void-black);
    border-radius: var(--border-radius-sm);
    border: 1px solid var(--slate);
    transition: border-color var(--transition-micro);
  }

  .contact-link-item > div:last-child {
    min-width: 0;
  }

  .contact-link-item:hover {
    border-color: var(--cyan-glow);
  }

  .icon-box {
    color: var(--cyan-glow);
  }

  .link-label {
    display: block;
    font-size: 0.75rem;
    color: var(--steel);
    text-transform: uppercase;
  }

  .link-val {
    overflow-wrap: anywhere;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--cloud-white);
  }

  .office-address {
    font-size: 0.9375rem;
    color: var(--mist);
    margin-bottom: var(--spacing-xs);
  }

  .office-legal {
    font-size: 0.75rem;
    color: var(--steel);
  }
</style>
