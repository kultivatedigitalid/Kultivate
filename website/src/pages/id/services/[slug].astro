---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ServiceHero from '../../../components/services/ServiceHero.astro';
import ServiceProblems from '../../../components/services/ServiceProblems.astro';
import ServiceScope from '../../../components/services/ServiceScope.astro';
import ServiceProcess from '../../../components/services/ServiceProcess.astro';
import ServicePrinciples from '../../../components/services/ServicePrinciples.astro';
import ServiceLearningPreview from '../../../components/learning/ServiceLearningPreview.astro';
import ServiceFAQ from '../../../components/services/ServiceFAQ.astro';
import FinalCTA from '../../../components/home/FinalCTA.astro';
import { servicesData } from '../../../data/services';

const locale = 'id';

export async function getStaticPaths() {
  const items = servicesData['id'];
  return items.map(service => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

const { service } = Astro.props;

// Format data for subcomponents
const problemItems = service.problemsSolved.map((problem, index) => ({
  title: problem,
  description: service.problemCauses[index] ?? '',
  impact: service.impacts[index] ?? '',
  inspect: service.inspections[index] ?? ''
}));

const scopeItems = [
  {
    title: 'Pilihan cakupan',
    items: service.scope
  },
  {
    title: 'Hasil kerja yang umum',
    items: service.deliverables
  },
  {
    title: 'Cocok untuk',
    items: service.whoItIsFor
  }
];

const processSteps = service.process.map(p => {
  const [stepPart, descPart] = p.split(': ');
  const match = stepPart.match(/^([^(]+)\s*\(([^)]+)\)$/);
  const name = match ? `${match[1]} (${match[2]})` : stepPart;
  return {
    step: match ? match[2] : 'STEP',
    name: name,
    description: descPart || p
  };
});

const defaultFaqs = [
  {
    question: 'Bagaimana kami menentukan cakupan proyek ' + service.title + '?',
    answer: 'Kami mulai dari posisi, prioritas, risiko, dan kapasitas internal Anda saat ini. Cakupan hanya memuat pekerjaan yang memiliki alasan bisnis dan ownership yang jelas.'
  },
  {
    question: 'Apakah layanan ' + service.title + ' dapat digunakan sendiri?',
    answer: 'Bisa. Setiap layanan dapat berjalan sendiri atau digabungkan ketika dependensinya memang saling berkaitan. Kami merekomendasikan cakupan terkecil yang tetap berguna.'
  },
  {
    question: 'Apa yang perlu disiapkan oleh tim kami?',
    answer: 'Biasanya kami membutuhkan akses yang relevan, satu pengambil keputusan, konteks penawaran, dan waktu untuk checkpoint. Detailnya ditentukan setelah discovery, bukan diasumsikan sebelumnya.'
  },
  {
    question: 'Bagaimana komunikasi dan approval berlangsung?',
    answer: 'Kami menyepakati ritme update, pemilik keputusan, checkpoint, dan acceptance criteria sebelum eksekusi agar tidak ada pekerjaan yang bergerak tanpa konteks.'
  },
  {
    question: 'Bagaimana hasil dievaluasi?',
    answer: 'Ukuran keberhasilan ditentukan dari baseline dan tujuan proyek. Kami tidak menjanjikan ranking atau hasil komersial tertentu; kami menjelaskan perubahan, evidence yang tersedia, dan faktor di luar kendali proyek.'
  },
  {
    question: 'Apa yang terjadi setelah pekerjaan selesai?',
    answer: 'Tim Anda menerima hasil kerja beserta konteks, catatan keputusan, dan prioritas berikutnya. Dukungan lanjutan hanya direkomendasikan jika memang ada kebutuhan yang jelas.'
  }
];
---

<BaseLayout 
  locale={locale} 
  title={`${service.title} - Layanan Kultivate`} 
  description={service.description}
>
  <div class="service-detail-page page-flow">
  <ServiceHero
    title={service.title}
    serviceId={service.id}
    tagline={service.tagline}
    description={service.description}
    systemRole="LAYANAN KULTIVATE"
    locale={locale}
  />

  <ServiceProblems
    heading="Apa yang menghambat"
    problems={problemItems}
    locale={locale}
  />

  {['seo', 'web-services'].includes(service.id) && <ServiceLearningPreview locale={locale} serviceId={service.id} />}

  <ServiceScope
    heading="Bagian yang dapat kami tangani"
    scopes={scopeItems}
    locale={locale}
  />

  <ServiceProcess
    heading="Cara kami bekerja bersama Anda"
    steps={processSteps}
    locale={locale}
  />

  <ServicePrinciples locale={locale} service={service} />

  <ServiceFAQ
    heading="Pertanyaan yang sering diajukan"
    faqs={[...service.faqs, ...defaultFaqs.slice(2, 5)]}
  />

  </div>

  <FinalCTA locale={locale} />
</BaseLayout>
