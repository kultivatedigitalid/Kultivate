---
import BaseLayout from '../layouts/BaseLayout.astro';

const locale = 'en';
---

<BaseLayout locale={locale} title="404 - Page Not Found" description="This page was not found at this address." robots="noindex, follow" includeAlternates={false}>
  <div class="error-container container glow-field">
    <div class="error-content">
      <span class="error-code text-mono">404</span>
      <h1 class="error-title">Page not found</h1>
      <p class="error-desc">
        This page was not found at this address. Return home or choose another section.
      </p>
      <p class="error-desc-en text-mono">
        Kami tidak menemukan halaman pada alamat ini. Kembali ke Home atau pilih bagian lain.
      </p>

      <div class="error-actions">
        <a href="/en/" class="btn btn-primary">Back to Home</a>
        <a href="/en/services/" class="btn btn-secondary">Explore Services</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .error-container {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: clamp(132px, 16vw, 200px);
    padding-bottom: var(--spacing-xxl);
    text-align: center;
    background: radial-gradient(ellipse 70% 45% at 50% 38%, rgba(23, 107, 255, 0.2), transparent 70%), linear-gradient(180deg, #05080e 0%, #07101a 56%, #070b12 100%);
  }

  .error-content {
    max-width: 600px;
  }

  .error-code {
    font-size: clamp(4rem, 10vw, 8rem);
    font-weight: 700;
    color: var(--cyan-glow);
    line-height: 1;
    display: block;
    margin-bottom: var(--spacing-sm);
  }

  .error-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--cloud-white);
    margin-bottom: var(--spacing-md);
  }

  .error-desc {
    font-size: 1.125rem;
    color: var(--mist);
    line-height: 1.5;
    margin-bottom: var(--spacing-xs);
  }

  .error-desc-en {
    font-size: 0.9375rem;
    color: var(--steel);
    margin-bottom: var(--spacing-xl);
  }

  .error-actions {
    display: flex;
    gap: var(--spacing-md);
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
