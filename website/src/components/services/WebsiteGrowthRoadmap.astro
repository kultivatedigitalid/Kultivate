      start: 'Find your solution',
      privacy: 'Answers run in your browser and are never sent or stored.',
      calculating: 'Creating your roadmap…',
      progress: 'Question',
      back: 'Back',
      choose: 'Choose the answer closest to your situation today.',
      resultLabel: 'Recommended direction',
      problemLabel: 'Problem identified',
      priorityLabel: 'First priority',
      supportLabel: 'Supporting service',
      noSupport: 'Start with this single priority. An additional service does not need to enter the initial scope yet.',
      viewService: 'View service context',
      consultationCta: 'Continue to a free consultation',
      consultationSupport: 'Your first consultation is free. Once we understand the context and what you actually need, we will explain the recommended scope and the price of each required piece.',
      reset: 'Try another scenario',
      questions: [
        {
          title: 'Which digital business constraint feels most urgent?',
          answers: [
            ['visibility', 'The right customers do not find us', 'Visibility around valuable demand is not yet consistent.'],
            ['clarity', 'Our offer is hard to understand or compare', 'The website does not explain the offer and next step clearly enough.'],
            ['ai', 'The way customers search is changing', 'The website is not yet clear enough for evolving search behavior.'],
            ['publishing', 'Content is reactive and inconsistent', 'Content production and refreshes lack a sustainable operating system.']
          ]
        },
        {
          title: 'What is the website foundation like today?',
          answers: [
            ['fragile', 'Slow, fragile, or difficult to maintain', 'Technical foundations are limiting usability, search, or business change.'],
            ['unclear', 'It works, but the journey and conversion are unclear', 'The user journey does not turn attention into a clear action.'],
            ['stable', 'Stable and actively monitored', 'The website foundation is stable enough to focus on the next optimization.'],
            ['unknown', 'It has never been reviewed properly', 'Technical and measurement risk is not visible enough to prioritize confidently.']
          ]
        },
        {
          title: 'Where should stronger demand come from?',
          answers: [
            ['google', 'Google and organic search', 'The main opportunity sits in valuable organic search demand.'],
            ['answers', 'Emerging search experiences beyond traditional results', 'Business information needs to be easier to find, understand, and trust.'],
            ['referral', 'Referral or social works, but search is weak', 'Existing demand is not supported by a strong website and search presence.'],
            ['mixed', 'We are unsure—the channels are mixed', 'Acquisition channels lack a clear priority and relationship.']
          ]
        },
        {
          title: 'What support can the team realistically sustain?',
          answers: [
            ['managed', 'A partner to run ongoing work', 'The team needs external ownership to maintain execution rhythm.'],
            ['direction', 'We can execute with a clear roadmap', 'The team has capacity but needs clear priorities and an editorial system.'],
            ['development', 'We are ready to collaborate on technical delivery', 'The team is ready to implement technical change in a structured way.'],
            ['focused', 'Start with a small, focused scope', 'The first scope should stay focused on the intervention with the most direct impact.']
          ]
        },
        {
          title: 'Which outcome would matter most in the next 3–6 months?',
          answers: [
            ['pipeline', 'More relevant enquiries from organic search', 'The organic search opportunity needs a clearer connection to the business pipeline.'],
            ['referenced', 'Business information that is easier to find and trust', 'Expertise needs clearer structure across changing search experiences.'],
            ['conversion', 'A faster, clearer website journey that drives action', 'Experience and conversion friction need measurable website changes.'],
            ['cadence', 'A content system the team can maintain', 'The business needs a sustainable content rhythm, ownership model, and quality standard.']
          ]
        }
      ],
      services: {
        seo: {
          name: 'SEO',
          slug: 'seo',
          reason: 'SEO is the priority because the answer pattern points to a gap between valuable demand, page structure, and the ability of customers to find the offer.',
          support: 'SEO connects priority pages with the demand customers are actively searching for.'
        },

        web: {
          name: 'Web Services',
          slug: 'web-services',
          reason: 'Web Services is the priority because technical foundations or the user journey are limiting understanding, measurement, and conversion.',
          support: 'Web Services makes search recommendations practical to implement.'
        },

      }
    };

const questions = quizBlueprint.map((question, index) => ({
  ...copy.questions[index],
  id: question.id
}));
---

<section
  id="website-growth-roadmap"
  class="roadmap flow-section"
  aria-labelledby="quiz-title"
  data-service-quiz
  data-load-state="pending"
  data-locale={locale}
  data-quiz-copy={JSON.stringify({ progress: copy.progress, noSupport: copy.noSupport, services: copy.services })}
>
  <div class="container quiz-shell">
    <div class="quiz-frame">
      <div class="quiz-loader" data-quiz-loader aria-hidden="true">
        <span></span><span></span><span></span>
      </div>

      <section class="quiz-view quiz-intro" data-quiz-view="intro">
        <div class="quiz-intro__content">
          <span class="quiz-meta text-mono">{copy.meta}</span>
          <h2 id="quiz-title">{copy.initialTitle}</h2>
          <p>{copy.initialBody}</p>
          <button class="btn btn-primary" type="button" data-quiz-start>{copy.start}</button>
          <small>{copy.privacy}</small>
        </div>
      </section>

      <section class="quiz-view quiz-questions" data-quiz-view="questions" hidden>
        <header class="quiz-progress">
          <span class="text-mono" data-progress-label>{copy.progress} 1 / {questions.length}</span>
          <div class="progress-track" aria-hidden="true"><span data-progress-fill></span></div>
        </header>

        <div class="question-stage" data-question-stage>
          {questions.map((question, questionIndex) => (
            <fieldset class="question-panel" data-question={questionIndex} data-question-id={question.id} hidden={questionIndex !== 0}>
              <legend tabindex="-1">{question.title}</legend>
              <p class="question-hint">{copy.choose}</p>
              <div class="answer-grid">
                {question.answers.map(([answerId, label, problem]) => (
                  <button
                    type="button"
                    class="answer-option"
                    data-answer
                    data-answer-id={answerId}
                    data-problem={problem}
                    aria-pressed="false"
                  >
                    <span>{label}</span>
                  </button>
                ))}
              </div>
            </fieldset>
          ))}
        </div>

        <footer class="quiz-controls">
          <button type="button" class="quiz-back" data-quiz-back disabled>
            <span aria-hidden="true">←</span> {copy.back}
          </button>
        </footer>
      </section>

      <section class="quiz-view quiz-calculating" data-quiz-view="calculating" hidden aria-live="polite">
        <div class="recommendation-loader" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <p>{copy.calculating}</p>
      </section>

      <section class="quiz-view quiz-result" data-quiz-view="result" hidden aria-live="polite">
        <div class="result-primary">
          <span class="section-kicker">{copy.resultLabel}</span>
          <h2 data-result-title></h2>
          <div class="service-combination" data-service-combination aria-label={copy.resultLabel}></div>
          <a class="btn btn-primary btn-cta roadmap-consultation" data-consultation-link href={'/' + locale + '/contact/?source=roadmap'}>
            <span>{copy.consultationCta}</span>
          </a>
          <p class="consultation-support">{copy.consultationSupport}</p>
          <a class="link-hover-arrow" data-service-link href={'/' + locale + '/services/'}>
            <span>{copy.viewService}</span><span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="result-explanation">
          <div class="result-block">
            <span class="text-mono">{copy.problemLabel}</span>
            <ul data-result-problems></ul>
          </div>
          <div class="result-block">
            <span class="text-mono">{copy.priorityLabel}</span>
            <p data-priority-reason></p>
          </div>
          <div class="result-block result-support">
            <span class="text-mono">{copy.supportLabel}</span>
            <p data-support-reason></p>
          </div>
          <button type="button" class="quiz-reset" data-quiz-reset>{copy.reset}</button>
        </div>
      </section>
    </div>
  </div>
</section>

<script>
  import { recommendServices } from '../../scripts/service-recommendation.mjs';
  import { trackFunnelEvent } from '../../scripts/funnel-analytics';

  const setupServiceQuiz = () => {
    document.querySelectorAll<HTMLElement>('[data-service-quiz]').forEach((root) => {
      if (root.dataset.ready === 'true') {
        if (root.dataset.loadState === 'pending') root.dataset.loadState = 'ready';
        return;
      }
      root.dataset.ready = 'true';

      const quizCopy = JSON.parse(root.dataset.quizCopy ?? '{}');
      const views = {
        intro: root.querySelector<HTMLElement>('[data-quiz-view="intro"]'),
        questions: root.querySelector<HTMLElement>('[data-quiz-view="questions"]'),
        calculating: root.querySelector<HTMLElement>('[data-quiz-view="calculating"]'),
        result: root.querySelector<HTMLElement>('[data-quiz-view="result"]')
      };
      const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-question]'));
      const stage = root.querySelector<HTMLElement>('[data-question-stage]');
      const progressLabel = root.querySelector<HTMLElement>('[data-progress-label]');
      const progressFill = root.querySelector<HTMLElement>('[data-progress-fill]');
      const backButton = root.querySelector<HTMLButtonElement>('[data-quiz-back]');
      const answers: Record<string, string> = {};
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let currentQuestion = 0;
      let moving = false;

      const exitDuration = reducedMotion ? 0 : 220;
      const enterDuration = reducedMotion ? 0 : 340;

      const settleTarget = (target: HTMLElement) => {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => target.classList.remove('is-entering'));
        });
        window.setTimeout(() => {
          moving = false;
        }, enterDuration);
      };

      const transitionView = (target: HTMLElement | null, update?: () => void) => {
        if (!target || moving) return;
        moving = true;
        const active = root.querySelector<HTMLElement>('.quiz-view:not([hidden])');
        active?.classList.add('is-leaving');

        window.setTimeout(() => {
          if (active) {
            active.hidden = true;
            active.classList.remove('is-leaving');
          }
          update?.();
          target.hidden = false;
          target.classList.add('is-entering');
          settleTarget(target);
        }, exitDuration);
      };

      const renderQuestion = (index: number, focus = true) => {
        currentQuestion = index;
        panels.forEach((panel, panelIndex) => {
          panel.hidden = panelIndex !== index;
        });
        if (progressLabel) progressLabel.textContent = quizCopy.progress + ' ' + (index + 1) + ' / ' + panels.length;
        if (progressFill) progressFill.style.width = ((index + 1) / panels.length * 100) + '%';
        if (backButton) backButton.disabled = index === 0;
        if (focus) panels[index]?.querySelector<HTMLElement>('legend')?.focus();
      };

      const transitionQuestion = (nextIndex: number) => {
        if (!stage || moving) return;
        moving = true;
        stage.classList.add('is-leaving');
        window.setTimeout(() => {
          renderQuestion(nextIndex, false);
          stage.classList.remove('is-leaving');
          stage.classList.add('is-entering');
          panels[nextIndex]?.querySelector<HTMLElement>('legend')?.focus();
          settleTarget(stage);
        }, exitDuration);
      };

      const revealQuiz = () => {
        if (root.dataset.loadState === 'ready') return;
        const revealDelay = reducedMotion ? 0 : 420;
        window.setTimeout(() => {
          root.dataset.loadState = 'ready';
        }, revealDelay);
      };

      if (reducedMotion || !('IntersectionObserver' in window)) {
        revealQuiz();
      } else {
        const revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            revealQuiz();
            revealObserver.disconnect();
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
        revealObserver.observe(root);
      }

      const showResult = () => {
        const result = recommendServices(answers);
        const services = quizCopy.services as Record<string, { name: string; slug: string; reason: string; support: string }>;
        const primary = services[result.primary];
        const supportKeys = result.supporting;
        const selectedProblems = panels
          .map((panel) => panel.querySelector<HTMLButtonElement>('[data-answer][aria-pressed="true"]')?.dataset.problem)
          .filter((problem): problem is string => Boolean(problem))
          .slice(0, 3);

        const resultTitle = root.querySelector<HTMLElement>('[data-result-title]');
        const combination = root.querySelector<HTMLElement>('[data-service-combination]');
        const problems = root.querySelector<HTMLUListElement>('[data-result-problems]');
        const priorityReason = root.querySelector<HTMLElement>('[data-priority-reason]');
        const supportReason = root.querySelector<HTMLElement>('[data-support-reason]');
        const link = root.querySelector<HTMLAnchorElement>('[data-service-link]');
        const consultationLink = root.querySelector<HTMLAnchorElement>('[data-consultation-link]');

        if (resultTitle) resultTitle.textContent = primary.name;
        if (priorityReason) priorityReason.textContent = primary.reason;
        if (supportReason) {
          supportReason.textContent = supportKeys.length
            ? supportKeys.map((key) => services[key].support).join(' ')
            : quizCopy.noSupport;
        }
        if (link) link.href = '/' + root.dataset.locale + '/services/' + primary.slug + '/';
        if (consultationLink) {
          consultationLink.href = '/' + root.dataset.locale + '/contact/?source=roadmap&service=' + primary.slug;
          consultationLink.dataset.recommendedService = primary.slug;
        }

        if (combination) {
          combination.replaceChildren();
          [result.primary, ...supportKeys].forEach((key, index) => {
            const tag = document.createElement('span');
            tag.textContent = services[key].name;
            tag.dataset.priority = index === 0 ? 'primary' : 'support';
            combination.append(tag);
          });
        }

        if (problems) {
          problems.replaceChildren();
          selectedProblems.forEach((problem) => {
            const item = document.createElement('li');
            item.textContent = problem;
            problems.append(item);
          });
        }

        trackFunnelEvent('roadmap_complete', { locale: root.dataset.locale ?? '' });
        trackFunnelEvent('roadmap_result', { recommended_service: primary.slug });

        transitionView(views.calculating, () => {
          root.dataset.quizState = 'calculating';
          window.setTimeout(() => {
            transitionView(views.result, () => {
              root.dataset.quizState = 'result';
            });
          }, 2000);
        });
      };

      root.querySelector<HTMLButtonElement>('[data-quiz-start]')?.addEventListener('click', () => {
        trackFunnelEvent('roadmap_start', { locale: root.dataset.locale ?? '' });
        transitionView(views.questions, () => {
          root.dataset.quizState = 'questions';
          renderQuestion(0, false);
        });
      });

      panels.forEach((panel, panelIndex) => {
        panel.querySelectorAll<HTMLButtonElement>('[data-answer]').forEach((button) => {
          button.addEventListener('click', () => {
            if (moving) return;
            const questionId = panel.dataset.questionId;
            const answerId = button.dataset.answerId;
            if (!questionId || !answerId) return;

            answers[questionId] = answerId;
            panel.querySelectorAll('[data-answer]').forEach((option) => {
              option.setAttribute('aria-pressed', String(option === button));
            });

            if (panelIndex === panels.length - 1) showResult();
            else transitionQuestion(panelIndex + 1);
          });
        });
      });

      backButton?.addEventListener('click', () => {
        if (currentQuestion > 0) transitionQuestion(currentQuestion - 1);
      });

      root.querySelector<HTMLAnchorElement>('[data-consultation-link]')?.addEventListener('click', (event) => {
        const link = event.currentTarget as HTMLAnchorElement;
        trackFunnelEvent('roadmap_consultation_click', {
          recommended_service: link.dataset.recommendedService ?? ''
        });
      });

      root.querySelector<HTMLButtonElement>('[data-quiz-reset]')?.addEventListener('click', () => {
        Object.keys(answers).forEach((key) => delete answers[key]);
        root.querySelectorAll('[data-answer]').forEach((button) => button.setAttribute('aria-pressed', 'false'));
        transitionView(views.intro, () => {
          root.dataset.quizState = 'intro';
          renderQuestion(0, false);
        });
      });
    });
  };

  setupServiceQuiz();
  document.addEventListener('astro:page-load', setupServiceQuiz);
</script>

<style>
  .roadmap {
    height: 100svh;
    min-height: 640px;
    display: grid;
    place-items: center;
    margin-top: -2px;
    padding: clamp(38px, 5vh, 56px) 0 8px;
    background: transparent;
  }

  .quiz-shell {
    height: 100%;
    min-height: 0;
  }

  .quiz-frame {
    position: relative;
    height: 100%;
    min-height: 0;
    display: grid;
    overflow: hidden;
    background: transparent;
  }

  .quiz-loader {
    position: absolute;
    inset: 50% auto auto 50%;
    z-index: 4;
    display: flex;
    gap: 8px;
    transform: translate(-50%, -50%);
    transition: opacity 300ms ease, visibility 300ms ease;
  }
  .quiz-loader span { width: 7px; aspect-ratio: 1; border-radius: 50%; background: var(--signal-ice); animation: quiz-loader-pulse 760ms ease-in-out infinite alternate; }
  .quiz-loader span:nth-child(2) { animation-delay: 110ms; }
  .quiz-loader span:nth-child(3) { animation-delay: 220ms; }
  [data-service-quiz][data-load-state='pending'] .quiz-view { opacity: 0; transform: translate3d(0, 12px, 0); }
  [data-service-quiz][data-load-state='ready'] .quiz-loader { opacity: 0; visibility: hidden; }
  [data-service-quiz][data-load-state='ready'] .quiz-view { opacity: 1; transform: none; }

  @keyframes quiz-loader-pulse {
    from { opacity: 0.24; transform: translate3d(0, 4px, 0) scale(0.82); }
    to { opacity: 1; transform: translate3d(0, -4px, 0) scale(1); }
  }

  .quiz-meta { display: block; color: rgba(201, 211, 223, 0.58); font-size: 0.68rem; }
  .quiz-view { min-height: 0; transition: opacity 340ms cubic-bezier(0.16, 1, 0.3, 1), transform 420ms cubic-bezier(0.16, 1, 0.3, 1), filter 320ms ease; }
  .quiz-view[hidden] { display: none; }

  .quiz-intro {
    display: grid;
    place-items: center;
    padding: clamp(38px, 7vh, 76px) clamp(24px, 6vw, 84px);
    text-align: center;
  }

  .quiz-intro__content { width: min(100%, 860px); display: grid; justify-items: center; }
  .quiz-intro .quiz-meta { margin-bottom: 24px; }

  .quiz-intro h2 {
    max-width: 14ch;
    font-size: clamp(3rem, 5.3vw, 6.2rem);
    font-weight: 520;
    letter-spacing: -0.048em;
    line-height: 0.93;
