---
import { getProjects, projectName } from '../../data/work';
interface Props { locale: 'id' | 'en'; serviceId: string; serviceTitle: string; }
const { locale, serviceId, serviceTitle } = Astro.props;
const projects = (await getProjects(locale)).filter(project => project.data.serviceIds.includes(serviceId)).slice(0, 2);
---
<section class="service-evidence flow-section" aria-labelledby="evidence-title" data-scroll-key="service-evidence">
  <div class="container">
    <header><h2 id="evidence-title">{locale === 'id' ? `${serviceTitle} dalam karya` : `${serviceTitle} in practice`}</h2><p>{locale === 'id' ? 'Lihat konteks, keputusan, dan hasil kerja di balik pendekatannya.' : 'Explore the context, decisions and deliverables behind the approach.'}</p></header>
    <div class="evidence-projects">{projects.map(project => <a class="evidence-project" href={`/${locale}/work/${project.data.slug}/`}>
      <img src={project.data.coverImage} alt={project.data.coverAlt} width="1536" height="1024" loading="lazy" decoding="async" />
      <div><h3>{projectName(project)}</h3><p>{project.data.summary}</p><span>{locale === 'id' ? 'Lihat studi kasus' : 'View case study'} <span aria-hidden="true">↗</span></span></div>
    </a>)}</div>
  </div>
</section>
<style>
  .service-evidence { padding: clamp(64px, 8vw, 112px) 0; background: #0b1724; }
  header { max-width: 760px; margin-bottom: 40px; }
  h2 { font-size: clamp(2rem, 3.6vw, 3.7rem); letter-spacing: -.035em; line-height: 1.08; margin-bottom: 18px; }
  p { color: var(--mist); line-height: 1.65; }
  .evidence-projects { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(24px, 4vw, 56px); }
  .evidence-project { display: block; min-width: 0; }
  .evidence-project img { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 8px; }
  h3 { margin: 22px 0 12px; font-size: 1.5rem; }
  .evidence-project > div > span { display: block; margin-top: 18px; color: var(--signal-ice); font-size: .94rem; }
  a:focus-visible { outline: 2px solid var(--signal-ice); outline-offset: 6px; border-radius: 8px; }
  @media(max-width:760px) { .evidence-projects { grid-template-columns: minmax(0, 1fr); } }
</style>
