---
import HeroShell from '../shared/HeroShell.astro';
import { heroScenes, type HeroSceneName } from '../../data/hero-scenes';

interface Props {
  serviceId: string;
  title: string;
  tagline: string;
  description: string;
  systemRole: string;
  locale: 'id' | 'en';
}
const { title, description, locale, serviceId } = Astro.props;
const scenes: Record<string, HeroSceneName> = {
  seo:'seo', 'visual-strategy':'visual-strategy',
  'web-services':'web-services', 'social-media-management':'social-media-management',
};
const scene = scenes[serviceId] ?? 'seo';
const image = `/assets/hero-scenes/${heroScenes[scene].asset}`;
const imageAlt = locale === 'id'
  ? `Visual abstrak untuk layanan ${title}`
  : `Abstract visual for ${title} services`;
---

<HeroShell
  scene={scene}
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  variant="service-detail"
  focalPoint="55% 50%"
>
  <a slot="actions" href={`/${locale}/contact/?service=${serviceId}`} class="btn btn-primary btn-cta"><span>{locale === 'id' ? 'Konsultasi Gratis' : 'Free Consultation'}</span></a>
</HeroShell>
