---
import HeroShell from '../shared/HeroShell.astro';

interface Props {
  title: string;
  tagline: string;
  description: string;
  systemRole: string;
  locale: 'id' | 'en';
}
const { title, tagline, description, systemRole, locale } = Astro.props;
const image = title.includes('AEO')
  ? '/assets/banners/aeo-geo-minimal.webp'
  : title.includes('Web')
    ? '/assets/banners/web-services-minimal.webp'
    : title.includes('Content')
      ? '/assets/banners/content-minimal.webp'
      : '/assets/banners/seo-minimal.webp';
const imageAlt = locale === 'id'
  ? `Visual abstrak untuk layanan ${title}`
  : `Abstract visual for ${title} services`;
---

<HeroShell
  title={title}
  description={tagline}
  image={image}
  imageAlt={imageAlt}
  label={systemRole}
  variant="service-detail"
  focalPoint="55% 50%"
>
  <Fragment slot="meta">
    <p class="service-hero-description">{description}</p>
  </Fragment>
  <Fragment slot="actions">
    <a href={`/${locale}/contact/`} class="btn btn-primary btn-cta">{locale === 'id' ? 'Konsultasi dengan kami' : 'Consult with us'}</a>
    <a href={`/${locale}/work/`} class="btn btn-secondary">{locale === 'id' ? 'Lihat portofolio' : 'View portfolio'}</a>
  </Fragment>
</HeroShell>

<style>
  .service-hero-description {
    max-width: 54ch;
    margin-inline: auto;
    color: rgba(226, 234, 243, 0.72);
  }
</style>
