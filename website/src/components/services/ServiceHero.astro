---
import HeroShell from '../shared/HeroShell.astro';

interface Props {
  title: string;
  tagline: string;
  description: string;
  systemRole: string;
  locale: 'id' | 'en';
}
const { title, tagline, locale } = Astro.props;
const image = title.includes('AEO')
  ? '/assets/banners/aeo-geo-gradient.webp'
  : title.includes('Web')
    ? '/assets/banners/web-services-gradient.webp'
    : title.includes('Content')
      ? '/assets/banners/content-gradient.webp'
      : '/assets/banners/seo-gradient.webp';
const imageAlt = locale === 'id'
  ? `Visual abstrak untuk layanan ${title}`
  : `Abstract visual for ${title} services`;
---

<HeroShell
  title={title}
  description={tagline}
  image={image}
  imageAlt={imageAlt}
  variant="service-detail"
  focalPoint="55% 50%"
/>
