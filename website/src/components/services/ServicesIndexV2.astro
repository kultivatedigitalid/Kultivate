---
import InteriorHero from '../shared/InteriorHero.astro';

interface Props { locale: 'id' | 'en'; }
const { locale } = Astro.props;
const copy = locale === 'id'
  ? {
      hero: {
        label: 'SEO + WEB SERVICES',
        title: 'Layanan untuk prioritas Anda',
        description: 'Dibangun berdasarkan apa yang dibutuhkan bisnis Anda selanjutnya.'
      },
      explore: 'Lihat layanan',
      services: [
        { title: 'SEO', result: 'Visibility untuk pencarian bernilai', description: 'Kami memperbaiki fondasi teknis, halaman prioritas, dan authority signals untuk search tradisional, sekaligus menyusun AEO & GEO agar expertise lebih mudah dipahami oleh pengalaman pencarian berbasis AI.', image: '/assets/services/seo-focus-v3.webp', alt: 'Beberapa jalur search bergerak menuju satu titik prioritas', slug: 'seo' },
        { title: 'Web Services', result: 'Website yang siap mendukung pertumbuhan', description: 'Kami merancang, membangun, dan merawat website ketika performa, usability, migrasi, atau kekurangan implementasi menghambat halaman prioritas dan orang yang menggunakannya.', image: '/assets/services/web-foundation-v3.webp', alt: 'Lapisan website modular tersusun di atas fondasi teknis', slug: 'web-services' }
      ]
    }
  : {
      hero: {
        label: 'SEO + WEB SERVICES',
        title: 'Services for your priorities',
        description: 'Built around what your business needs next.'
      },
      explore: 'View service',
      services: [
        { title: 'SEO', result: 'Visibility for valuable searches', description: 'We improve technical foundations, priority pages, and authority signals for traditional search, while shaping AEO & GEO so your expertise is easier for AI-powered search experiences to understand.', image: '/assets/services/seo-focus-v3.webp', alt: 'Several search paths moving toward one priority destination', slug: 'seo' },
        { title: 'Web Services', result: 'A website built to support growth', description: 'We design, build, and maintain the website where performance, usability, migrations, or implementation gaps hold back priority pages and the people using them.', image: '/assets/services/web-foundation-v3.webp', alt: 'Modular website layers arranged on a technical foundation', slug: 'web-services' }
      ]
    };
---

<div class="services-page page-flow">
<InteriorHero
  title={copy.hero.title}
  description={copy.hero.description}
  label={copy.hero.label}
  image="/assets/banners/services-gradient.webp"
  imageAlt={locale === 'id' ? 'Elemen modular mengitari satu pusat biru' : 'Modular elements arranged around one blue core'}
  variant="services"
/>

<section class="services-index flow-section" aria-label={copy.hero.label} data-scroll-key="services-list">
  <div class="container service-stream">
    {copy.services.map((service, index) => (
      <article class="service-row" data-reveal>
        <figure class="service-row__visual" data-reveal><img src={service.image} alt={service.alt} width="1440" height="1080" loading="lazy" decoding="async" /></figure>
        <div class="service-row__copy" data-reveal>
          <div class="service-row__meta text-mono"><span>0{index + 1}</span></div>
          <h2>{service.title}</h2>
          <h3>{service.result}</h3>
          <p>{service.description}</p>
          <a href={'/' + locale + '/services/' + service.slug + '/'} class="link-hover-arrow"><span>{copy.explore}</span><span aria-hidden="true">&#8594;</span></a>
        </div>
      </article>
    ))}
  </div>
</section>
</div>

<style>
  .services-index { margin-top:-2px; padding:clamp(52px,7vw,96px) 0 clamp(34px,4.5vw,62px); background:radial-gradient(ellipse 54% 24% at 50% 10%,rgba(70,134,183,.11),transparent 80%),linear-gradient(180deg,#070b12 0%,#060a11 54%,#05080e 100%); }
  .service-stream { display:flex; flex-direction:column; gap:clamp(96px,12vw,172px); }
  .service-row { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:clamp(42px,7vw,108px); align-items:center; }
  .service-row:nth-child(even) .service-row__visual { order:2; }
  .service-row__visual { aspect-ratio:4 / 3; overflow:hidden; border-radius:8px; background:#07101a; }
  .service-row__visual img { width:100%; height:100%; object-fit:cover; transform:scale(1.035) translate3d(-1.2%,0,0); transition:transform 680ms var(--ease-out),filter 360ms var(--ease-out); }
  .service-row:nth-child(even) img { animation-direction:alternate-reverse; }
  .service-row__copy { min-width:0; }
  .service-row__meta { display:flex; margin-bottom:22px; color:rgba(201,211,223,.52); }
  .service-row__copy h2 { max-width:12ch; margin-bottom:22px; font-size:clamp(2.8rem,5vw,5.5rem); font-weight:540; letter-spacing:-.04em; line-height:.94; }
  .service-row__copy h3 { max-width:29ch; margin-bottom:18px; color:rgba(238,245,250,.92); font-size:clamp(1.28rem,1.4rem + .45vw,2rem); font-weight:540; letter-spacing:-.025em; line-height:1.18; text-wrap:balance; }
  .service-row__copy > p { max-width:49ch; margin-bottom:22px; color:rgba(201,211,223,.76); font-size:.96rem; line-height:1.62; }
  @media (hover:hover) and (pointer:fine) { .service-row:hover img { transform:scale(1.015) translate3d(-1.2%,0,0); filter:saturate(1.04); } }
  @media (max-width:840px) { .service-row { grid-template-columns:1fr; gap:30px; } .service-row:nth-child(even) .service-row__visual { order:initial; } .service-row__copy h3 { max-width:34ch; } }
  @media (max-width:840px) { .service-row__visual img,.service-row:nth-child(even) img { transform:none; } }
  @media (prefers-reduced-motion:reduce) { .service-row__visual img,.service-row:nth-child(even) img { transition:none; transform:none; } }
</style>
