---
import InteriorHero from '../shared/InteriorHero.astro';

interface Props { locale: 'id' | 'en'; }
const { locale } = Astro.props;
const copy = locale === 'id'
  ? {
      hero: {
        label: 'LAYANAN',
        title: 'Layanan untuk kebutuhan search bisnis Anda.',
        description: 'Sesuai prioritas Anda, kami dapat membantu melalui SEO, AEO & GEO, Web Services, Content Management, atau kombinasi yang memang dibutuhkan.'
      },
      explore: 'Lihat layanan',
      services: [
        {
          title: 'SEO',
          result: 'Bantu pelanggan yang tepat menemukan apa yang Anda tawarkan.',
          description: 'Kami memperbaiki fondasi teknis, halaman prioritas, dan authority untuk pencarian yang terhubung dengan bisnis Anda.',
          image: '/assets/services/seo-discovery-v2.webp',
          alt: 'Jalur search yang mengarah ke satu hasil',
          slug: 'seo'
        },
        {
          title: 'AEO & GEO',
          result: 'Siapkan expertise Anda untuk AI search.',
          description: 'Kami menyusun konten dan sinyal teknis agar answer engines dapat memahami dan mengambil informasi penting dari website Anda.',
          image: '/assets/services/seo-discovery-v2.webp',
          alt: 'Jalur informasi yang tersusun menjadi jawaban',
          slug: 'aeo-geo'
        },
        {
          title: 'Web Services',
          result: 'Dukung search dengan website yang lebih kuat.',
          description: 'Kami membangun, merawat, dan memperbaiki website ketika masalah teknis membatasi performa search atau usability.',
          image: '/assets/services/website-system-v2.webp',
          alt: 'Struktur website modular yang terhubung',
          slug: 'web-services'
        },
        {
          title: 'Content Management',
          result: 'Jaga konten yang berguna tetap aktual.',
          description: 'Kami merencanakan, membuat, menerbitkan, dan memperbarui konten berdasarkan pertanyaan pelanggan serta prioritas bisnis Anda.',
          image: '/assets/services/social-distribution-v2.webp',
          alt: 'Sistem content dalam alur yang teratur',
          slug: 'content-management'
        }
      ]
    }
  : {
      hero: {
        label: 'SERVICES',
        title: 'Services for the search work your business needs.',
        description: 'Depending on your priorities, we can support you with SEO, AEO & GEO, Web Services, Content Management, or a combination of them.'
      },
      explore: 'View service',
      services: [
        {
          title: 'SEO',
          result: 'Help the right customers find what you offer.',
          description: 'We improve technical foundations, priority pages, and authority around searches connected to your business.',
          image: '/assets/services/seo-discovery-v2.webp',
          alt: 'A search path resolving into one clear result',
          slug: 'seo'
        },
        {
          title: 'AEO & GEO',
          result: 'Prepare your expertise for AI search.',
          description: 'We organize content and technical signals so answer engines can understand and retrieve useful information from your website.',
          image: '/assets/services/seo-discovery-v2.webp',
          alt: 'Information paths structured into a clear answer',
          slug: 'aeo-geo'
        },
        {
          title: 'Web Services',
          result: 'Support search with a stronger website.',
          description: 'We build, maintain, and improve websites where technical issues limit search performance or usability.',
          image: '/assets/services/website-system-v2.webp',
          alt: 'A connected modular website structure',
          slug: 'web-services'
        },
        {
          title: 'Content Management',
          result: 'Keep useful content current.',
          description: 'We plan, create, publish, and refresh content around your customer questions and business priorities.',
          image: '/assets/services/social-distribution-v2.webp',
          alt: 'A content system moving in a clear rhythm',
          slug: 'content-management'
        }
      ]
    };
---

<InteriorHero
  title={copy.hero.title}
  description={copy.hero.description}
  label={copy.hero.label}
  image="/assets/banners/services-minimal.webp"
  imageAlt={locale === 'id' ? 'Empat jalur cahaya yang mewakili pilihan layanan Kultivate' : 'Four paths of light representing Kultivate service options'}
/>

<section class="services-index" aria-label={copy.hero.label}>
  <div class="container service-stream">
    {copy.services.map((service, index) => (
      <article class="service-row">
        <figure class="service-row__visual">
          <img src={service.image} alt={service.alt} width="1536" height="1152" loading="lazy" decoding="async" />
        </figure>
        <div class="service-row__copy">
          <div class="service-row__meta text-mono"><span>0{index + 1}</span><span>{service.title}</span></div>
          <h2>{service.result}</h2>
          <p>{service.description}</p>
          <a href={`/${locale}/services/${service.slug}/`} class="link-hover-arrow">
            <span>{copy.explore}</span><span aria-hidden="true">&#8594;</span>
          </a>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .services-index {
    margin-top: -1px;
    padding: clamp(44px, 6vw, 88px) 0 clamp(76px, 10vw, 148px);
    background:
      radial-gradient(ellipse 54% 24% at 50% 10%, rgba(23, 107, 255, 0.065), transparent 80%),
      linear-gradient(180deg, #070b12 0%, #070b12 11%, #060a11 42%, #05080e 70%, #070b12 100%);
  }
  .service-stream { display: flex; flex-direction: column; gap: clamp(104px, 14vw, 196px); }
  .service-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(42px, 7vw, 108px); align-items: center; }
  .service-row:nth-child(even) .service-row__visual { order: 2; }
  .service-row__visual { width: 100%; aspect-ratio: 4 / 3; overflow: hidden; border-radius: 8px; background: #07101a; }
  .service-row__visual img { width: 100%; height: 100%; object-fit: cover; }
  .service-row:nth-child(even) img { animation-direction: alternate-reverse; }
  .service-row__meta { display: flex; justify-content: space-between; gap: 18px; margin-bottom: 30px; color: rgba(201, 211, 223, 0.56); }
  .service-row__copy h2 { max-width: 12ch; margin-bottom: 22px; font-size: clamp(2.35rem, 4.2vw, 4.7rem); font-weight: 520; letter-spacing: -0.04em; line-height: 0.98; }
  .service-row__copy > p { max-width: 42ch; color: rgba(201, 211, 223, 0.78); font-size: 1.02rem; }
  @media (max-width: 840px) {
    .service-row { grid-template-columns: 1fr; gap: 30px; }
    .service-row__visual { height: auto; aspect-ratio: 4 / 3; }
    .service-row:nth-child(even) .service-row__visual { order: initial; }
    .service-row__copy h2 { font-size: clamp(2.35rem, 10vw, 3.6rem); }
  }
  @media (prefers-reduced-motion: reduce) { .service-row__visual img { animation: none; transform: none; } }
</style>
