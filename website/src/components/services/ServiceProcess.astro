---
interface ProcessStep { step: string; name: string; description: string; }
interface Props { heading: string; steps: ProcessStep[]; locale: 'id' | 'en'; }

const { heading, steps, locale } = Astro.props;
---

<section
  class="service-process flow-section"
  aria-labelledby="process-title"
  data-scroll-key="service-process"
  data-service-process
>
  <div class="container">
    <header class="process-heading" data-reveal>
      <h2 id="process-title">{heading}</h2>
      <p>{locale === 'id' ? 'Empat langkah yang kami jalankan bersama Anda, dari konteks sampai langkah berikutnya.' : 'Four steps we move through with you, from context to the next useful move.'}</p>
    </header>

    <ol class="process-grid">
      {steps.map((item, index) => (
        <li data-process-step={index} data-reveal style={`--reveal-delay: ${index * 65}ms`}>
          <span class="step-num text-mono">0{index + 1}</span>
          <h3>{item.name}</h3>
          <p>{item.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  const setupServiceProcesses = () => {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll<HTMLElement>('[data-service-process]').forEach((root) => {
      if (root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const steps = Array.from(root.querySelectorAll<HTMLElement>('[data-process-step]'));
      if (!steps.length) return;

      const activate = (activeIndex: number) => {
        root.style.setProperty('--process-progress', `${((activeIndex + 1) / steps.length) * 100}%`);
        steps.forEach((step, index) => {
          if (index === activeIndex) step.setAttribute('aria-current', 'step');
          else step.removeAttribute('aria-current');
          step.toggleAttribute('data-complete', index < activeIndex);
        });
      };

      const play = () => {
        if (root.dataset.played === 'true') return;
        root.dataset.played = 'true';

        if (reducedMotion) {
          root.dataset.complete = 'true';
          steps.forEach((step) => step.setAttribute('data-complete', ''));
          root.style.setProperty('--process-progress', '100%');
          return;
        }

        steps.forEach((_, index) => {
          window.setTimeout(() => {
            activate(index);
            if (index === steps.length - 1) root.dataset.complete = 'true';
          }, index * 320);
        });
      };

      if (!('IntersectionObserver' in window)) {
        play();
        return;
      }

      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        play();
        observer.disconnect();
      }, { rootMargin: '0px 0px -16%', threshold: 0.2 });

      observer.observe(root);
    });
  };

  setupServiceProcesses();
  document.addEventListener('astro:page-load', setupServiceProcesses);
</script>

<style>
  .service-process {
    position: relative;
    padding-block: clamp(92px, 11vw, 148px);
    background: linear-gradient(180deg, rgba(7, 11, 18, 0.36), rgba(5, 8, 14, 0.52));
  }

  .process-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(280px, 0.52fr);
    gap: clamp(34px, 7vw, 100px);
    align-items: end;
    margin-bottom: clamp(58px, 8vw, 98px);
  }

  .process-heading h2 {
    max-width: 13ch;
    font-size: clamp(2.7rem, 5vw, 5.5rem);
    font-weight: 520;
    letter-spacing: -0.04em;
    line-height: 0.96;
  }

  .process-heading p { max-width: 38ch; color: var(--steel); }

  .process-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding-top: 1px;
    list-style: none;
  }

  .process-grid::before,
  .process-grid::after {
    content: '';
    position: absolute;
    inset: 0 auto auto 0;
    height: 1px;
  }

  .process-grid::before { width: 100%; background: rgba(89, 106, 130, 0.36); }
  .process-grid::after { width: var(--process-progress, 0%); background: var(--signal-ice); transition: width 700ms cubic-bezier(0.16, 1, 0.3, 1); }

  .process-grid li {
    min-width: 0;
    padding: 28px clamp(18px, 2.4vw, 34px) 0 0;
    opacity: 0.62;
    transform: translate3d(0, 14px, 0);
    transition: opacity 520ms var(--ease-out), transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .process-grid li + li { padding-left: clamp(18px, 2.4vw, 34px); }
  .process-grid li[aria-current='step'], .process-grid li[data-complete] { opacity: 1; transform: none; }
  .process-grid li[aria-current='step'] .step-num { color: var(--signal-ice); }

  .step-num { display: block; margin-bottom: 46px; color: rgba(201, 211, 223, 0.46); transition: color 420ms var(--ease-out); }
  .process-grid h3 { margin-bottom: 14px; font-size: clamp(1.25rem, 1.8vw, 1.75rem); font-weight: 550; line-height: 1.12; }
  .process-grid li > p { max-width: 36ch; color: var(--steel); font-size: 0.91rem; line-height: 1.62; }

  @media (hover: hover) and (pointer: fine) {
    .process-grid li:hover, .process-grid li:focus-within { opacity: 1; transform: translate3d(0, -5px, 0); }
  }

  @media (max-width: 860px) {
    .process-heading { grid-template-columns: 1fr; }
    .process-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 58px 0; }
  }

  @media (max-width: 620px) {
    .process-grid { grid-template-columns: 1fr; gap: 0; padding-top: 0; }
    .process-grid::before, .process-grid::after { display: none; }
    .process-grid li, .process-grid li + li { padding: 34px 0; border-top: 1px solid rgba(89, 106, 130, 0.34); }
    .step-num { margin-bottom: 24px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .process-grid::after, .process-grid li, .step-num { transition: none; }
    .process-grid li { opacity: 1; transform: none; }
  }
</style>