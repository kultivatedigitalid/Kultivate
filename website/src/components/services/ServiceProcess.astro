---
interface ProcessStep { step: string; name: string; description: string; }
interface Props { heading: string; steps: ProcessStep[]; locale: 'id' | 'en'; }

const { heading, steps, locale } = Astro.props;
---

<section
  class="service-process flow-section"
  aria-labelledby="process-title"
  data-scroll-key="service-process"
  data-service-process
  data-active-step="0"
>
  <div class="container">
    <header class="process-heading" data-reveal>
      <span class="section-kicker">{locale === 'id' ? 'Proses' : 'Process'}</span>
      <h2 id="process-title">{heading}</h2>
    </header>

    <ol class="process-grid">
      {steps.map((item, index) => (
        <li data-process-step={index} data-reveal style={`--reveal-delay: ${index * 70}ms`}>
          <div class="step-meta">
            <span class="step-num text-mono">0{index + 1}</span>
            <span class="step-label text-mono">{item.step}</span>
          </div>
          <h3>{item.name}</h3>
          <p>{item.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  const setupServiceProcesses = () => {
    document.querySelectorAll<HTMLElement>('[data-service-process]').forEach((root) => {
      if (root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const steps = Array.from(root.querySelectorAll<HTMLElement>('[data-process-step]'));
      if (!steps.length) return;

      const activate = (step: HTMLElement) => {
        const index = Number(step.dataset.processStep ?? 0);
        root.dataset.activeStep = String(index);
        steps.forEach((item, itemIndex) => {
          if (itemIndex === index) item.setAttribute('aria-current', 'step');
          else item.removeAttribute('aria-current');
          item.toggleAttribute('data-complete', itemIndex < index);
        });
      };

      if (!('IntersectionObserver' in window)) {
        activate(steps[0]);
        return;
      }

      const observer = new IntersectionObserver((entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible?.target instanceof HTMLElement) activate(visible.target);
      }, { rootMargin: '-22% 0px -48%', threshold: [0.2, 0.5, 0.75] });

      steps.forEach((step) => observer.observe(step));
      activate(steps[0]);
    });
  };

  setupServiceProcesses();
  document.addEventListener('astro:page-load', setupServiceProcesses);
</script>

<style>
  .service-process {
    position: relative;
    padding-block: clamp(82px, 10vw, 138px);
    background: linear-gradient(180deg, rgba(7, 11, 18, 0.36), rgba(5, 8, 14, 0.52));
  }

  .process-heading {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: 36px;
    align-items: end;
    margin-bottom: clamp(54px, 7vw, 92px);
  }

  .process-heading h2 {
    max-width: 12ch;
    font-size: clamp(2.7rem, 5vw, 5.5rem);
    font-weight: 520;
    letter-spacing: -0.04em;
    line-height: 0.96;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    list-style: none;
  }

  .process-grid li {
    position: relative;
    min-width: 0;
    padding: 26px clamp(18px, 2.4vw, 34px) 0 0;
    border-top: 1px solid rgba(89, 106, 130, 0.36);
    opacity: 0.5;
    transition:
      opacity 300ms var(--ease-out),
      transform 420ms var(--ease-out),
      border-color 300ms var(--ease-out);
  }

  .process-grid li + li { padding-left: clamp(18px, 2.4vw, 34px); }

  .process-grid li::before {
    content: '';
    position: absolute;
    inset: -1px auto auto 0;
    width: 0;
    height: 1px;
    background: var(--signal-ice);
    transition: width 460ms var(--ease-out);
  }

  .process-grid li[aria-current='step'],
  .process-grid li[data-complete] {
    opacity: 1;
    border-color: rgba(103, 217, 255, 0.2);
  }

  .process-grid li[aria-current='step'] { transform: translate3d(0, -6px, 0); }
  .process-grid li[aria-current='step']::before,
  .process-grid li[data-complete]::before { width: 100%; }

  .step-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 42px;
  }

  .step-num { color: rgba(201, 211, 223, 0.46); }
  .step-label { max-width: 14ch; color: rgba(103, 217, 255, 0.58); text-align: right; }

  .process-grid h3 {
    margin-bottom: 14px;
    font-size: clamp(1.15rem, 1.7vw, 1.65rem);
    font-weight: 550;
  }

  .process-grid p {
    color: var(--steel);
    font-size: 0.88rem;
    line-height: 1.58;
  }

  @media (max-width: 860px) {
    .process-grid { grid-template-columns: repeat(2, 1fr); gap: 58px 0; }
  }

  @media (max-width: 620px) {
    .process-heading,
    .process-grid { grid-template-columns: 1fr; }

    .process-grid { gap: 44px; }
    .process-grid li + li { padding-left: 0; }
    .step-meta { margin-bottom: 26px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .process-grid li,
    .process-grid li::before { transition: none; }

    .process-grid li[aria-current='step'] { transform: none; }
  }
</style>
