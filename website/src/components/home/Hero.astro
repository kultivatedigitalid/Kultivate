---
interface Props { locale: 'id' | 'en'; }
const { locale } = Astro.props;
const content = locale === 'id'
  ? {
      title: 'Solusi Anda untuk Pertumbuhan Digital',
      description: 'Dibangun untuk membantu bisnis Anda ditemukan',
      primary: 'Konsultasi dengan kami',
      secondary: 'Lihat portofolio'
    }
  : {
      title: 'Your Solution for Digital Growth',
      description: 'Built to help your business get found',
      primary: 'Consult with us',
      secondary: 'View portfolio'
    };
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-gradient" aria-hidden="true"></div>
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="hero-container container">
    <div class="hero-content">
      <h1 id="hero-title">{content.title}</h1>
      <p>{content.description}</p>
      <div class="hero-actions">
        <a href={`/${locale}/contact/`} class="btn btn-primary btn-cta"><span>{content.primary}</span></a>
        <a href={`/${locale}/work/`} class="btn btn-secondary"><span>{content.secondary}</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: max(700px, 100svh);
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
    background: #070b12;
  }

  .hero-gradient,
  .hero-scrim { position: absolute; inset: 0; }

  .hero-gradient {
    z-index: 0;
    inset: -2%;
    background: url('/assets/hero-horizon.webp') center center / cover no-repeat;
    transform: scale(1.015);
    will-change: transform;
    animation: hero-art-drift 24s cubic-bezier(0.45, 0, 0.2, 1) infinite alternate;
  }

  .hero-scrim {
    z-index: 1;
    background:
      linear-gradient(90deg, rgba(7, 11, 18, 0.22), transparent 35%, rgba(7, 11, 18, 0.08)),
      linear-gradient(180deg, transparent 0%, transparent 58%, rgba(7, 11, 18, 0.14) 76%, #070b12 100%);
  }

  .hero-container { position: relative; z-index: 2; padding-top: 132px; padding-bottom: 92px; }
  .hero-content { width: min(980px, 100%); margin-inline: auto; text-align: center; animation: hero-enter 700ms var(--ease-out) both; }
  .hero h1 {
    max-width: 15ch;
    margin: 0 auto 26px;
    font-size: clamp(3rem, 1.9rem + 4.35vw, 5.25rem);
    font-weight: 560;
    letter-spacing: -0.04em;
    line-height: 0.96;
    text-wrap: balance;
  }

  .hero-content > p {
    max-width: 68ch;
    margin: 0 auto 34px;
    color: rgba(226, 234, 243, 0.86);
    font-size: clamp(1rem, 0.92rem + 0.32vw, 1.18rem);
    line-height: 1.56;
    text-wrap: pretty;
  }

  .hero-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }

  @keyframes hero-enter {
    from { opacity: 0; transform: translate3d(0, 16px, 0); }
    to { opacity: 1; transform: translate3d(0, 0, 0); }
  }

  @keyframes hero-art-drift {
    from { transform: translate3d(-0.4%, 0.5%, 0) scale(1.015); }
    to { transform: translate3d(0.8%, -0.5%, 0) scale(1.045); }
  }

  @media (max-width: 760px) {
    .hero { min-height: max(700px, 100svh); }
    .hero-gradient { inset: -4%; background-position: 61% center; }
    .hero-container { padding-top: 122px; padding-bottom: 72px; }
    .hero h1 { max-width: 12ch; font-size: clamp(2.55rem, 10.5vw, 3.5rem); }
    .hero-content > p { max-width: 34ch; }
    .hero-actions { width: min(100%, 290px); margin-inline: auto; flex-direction: column; }
    .hero-actions .btn { width: 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-content,
    .hero-gradient { animation: none; }
    .hero-gradient { transform: scale(1.02); }
  }
</style>
