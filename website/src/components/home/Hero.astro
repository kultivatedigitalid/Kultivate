---
import HeroShell from '../shared/HeroShell.astro';
import HeroLight from './HeroLight.astro';

interface Props { locale: 'id' | 'en'; }
const { locale } = Astro.props;
const content = locale === 'id'
  ? {
      title: 'Solusi untuk Pertumbuhan Digital',
      description: 'Membantu bisnis Anda ditemukan, dipahami, dan dipilih',
      primary: 'Konsultasi Gratis',
      secondary: 'Lihat portofolio'
    }
  : {
      title: 'Your Solution for Digital Growth',
      description: 'Help your business get found, understood, and chosen',
      primary: 'Free Consultation',
      secondary: 'View portfolio'
    };
---

<HeroShell
  title={content.title}
  description={content.description}
  image="/assets/hero-horizon.webp"
  imageAlt=""
  variant="home"
  focalPoint="58% 50%"
  titleId="home-hero-title"
>
  <HeroLight slot="visual-effect" />
  <Fragment slot="actions">
    <a href={`/${locale}/contact/`} class="btn btn-primary btn-cta"><span>{content.primary}</span></a>
    <a href={`/${locale}/work/`} class="btn btn-secondary"><span>{content.secondary}</span></a>
  </Fragment>
</HeroShell>


<style is:global>
  .hero-shell--home .hero-shell__actions .btn-secondary {
    background:rgba(3,9,17,.72);
    border-color:rgba(207,232,249,.28);
    color:#eef5fa;
  }
  .hero-shell--home .hero-shell__actions .btn-secondary:is(:hover,:focus-visible) {
    background:rgba(12,31,47,.92);
    border-color:rgba(207,232,249,.56);
  }
  .hero-shell--home .hero-visual { transform: none; transition: none; }
  .hero-shell--home .hero-visual img[data-ambient='true'] {
    animation: none !important;
    transform: none !important;
  }
</style>
