---
interface Props { locale: 'id' | 'en'; }

const { locale } = Astro.props;
const copy = locale === 'id'
  ? {
      label: 'BENTUK KOLABORASI',
      title: 'Dibangun untuk prioritas bisnis yang berbeda',
      note: 'Pendekatan kami menyesuaikan posisi setiap bisnis, kapasitas yang tersedia, dan ritme pekerjaan',
      rail: 'Pertimbangan yang membentuk cara kolaborasi',
      signals: [
        ['01', 'Posisi saat ini'],
        ['02', 'Prioritas bisnis'],
        ['03', 'Kapasitas tersedia'],
        ['04', 'Ritme pekerjaan']
      ]
    }
  : {
      label: 'WAYS OF WORKING',
      title: 'Built around different business priorities',
      note: 'Our approach adapts to where each business stands, the capacity available, and the pace of the work',
      rail: 'Considerations that shape the way we work together',
      signals: [
        ['01', 'Current position'],
        ['02', 'Business priorities'],
        ['03', 'Available capacity'],
        ['04', 'Pace of work']
      ]
    };
---

<section
  class="collaboration-band flow-section"
  aria-labelledby="collaboration-title"
  data-scroll-key="home-collaboration"
>
  <div class="container collaboration-intro" data-reveal>
    <span class="text-mono">{copy.label}</span>
    <h2 id="collaboration-title">{copy.title}</h2>
    <p>{copy.note}</p>
  </div>

  <div class="container">
    <ol class="signal-rail" aria-label={copy.rail}>
      {copy.signals.map(([index, label], signalIndex) => (
        <li data-reveal style={`--reveal-delay: ${signalIndex * 65}ms`}>
          <span class="signal-index text-mono">{index}</span>
          <span class="signal-mark" aria-hidden="true">
            <i></i><i></i><i></i>
          </span>
          <strong>{label}</strong>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .collaboration-band {
    position: relative;
    overflow: hidden;
    padding-block: clamp(72px, 8vw, 112px);
    background:
      radial-gradient(ellipse 48% 90% at 12% 50%, rgba(70, 134, 183, 0.18), transparent 72%),
      linear-gradient(180deg, rgba(7, 16, 26, 0.46), rgba(11, 29, 43, 0.5) 55%, rgba(7, 16, 26, 0.38));
  }

  .collaboration-intro {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(280px, 1.2fr) minmax(260px, 0.72fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: start;
  }

  .collaboration-intro > span { color: rgba(201, 211, 223, 0.5); }

  .collaboration-intro h2 {
    max-width: 14ch;
    font-size: clamp(2.05rem, 3.7vw, 4.2rem);
    font-weight: 540;
    letter-spacing: -0.04em;
  }

  .collaboration-intro p {
    max-width: 42ch;
    padding-top: 8px;
    color: rgba(201, 211, 223, 0.72);
    font-size: 0.9rem;
  }

  .signal-rail {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(48px, 7vw, 86px);
    overflow: hidden;
    border-radius: var(--border-radius-lg);
    background: rgba(201, 211, 223, 0.12);
    list-style: none;
  }

  .signal-rail li {
    min-width: 0;
    min-height: 190px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(22px, 2.5vw, 32px);
    background: linear-gradient(145deg, rgba(11, 19, 34, 0.9), rgba(7, 11, 18, 0.92));
  }

  .signal-index { color: rgba(201, 211, 223, 0.48); }

  .signal-mark {
    width: 68px;
    height: 32px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: end;
    gap: 6px;
    margin-block: 24px;
  }

  .signal-mark i {
    display: block;
    height: 34%;
    border-radius: 2px;
    background: rgba(103, 217, 255, 0.38);
    transition: height 300ms var(--ease-out), background-color 300ms var(--ease-out);
  }

  .signal-mark i:nth-child(2) { height: 68%; }
  .signal-mark i:nth-child(3) { height: 100%; }

  .signal-rail strong {
    max-width: 14ch;
    font-size: clamp(1.05rem, 1.35vw, 1.3rem);
    font-weight: 540;
    line-height: 1.15;
  }

  @media (hover: hover) and (pointer: fine) {
    .signal-rail li:hover .signal-mark i,
    .signal-rail li:focus-within .signal-mark i {
      height: 100%;
      background: rgba(207, 247, 255, 0.78);
    }
  }

  @media (max-width: 880px) {
    .collaboration-intro { grid-template-columns: 1fr 1.4fr; }
    .collaboration-intro p { grid-column: 2; }
    .signal-rail { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 620px) {
    .collaboration-intro { grid-template-columns: 1fr; }
    .collaboration-intro p { grid-column: auto; }

    .signal-rail {
      width: calc(100% + 20px);
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(220px, 72vw);
      overflow-x: auto;
      scroll-snap-type: inline mandatory;
      padding-right: 20px;
      background: transparent;
    }

    .signal-rail li {
      min-height: 180px;
      scroll-snap-align: start;
      border: 1px solid rgba(201, 211, 223, 0.1);
      border-radius: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .signal-mark i { transition: none; }
  }
</style>
