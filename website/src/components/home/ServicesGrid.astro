---
import { servicesData } from '../../data/services';

interface Props { locale: 'id' | 'en'; }
const { locale } = Astro.props;
const services = servicesData[locale] || [];

const presentation = locale === 'id'
  ? {
      seo: {
        title: 'SEO',
        role: 'Search visibility',
        description: 'Kami membantu halaman prioritas Anda ditemukan untuk pencarian yang terhubung dengan produk, layanan, dan pelanggan Anda.',
        image: '/assets/services/seo-focus-v3.webp'
      },
      'aeo-geo': {
        title: 'AEO & GEO',
        role: 'AI discovery',
        description: 'Kami menyiapkan konten dan sinyal teknis Anda agar mudah dipahami dan diambil oleh AI search.',
        image: '/assets/services/aeo-geo-answer-v3.webp'
      },
      'web-services': {
        title: 'Web Services',
        role: 'Technical foundation',
        description: 'Kami membangun dan merawat website yang mendukung performa search, usability, dan pengelolaan konten sehari-hari.',
        image: '/assets/services/web-foundation-v3.webp'
      },
      'content-management': {
        title: 'Content Management',
        role: 'Relevance',
        description: 'Kami merencanakan, membuat, menerbitkan, dan memperbarui konten berdasarkan pertanyaan pelanggan Anda.',
        image: '/assets/services/content-rhythm-v3.webp'
      }
    }
  : {
      seo: {
        title: 'SEO',
        role: 'Search visibility',
        description: 'We help your priority pages appear for searches connected to your products, services, and customers.',
        image: '/assets/services/seo-focus-v3.webp'
      },
      'aeo-geo': {
        title: 'AEO & GEO',
        role: 'AI discovery',
        description: 'We prepare your content and technical signals for the way AI search understands and retrieves information.',
        image: '/assets/services/aeo-geo-answer-v3.webp'
      },
      'web-services': {
        title: 'Web Services',
        role: 'Technical foundation',
        description: 'We build and maintain websites that support search performance, usability, and day-to-day content work.',
        image: '/assets/services/web-foundation-v3.webp'
      },
      'content-management': {
        title: 'Content Management',
        role: 'Relevance',
        description: 'We plan, create, publish, and refresh content around the questions your customers are asking.',
        image: '/assets/services/content-rhythm-v3.webp'
      }
    };
---

<section id="services" class="services-section section-padding" aria-labelledby="services-title">
  <div class="container">
    <header class="services-header">
      <span class="section-kicker">{locale === 'id' ? 'Layanan' : 'Services'}</span>
      <h2 id="services-title">{locale === 'id' ? 'Dukungan untuk kebutuhan bisnis Anda' : 'Supports for your business needs'}</h2>
      <p>
        {locale === 'id'
          ? 'Sesuai prioritas Anda, kami dapat membantu melalui SEO, AEO & GEO, Web Services, Content Management, atau kombinasi yang memang dibutuhkan.'
          : 'Depending on your priorities, we can support you with SEO, AEO & GEO, Web Services, Content Management, or a combination of them.'}
      </p>
    </header>

    <div class="services-grid">
      {services.map((service) => {
        const item = presentation[service.id as keyof typeof presentation];
        return (
          <a class="service-panel" href={`/${locale}/services/${service.slug}/`} aria-label={service.title}>
            <div class="service-media" aria-hidden="true">
              <img src={item.image} alt="" width="1200" height="768" loading="lazy" decoding="async" />
            </div>
            <div class="service-scrim" aria-hidden="true"></div>
            <div class="service-content">
              <span class="service-role text-mono">{item.role}</span>
              <div><h3>{item.title}</h3><p>{item.description}</p></div>
              <span class="service-action"><span>{locale === 'id' ? 'Pelajari' : 'Explore'}</span><span aria-hidden="true">&#8594;</span></span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .services-section {
    position: relative;
    margin-top: -1px;
    overflow: hidden;
    background:
      radial-gradient(ellipse 62% 72% at 14% 30%, rgba(139, 193, 237, 0.16), transparent 74%),
      radial-gradient(ellipse 56% 72% at 88% 68%, rgba(70, 134, 183, 0.28), transparent 76%),
      linear-gradient(180deg, #07101a 0%, #0b1d2b 48%, #07101a 100%);
  }
  .services-section::before { content: ''; position: absolute; inset: 18% 36% auto 4%; height: 34%; border-radius: 50%; background: rgba(139,193,237,.07); filter: blur(82px); pointer-events: none; }
  .services-header { position: relative; z-index: 1; max-width: 820px; margin-bottom: clamp(36px, 5vw, 56px); }
  .services-header .section-kicker { color: rgba(201, 211, 223, 0.58); }
  .services-header h2 { margin-bottom: 16px; color: var(--cloud-white); }
  .services-header p { max-width: 62ch; color: rgba(201, 211, 223, 0.76); font-size: 0.96rem; }
  .services-grid { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; overflow: hidden; border-radius: var(--border-radius-lg); background: rgba(39, 50, 68, 0.52); }
  .service-panel { position: relative; min-width: 0; min-height: clamp(320px, 34vw, 430px); overflow: hidden; background: linear-gradient(155deg, rgba(11, 19, 34, 0.96), rgba(7, 11, 18, 0.98)); isolation: isolate; transition: transform 220ms var(--ease-out), box-shadow 220ms var(--ease-out); }
  .service-media, .service-media img, .service-scrim { position: absolute; inset: 0; width: 100%; height: 100%; }
  .service-media { z-index: -2; clip-path: inset(0 100% 0 0); transition: clip-path 480ms var(--ease-out); }
  .service-media img { object-fit: cover; opacity: 0.82; transform: scale(1.035); transition: transform 480ms var(--ease-out); }
  .service-scrim { z-index: -1; background: linear-gradient(0deg, rgba(7, 11, 18, 0.98) 0%, rgba(7, 11, 18, 0.68) 52%, rgba(7, 11, 18, 0.2) 100%), linear-gradient(90deg, rgba(7, 11, 18, 0.62), transparent); }
  .service-content { min-height: inherit; display: flex; flex-direction: column; justify-content: space-between; padding: clamp(22px, 2.6vw, 34px); transition: transform 220ms var(--ease-out); }
  .service-role { color: rgba(201, 211, 223, 0.72); }
  .service-content h3 { margin-bottom: 14px; color: var(--cloud-white); font-family: var(--font-display); font-size: clamp(1.65rem, 2.2vw, 2.8rem); font-weight: 400; letter-spacing: -0.035em; line-height: 1; }
  .service-content p { max-width: 30ch; color: rgba(201, 211, 223, 0.84); font-size: 0.86rem; line-height: 1.55; }
  .service-action { display: inline-flex; align-items: center; gap: 8px; color: var(--mist); font-size: 0.82rem; font-weight: 550; }
  .service-action [aria-hidden] { transition: transform 180ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .service-panel:hover { transform: translateY(-3px); box-shadow: 0 18px 40px rgba(0, 0, 0, 0.2); }
    .service-panel:hover .service-media { clip-path: inset(0); }
    .service-panel:hover .service-media img { transform: scale(1); }
    .service-panel:hover .service-content { transform: translateY(-2px); }
    .service-panel:hover .service-action [aria-hidden] { transform: translate3d(2px, -2px, 0); }
  }
  .service-panel:active { transform: scale(0.995); }
  .service-panel:focus-visible .service-media { clip-path: inset(0); transition-duration: 0ms; }
  .service-panel:focus-visible .service-media img { transform: scale(1); transition-duration: 0ms; }
  @media (hover: none), (pointer: coarse) { .service-media { clip-path: inset(0); } .service-media img { opacity: 0.5; transform: none; } }
  @media (max-width: 1120px) { .services-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 650px) {
    .services-grid { grid-template-columns: 1fr; }
    .service-panel, .service-content { min-height: 220px; }
    .service-content { padding: 24px; }
    .service-content h3 { font-size: clamp(2rem, 9vw, 3rem); }
    .service-content p { max-width: 38ch; }
  }
  @media (prefers-reduced-motion: reduce) { .service-panel, .service-media, .service-media img, .service-content, .service-action [aria-hidden] { transition: color 180ms ease, opacity 180ms ease; } }
</style>
