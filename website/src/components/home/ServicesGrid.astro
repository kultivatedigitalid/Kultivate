---
import { servicesData } from '../../data/services';
import ServiceObject from '../shared/ServiceObject.astro';
interface Props { locale: 'id' | 'en'; }
const { locale } = Astro.props;
const benefits: Record<'id' | 'en', Record<string, string>> = {
  id: {
    seo: 'Kami membantu Anda ditemukan oleh orang yang tepat dan mengubah visibilitas menjadi peluang.',
    'web-services': 'Kami membangun rumah digital yang bekerja untuk Anda dan bisnis Anda.',
    'social-media-management': 'Kami membantu brand Anda membangun kepercayaan dan tetap terhubung dengan audiens Anda.',
    'visual-strategy': 'Kami membantu orang melihat dan memahami nilai di balik bisnis Anda.',
  },
  en: {
    seo: 'We help you get found by the right people and turn visibility into opportunities.',
    'web-services': 'We build a digital home that works for you and your business.',
    'social-media-management': 'We help your brand earn trust and stay connected with your audience.',
    'visual-strategy': 'We help people see and understand the value behind your business.',
  },
};
const services = servicesData[locale].map(service => ({ ...service, summary: benefits[locale][service.id] }));
const copy = locale === 'id' ? {
  title: 'Layanan Kami',
  body: 'Kami membawa keahlian mendalam dalam pertumbuhan digital agar orang dapat menemukan bisnis Anda, memahami nilainya, dan mengambil langkah berikutnya.',
  foundation: 'Search + website', explore: 'Lihat layanan', label: 'Layanan',
} : {
  title: 'Our services',
  body: 'We bring deep expertise in digital growth to help people discover your business, understand its value, and take the next step.',
  foundation: 'Search + website', explore: 'Explore service', label: 'Services',
};
---
<section id="services" class="services-section flow-section light-field" aria-labelledby="services-title" data-scroll-key="home-services">
  <div class="container services-layout">
    <header class="services-header" data-reveal>
      <div><span class="section-kicker">{copy.label}</span><h2 id="services-title">{copy.title}</h2></div>
      <p>{copy.body}</p>
    </header>
    <div class="services-composition">
      <div class="services-foundation" aria-label={copy.foundation}>
        {services.slice(0,2).map(service => (
          <a class="service-panel service-panel--core" data-service-card href={`/${locale}/services/${service.slug}/`} data-reveal>
            <span class="service-visual" aria-hidden="true"><ServiceObject variant={service.id} /></span>
            <div class="service-copy"><h3>{service.title}</h3><p>{service.summary}</p></div>
            <span class="service-action"><span>{copy.explore}</span><span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
      <div class="services-expression">
        {services.slice(2).map(service => (
          <a class="service-panel service-panel--support" data-service-card href={`/${locale}/services/${service.slug}/`} data-reveal>
            <span class="service-visual" aria-hidden="true"><ServiceObject variant={service.id} compact /></span>
            <div class="service-copy"><h3>{service.title}</h3><p>{service.summary}</p></div>
            <span class="service-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
<style>
  .services-section { padding-block:clamp(86px,11.5svh,128px); }
  .services-layout { display:grid; gap:clamp(24px,3.6svh,40px); }
  .services-header { display:grid; grid-template-columns:1.3fr .7fr; align-items:end; gap:clamp(40px,8vw,120px); }
  .services-header .section-kicker { display:block; margin-bottom:14px; color:#244963; }
  .services-header h2 { max-width:none; font-size:clamp(2.7rem,4.9vw,5rem); line-height:1; letter-spacing:-.04em; font-weight:530; color:#0b2033; }
  .services-header p { max-width:40ch; padding-bottom:3px; font-size:clamp(.88rem,1.05vw,1rem); line-height:1.6; color:#28485f; }
  .services-composition { display:grid; grid-template-columns:1.55fr 1fr; gap:18px; }
  .services-foundation { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
  .services-expression { display:grid; grid-template-rows:repeat(2,minmax(0,1fr)); gap:18px; }
  .service-panel { position:relative; isolation:isolate; overflow:hidden; min-width:0; background:#0c2031; color:#f0f7fb; }
  .service-panel--core { min-height:360px; border-radius:12px; display:flex; flex-direction:column; align-items:flex-start; padding:clamp(22px,2.2vw,30px); }
  .service-visual { display:block; pointer-events:none; width:100%; height:clamp(164px,20svh,190px); }
  .service-panel--core .service-visual { order:1; margin-block:0 12px; transform:translateY(12px); }
  .service-copy { order:2; margin-top:auto; }
  .service-copy h3 { color:#f1f7fb; font-size:clamp(1.7rem,2.4vw,2.4rem); line-height:1.08; letter-spacing:-.035em; font-weight:500; margin-bottom:12px; }
  .service-copy p { color:#c1d5e4; font-size:clamp(.8rem,.94vw,.94rem); line-height:1.6; }
  .service-action { order:3; display:flex; justify-content:space-between; align-items:center; width:100%; gap:12px; margin-top:24px; color:#d4ecfc; font-size:.7rem; }
  .service-action > :last-child,.service-arrow { font-size:1.3rem; transition:transform 180ms ease-out; }
  .service-panel--support { border-radius:12px; display:grid; grid-template-columns:minmax(0,1fr) 154px; align-items:center; gap:8px; min-height:184px; padding:22px; }
  .service-panel--support .service-visual { grid-column:2; grid-row:1; width:154px; height:140px; }
  .service-panel--support .service-copy { grid-column:1; grid-row:1; min-width:0; margin:0; }
  .service-panel--support h3 { max-width:15ch; font-size:clamp(1.25rem,1.55vw,1.75rem); margin-bottom:9px; }
  .service-panel--support p { font-size:clamp(.8rem,.92vw,.92rem); }
  .service-arrow { position:absolute; right:18px; bottom:14px; color:#9ab8cc; }
  .service-panel:focus-visible { outline:2px solid #d4ecfc; outline-offset:-5px; }
  @media (hover:hover) and (pointer:fine) {
    .service-panel:hover :is(.service-arrow,.service-action > :last-child) { transform:translate(2px,-2px); }
  }
  @media (min-width:1000px) and (min-height:620px) { .services-section { min-height:calc(100svh - 72px); display:grid; align-content:center; } }
  @media (min-width:1000px) and (max-height:800px) {
    .services-section { padding-block:clamp(42px,8svh,64px); }
    .services-header h2 { font-size:clamp(2.7rem,4.4vw,3.8rem); }
    .services-header .section-kicker { margin-bottom:10px; }
    .services-layout { gap:24px; }
    .service-panel--core { padding:24px; }
    .service-action { margin-top:18px; }
  }
  @media (max-width:999px) {
    .services-composition { grid-template-columns:1fr; }
    .services-expression { grid-template-columns:1fr 1fr; grid-template-rows:auto; }
    .services-header { gap:30px; }
    .service-panel--core { min-height:340px; }
    .service-panel--support { min-height:200px; grid-template-columns:minmax(0,1fr) 112px; gap:8px; padding:20px; }
    .service-panel--support .service-visual { width:112px; height:128px; }
  }
  @media (max-width:999px) {
    /* A fixed header wash keeps dark copy legible above the long mobile field. */
    .services-section::before {
      content:''; position:absolute; z-index:-1; pointer-events:none;
      inset:-80px 0 auto; height:580px;
      background:linear-gradient(180deg,transparent,#adc2cf 140px,#adc2cf 420px,transparent);
    }
  }
  @media (max-width:600px) {
    .services-section { padding-block:100px; }
    .services-section::after { mask-image:linear-gradient(180deg,transparent,#000 90px,#000 calc(100% - 90px),transparent); background:linear-gradient(180deg,transparent,#bed8e8 90px,#e4f1f7 260px,#a3c6df calc(100% - 150px),transparent); }
    .services-header { grid-template-columns:1fr; gap:18px; }
    .services-header h2 { font-size:clamp(2.7rem,12vw,4rem); }
    .services-foundation { grid-template-columns:1fr; }
    .services-expression { grid-template-columns:1fr; gap:12px; }
    .services-composition { gap:12px; }
    .service-panel--core { min-height:320px; padding:26px; }
    .service-panel--core .service-visual { height:220px; margin-block:0 18px; }
    .service-panel--support { min-height:180px; grid-template-columns:minmax(0,1fr) clamp(88px,27vw,130px); gap:8px; padding:22px 18px; }
    .service-panel--support .service-visual { width:100%; height:128px; }
    .service-copy h3 { font-size:2rem; }
    .service-panel--support h3 { font-size:clamp(1.05rem,4.3vw,1.5rem); margin-bottom:9px; }
    .service-copy p { font-size:.9rem; }
    .service-panel--support p { font-size:clamp(.8rem,3.3vw,.9rem); line-height:1.5; }
  }
  @media (prefers-reduced-motion:reduce) { .service-arrow,.service-action > :last-child { transition:none; transform:none; } }
</style>
