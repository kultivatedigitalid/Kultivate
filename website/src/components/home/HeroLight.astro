---
// Cache the soft rim once, then composite a small 2D light pass per frame.
// The artwork itself remains the original image beneath this temporary overlay.
---
<home-hero-light aria-hidden="true" data-state="idle">
  <canvas></canvas>
</home-hero-light>

<style>
  home-hero-light {
    position:absolute; inset:0; display:none; overflow:hidden; pointer-events:none;
    mask-image:linear-gradient(180deg,#000 0%,#000 68%,rgba(0,0,0,.92) 78%,rgba(0,0,0,.48) 91%,transparent 100%);
  }
  :global(.js) home-hero-light { display:block; }
  home-hero-light:is([data-state='idle'],[data-state='waiting']) { background:#03070d; animation:reveal-fallback 200ms linear 7500ms forwards; }
  home-hero-light[data-state='complete'] { display:none; }
  home-hero-light canvas { position:absolute; max-width:none; }
  @keyframes reveal-fallback { to { opacity:0; } }
  @media (prefers-reduced-motion:reduce) { :global(.js) home-hero-light { display:none; animation:none; } }
</style>

<script>
  import { HERO_MOTION_SPEED } from '../../scripts/hero-motion';
  const WIDTH=1672, HEIGHT=941;
  const rimPath='M1950 244 C1680 243 1430 288 1250 374 C1100 444 950 562 800 664 C650 766 500 865 305 931 C50 1030 -300 1160 -700 1240';
  const curves=[
    [1950,244,1680,243,1430,288,1250,374],
    [1250,374,1100,444,950,562,800,664],
    [800,664,650,766,500,865,305,931],
    [305,931,50,1030,-300,1160,-700,1240],
  ];
  // Arc-length samples keep the original curved light route and a steady pace.
  const route:{x:number;y:number;distance:number}[]=[];
  curves.forEach(curve=>{
    for(let step=route.length?1:0;step<=80;step++){
      const t=step/80,u=1-t;
      const x=u*u*u*curve[0]+3*u*u*t*curve[2]+3*u*t*t*curve[4]+t*t*t*curve[6];
      const y=u*u*u*curve[1]+3*u*u*t*curve[3]+3*u*t*t*curve[5]+t*t*t*curve[7];
      const previous=route.at(-1);
      route.push({x,y,distance:previous?previous.distance+Math.hypot(x-previous.x,y-previous.y):0});
    }
  });
  const atDistance=(distance:number)=>{
    const index=Math.max(1,route.findIndex(point=>point.distance>=distance));
    const end=distance>=route[route.length-1].distance?route.length-1:index;
    const a=route[end-1],b=route[end];
    const t=Math.max(0,Math.min(1,(distance-a.distance)/(b.distance-a.distance)));
    return {x:a.x+(b.x-a.x)*t,y:a.y+(b.y-a.y)*t,angle:Math.atan2(b.y-a.y,b.x-a.x)};
  };
  const distanceAtX=(x:number)=>route.find(point=>point.x<=x)?.distance??route[route.length-1].distance;
  const ease=(t:number)=>t*t*(3-2*t);

  class HomeHeroLight extends HTMLElement {
    private dispose?:()=>void;
    connectedCallback(){
      if(this.dispose)return;
      const artwork=this.parentElement?.querySelector<HTMLImageElement>('img');
      const canvas=this.querySelector('canvas');
      const context=canvas?.getContext('2d');
      if(!artwork||!canvas||!context){this.dataset.state='complete';return;}
      this.dataset.state='waiting';
      const glow=document.createElement('canvas'),light=document.createElement('canvas');
      const glowContext=glow.getContext('2d'),lightContext=light.getContext('2d');
      if(!glowContext||!lightContext){this.dataset.state='complete';return;}
      const reduced=matchMedia('(prefers-reduced-motion: reduce)');
      const duration=6000/HERO_MOTION_SPEED;
      let visible=false,ready=false,done=false,disposed=false;
      let frame=0,clickFrame=0,elapsed=0,previousTime=0,ratio=1;
      let revealStart=0,revealEnd=route[route.length-1].distance,lightStart=0,lightEnd=revealEnd;
      const cacheGlow=()=>{
        // Gaussian work happens only when creating/resizing this cached texture.
        // There are no SVG masks, huge dashed strokes or live blur filters.
        glowContext.setTransform(ratio,0,0,ratio,0,0);
        const path=new Path2D(rimPath);
        const stroke=(color:string,width:number,blur:number,y=0)=>{
          glowContext.save();glowContext.translate(0,y);
          glowContext.strokeStyle=color;glowContext.lineWidth=width;
          glowContext.filter=blur?`blur(${blur*ratio}px)`:'none';
          glowContext.stroke(path);glowContext.restore();
        };
        stroke('rgba(22,126,220,.29)',145,30);
        stroke('rgba(56,146,213,.3)',40,12,30);
        stroke('rgba(102,202,255,.55)',13,12);
        const edge=glowContext.createLinearGradient(460,0,1250,0);
        edge.addColorStop(0,'rgba(161,222,255,0)');edge.addColorStop(.45,'rgba(187,236,255,.25)');edge.addColorStop(1,'rgba(221,246,255,.61)');
        glowContext.strokeStyle=edge;glowContext.lineWidth=2.2;glowContext.stroke(path);
      };
      const draw=(progress:number)=>{
        const eased=ease(progress);
        const revealPoint=atDistance(revealStart+(revealEnd-revealStart)*eased);
        context.setTransform(1,0,0,1,0,0);context.clearRect(0,0,canvas.width,canvas.height);
        context.save();context.scale(ratio,ratio);
        context.translate(revealPoint.x,revealPoint.y);context.rotate(revealPoint.angle);
        const curtain=context.createLinearGradient(-170,0,170,0);
        curtain.addColorStop(0,'rgba(3,7,13,0)');curtain.addColorStop(.5,'rgba(3,7,13,.5)');curtain.addColorStop(1,'#03070d');
        context.fillStyle=curtain;context.fillRect(-5000,-5000,10000,10000);context.restore();
        const point=atDistance(lightStart+(lightEnd-lightStart)*eased);
        lightContext.setTransform(1,0,0,1,0,0);lightContext.clearRect(0,0,light.width,light.height);
        lightContext.drawImage(glow,0,0);
        lightContext.save();lightContext.globalCompositeOperation='destination-in';
        lightContext.scale(ratio,ratio);lightContext.translate(point.x,point.y);lightContext.rotate(point.angle);lightContext.scale(430,240);
        const envelope=lightContext.createRadialGradient(0,0,0,0,0,1);
        envelope.addColorStop(0,'white');envelope.addColorStop(.32,'rgba(255,255,255,.86)');envelope.addColorStop(.7,'rgba(255,255,255,.28)');envelope.addColorStop(1,'rgba(255,255,255,0)');
        lightContext.fillStyle=envelope;lightContext.fillRect(-2,-2,4,4);lightContext.restore();
        const strength=progress<.16?progress/.16*.85:progress<.62?.85+(progress-.16)/.46*.05:(1-progress)/.38*.9;
        context.globalAlpha=Math.max(0,strength);context.drawImage(light,0,0);context.globalAlpha=1;
      };
      const fit=()=>{
        if(done||disposed)return;
        const {width,height}=this.getBoundingClientRect();
        const scale=Math.max(width/WIDTH,height/HEIGHT);
        if(!width||!height||!scale)return;
        const left=(width-WIDTH*scale)*.58;
        Object.assign(canvas.style,{width:`${WIDTH*scale}px`,height:`${HEIGHT*scale}px`,left:`${left}px`,top:`${(height-HEIGHT*scale)*.5}px`});
        // Soft lighting does not need a full DPR-2 viewport-sized render target.
        const resolution=Math.round(Math.min(1280,WIDTH*scale));
        if(canvas.width!==resolution){
          ratio=resolution/WIDTH;
          for(const surface of [canvas,glow,light]){surface.width=resolution;surface.height=Math.round(HEIGHT*ratio);}
          cacheGlow();
        }
        const cropLeft=-left/scale,cropRight=(width-left)/scale;
        revealStart=distanceAtX(cropRight+460);revealEnd=distanceAtX(cropLeft-650);
        lightStart=distanceAtX(cropRight+160);lightEnd=distanceAtX(cropLeft-320);
        draw(Math.min(1,elapsed/duration));
      };
      const finish=()=>{
        done=true;cancelAnimationFrame(frame);frame=0;this.dataset.state='complete';
        // Release intermediate pixel buffers once the original artwork is shown.
        glow.width=light.width=1;glow.height=light.height=1;
      };
      const tick=(now:number)=>{
        frame=0;if(disposed||done)return;
        if(previousTime)elapsed+=now-previousTime;
        previousTime=now;
        if(elapsed>=duration){finish();return;}
        draw(elapsed/duration);frame=requestAnimationFrame(tick);
      };
      const update=()=>{
        if(disposed||done)return;
        if(reduced.matches){finish();return;}
        const active=ready&&visible&&!document.hidden&&!document.querySelector('.atmosphere-toggle[aria-pressed="true"]');
        if(!active){cancelAnimationFrame(frame);frame=0;previousTime=0;if(ready)this.dataset.state='paused';return;}
        if(!frame){previousTime=0;frame=requestAnimationFrame(tick);}
        this.dataset.state='running';
      };
      const loaded=async()=>{
        try{await artwork.decode();}catch{finish();return;}
        if(disposed||done)return;
        if(reduced.matches){finish();return;}
        ready=true;fit();update();
      };
      const failed=()=>finish();
      const clicked=(event:MouseEvent)=>{
        if(event.target instanceof Element&&event.target.closest('.atmosphere-toggle')){cancelAnimationFrame(clickFrame);clickFrame=requestAnimationFrame(update);}
      };
      const resize=new ResizeObserver(fit);resize.observe(this);
      const intersection=new IntersectionObserver(([entry])=>{visible=entry.isIntersecting;update();});intersection.observe(this);
      artwork.addEventListener('load',loaded,{once:true});artwork.addEventListener('error',failed,{once:true});
      document.addEventListener('visibilitychange',update);document.addEventListener('click',clicked);reduced.addEventListener('change',update);
      if(artwork.complete){if(artwork.naturalWidth)void loaded();else finish();}
      this.dispose=()=>{
        disposed=true;cancelAnimationFrame(frame);cancelAnimationFrame(clickFrame);
        resize.disconnect();intersection.disconnect();glow.width=light.width=1;
        artwork.removeEventListener('load',loaded);artwork.removeEventListener('error',failed);
        document.removeEventListener('visibilitychange',update);document.removeEventListener('click',clicked);reduced.removeEventListener('change',update);
      };
    }
    disconnectedCallback(){this.dispose?.();this.dispose=undefined;}
  }
  if(!customElements.get('home-hero-light'))customElements.define('home-hero-light',HomeHeroLight);
</script>
