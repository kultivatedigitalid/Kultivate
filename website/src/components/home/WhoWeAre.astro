---
interface Props { locale: 'id' | 'en'; }
const { locale } = Astro.props;

const copy = locale === 'id'
  ? {
      heading: 'Kami hadir untuk kebutuhan Anda',
      profile: 'Kultivate bekerja dekat dengan owner dan tim internal untuk memahami konteks sebelum menentukan arah. Kami menyatukan website, SEO, content, dan measurement ke dalam keputusan yang jelas—agar pertumbuhan digital memiliki alasan, pemilik, dan langkah berikutnya.',
      collageLabel: 'Kolase cara kerja tim Kultivate',
      alts: [
        'Tim meninjau strategi website bersama',
        'Workshop customer journey dan prioritas bisnis',
        'Technical specialist mengaudit fondasi website',
        'Presentasi arah kerja bersama tim',
        'Percakapan discovery bersama pemilik bisnis',
        'Tim melakukan quality review sebelum launch'
      ]
    }
  : {
      heading: 'We are here for your needs',
      profile: 'Kultivate works closely with owners and in-house teams to understand the context before choosing a direction. We connect websites, SEO, content, and measurement through clear decisions—so digital growth has a reason, an owner, and a next step.',
      collageLabel: 'A collage of how the Kultivate team works',
      alts: [
        'A team reviewing website strategy together',
        'A workshop mapping customer journeys and business priorities',
        'A technical specialist auditing a website foundation',
        'A team presentation about the direction of the work',
        'A discovery conversation with a business owner',
        'A team running a pre-launch quality review'
      ]
    };

const images = ['01', '03', '05', '08', '09', '12'];
---

<section id="who-we-are" class="who-we-are flow-section" aria-labelledby="who-we-are-title">
  <div class="container">
    <header class="who-we-are__intro" data-reveal>
      <h2 id="who-we-are-title">{copy.heading}</h2>
    </header>

    <div class="who-we-are__mosaic" role="group" aria-label={copy.collageLabel}>
      {images.map((number, index) => (
        <figure data-reveal="image" style={`--reveal-delay: ${Math.min(index, 3) * 55}ms`}>
          <img
            src={'/assets/about/collage/collage-' + number + '.webp'}
            alt={copy.alts[index]}
            width="1280"
            height="853"
            loading="lazy"
            decoding="async"
          />
        </figure>
      ))}
    </div>

    <p class="who-we-are__profile" data-reveal>{copy.profile}</p>
  </div>
</section>

<style>
  .who-we-are {
    padding-block: clamp(64px, 7vw, 96px);
    background: transparent;
  }

  .who-we-are__intro {
    display: grid;
    place-items: center;
    text-align: center;
  }

  .who-we-are__intro h2 {
    max-width: 17ch;
    margin: 0;
    font-size: clamp(2.35rem, 1.82rem + 2.2vw, 4.6rem);
    font-weight: 520;
    letter-spacing: -0.035em;
    line-height: 0.98;
  }

  .who-we-are__mosaic {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: repeat(2, clamp(88px, 9vw, 128px));
    gap: 4px;
    width: 100%;
    margin-top: clamp(38px, 5vw, 64px);
    overflow: hidden;
  }

  .who-we-are__mosaic figure {
    min-width: 0;
    overflow: hidden;
    border-radius: 2px;
    background: #09131e;
  }

  .who-we-are__mosaic figure:nth-child(1) { grid-column: span 3; }
  .who-we-are__mosaic figure:nth-child(2) { grid-column: span 5; }
  .who-we-are__mosaic figure:nth-child(3) { grid-column: span 4; }
  .who-we-are__mosaic figure:nth-child(4) { grid-column: span 4; }
  .who-we-are__mosaic figure:nth-child(5) { grid-column: span 3; }
  .who-we-are__mosaic figure:nth-child(6) { grid-column: span 5; }

  .who-we-are__mosaic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.78) contrast(1.04);
  }

  .who-we-are__profile {
    max-width: 62ch;
    margin: clamp(36px, 4.5vw, 58px) auto 0;
    color: rgba(224, 232, 241, 0.88);
    font-size: clamp(1.04rem, 0.98rem + 0.22vw, 1.2rem);
    line-height: 1.72;
    text-align: center;
  }

  @media (max-width: 600px) {
    .who-we-are {
      padding-block: 56px;
    }

    .who-we-are__intro h2 {
      font-size: clamp(2rem, 9vw, 2.75rem);
    }

    .who-we-are__mosaic {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-template-rows: repeat(2, 78px);
      gap: 3px;
      margin-top: 32px;
    }

    .who-we-are__mosaic figure:nth-child(n) {
      grid-column: span 2;
    }

    .who-we-are__profile {
      margin-top: 30px;
      font-size: 0.98rem;
      line-height: 1.64;
    }
  }
</style>
