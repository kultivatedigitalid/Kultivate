---
import { useTranslations } from '../../i18n/routes';

interface Props {
  locale: 'id' | 'en';
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="start" class="final-cta section-padding flow-section" aria-labelledby="final-cta-title" data-scroll-key="home-cta">
  <div class="container">
    <div class="cta-content" data-reveal>
      <div>
        <h2 id="final-cta-title">{locale === 'id' ? 'Mulai dari prioritas Anda' : 'Start with your priorities'}</h2>
        <p>
          {locale === 'id'
            ? 'Ceritakan bagian yang membutuhkan perhatian. Kami akan memahami konteksnya sebelum merekomendasikan pekerjaan.'
            : 'Tell us what needs attention. We will review the context before recommending any work.'}
        </p>
      </div>
      <a href={'/' + locale + '/contact/'} class="btn btn-primary btn-cta">
        <span>{t('nav.start_project')}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .final-cta {
    position: relative;
    margin-top: -1px;
    min-height: 460px;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(ellipse 48% 54% at 50% 50%, rgba(81, 155, 204, 0.09), transparent 72%),
      linear-gradient(
        180deg,
        rgba(7, 11, 18, 0) 0%,
        rgba(7, 11, 18, 0.26) 24%,
        rgba(7, 11, 18, 0.76) 68%,
        #070b12 100%
      );
  }

  .cta-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
    text-align: center;
  }

  .cta-content > div {
    max-width: 680px;
  }

  .cta-content h2 {
    max-width: 13ch;
    margin: 0 auto 18px;
    font-family: var(--font-display);
    font-weight: 400;
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.34);
  }

  .cta-content p {
    max-width: 48ch;
    margin-inline: auto;
    color: rgba(201, 211, 223, 0.86);
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.4);
  }

  .cta-content .btn {
    flex: 0 0 auto;
  }

  @media (max-width: 760px) {
    .final-cta {
      min-height: 460px;
    }

    .cta-content {
      align-items: center;
      gap: 28px;
    }

    .cta-content > div {
      width: 100%;
    }

    .cta-content p {
      max-width: 36ch;
    }

  }

</style>
