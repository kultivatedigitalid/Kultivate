---
import { useTranslations } from '../../i18n/routes';

interface Props {
  locale: 'id' | 'en';
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section id="start" class="final-cta section-padding flow-section" aria-labelledby="final-cta-title" data-scroll-key="home-cta">
  <div class="cta-visual" aria-hidden="true">
    <span class="cta-aura"></span>
    <span class="cta-arc" data-ambient></span>
    <span class="cta-horizon"></span>
  </div>

  <div class="container">
    <div class="cta-content" data-reveal>
      <div>
        <h2 id="final-cta-title">{locale === 'id' ? 'Mulai dari prioritas Anda' : 'Start with your priorities'}</h2>
        <p>
          {locale === 'id'
            ? 'Ceritakan bagian yang membutuhkan perhatian. Kami akan memahami konteksnya sebelum merekomendasikan pekerjaan.'
            : 'Tell us what needs attention. We will review the context before recommending any work.'}
        </p>
      </div>
      <a href={'/' + locale + '/contact/'} class="btn btn-primary btn-cta">
        <span>{t('nav.start_project')}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .final-cta {
    position: relative;
    margin-top: -2px;
    min-height: 460px;
    display: flex;
    align-items: center;
    overflow: visible;
    isolation: isolate;
    background:
      radial-gradient(ellipse 62% 92% at 76% 24%, rgba(73, 111, 255, 0.24), transparent 68%),
      radial-gradient(ellipse 52% 64% at 42% 76%, rgba(103, 217, 255, 0.13), transparent 72%),
      linear-gradient(180deg, transparent 0%, rgba(11, 19, 34, 0.82) 20%, rgba(7, 11, 18, 0.84) 100%);
  }

  .final-cta::before {
    content: '';
    position: absolute;
    inset: clamp(-260px, -21vw, -170px) 0 auto;
    z-index: 0;
    height: clamp(240px, 29vw, 390px);
    pointer-events: none;
    background: linear-gradient(180deg, transparent 0%, rgba(7, 11, 18, 0.16) 26%, rgba(7, 11, 18, 0.68) 64%, #070b12 100%);
  }

  .cta-visual {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .cta-aura {
    position: absolute;
    width: min(76vw, 980px);
    aspect-ratio: 1.9 / 1;
    inset: -24% auto auto 50%;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(83, 125, 255, 0.2), rgba(23, 107, 255, 0.06) 44%, transparent 72%);
    filter: blur(24px);
    opacity: 0.74;
  }

  .cta-arc {
    position: absolute;
    width: min(92vw, 1200px);
    aspect-ratio: 2.05 / 1;
    inset: -58% auto auto 50%;
    translate: -50% 0;
    border-radius: 50%;
    border-bottom: 2px solid rgba(207, 247, 255, 0.88);
    background: radial-gradient(ellipse at 50% 100%, rgba(10, 22, 42, 0.78), rgba(7, 11, 18, 0.96) 62%);
    box-shadow:
      0 12px 30px rgba(103, 217, 255, 0.34),
      0 44px 120px rgba(23, 107, 255, 0.28);
    opacity: 0.96;
  }

  .cta-horizon {
    position: absolute;
    width: 86%;
    height: 2px;
    inset: 60% auto auto 7%;
    transform: rotate(-4deg);
    transform-origin: right center;
    background: linear-gradient(90deg, transparent, rgba(103, 217, 255, 0.48), rgba(207, 247, 255, 0.72), transparent);
    box-shadow:
      0 0 24px rgba(103, 217, 255, 0.22),
      0 0 70px rgba(23, 107, 255, 0.16);
    opacity: 0.82;
  }

  .cta-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
    text-align: center;
  }

  .cta-content > div {
    max-width: 680px;
  }

  .cta-content h2 {
    max-width: 13ch;
    margin: 0 auto 18px;
    font-family: var(--font-display);
    font-weight: 400;
  }

  .cta-content p {
    max-width: 48ch;
    margin-inline: auto;
    color: rgba(201, 211, 223, 0.86);
  }

  .cta-content .btn {
    flex: 0 0 auto;
  }

  @media (max-width: 760px) {
    .final-cta {
      min-height: 540px;
    }

    .cta-content {
      align-items: center;
      gap: 28px;
    }

    .cta-content > div {
      width: 100%;
    }

    .cta-content p {
      max-width: 36ch;
    }

    .cta-aura {
      width: 150vw;
      inset: -4% auto auto 50%;
      opacity: 0.56;
    }

    .cta-arc {
      width: 190vw;
      inset: -7% auto auto 50%;
      opacity: 0.72;
    }

    .cta-horizon {
      width: 132%;
      inset: 56% auto auto -16%;
      opacity: 0.48;
    }
  }

</style>