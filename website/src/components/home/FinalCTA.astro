---
import { useTranslations } from '../../i18n/routes';
import type { FunnelEventName } from '../../scripts/funnel-analytics';

interface Props {
  locale: 'id' | 'en';
  analyticsEvent?: FunnelEventName;
  analyticsContext?: string;
  surface?: 'default' | 'founder-profile' | 'learn';
}

const { locale, analyticsEvent, analyticsContext = '', surface = 'default' } = Astro.props;
const t = useTranslations(locale);
---

<section
  id="start"
  class:list={['final-cta', 'section-padding', 'flow-section', { 'final-cta--founder-profile': surface === 'founder-profile', 'final-cta--learn': surface === 'learn' }]}
  aria-labelledby="final-cta-title"
  data-scroll-key="home-cta"
>
  <div class="container">
    <div class="cta-content" data-reveal>
      <div>
        <h2 id="final-cta-title">{locale === 'id' ? 'Mulai dari prioritas Anda' : 'Start with your priorities'}</h2>
        <p>
          {locale === 'id'
            ? 'Konsultasi pertama gratis. Kami akan memahami konteks dan kebutuhan Anda lebih dulu, lalu menjelaskan scope dan harga setelah bagian yang benar-benar diperlukan sudah jelas.'
            : 'Your first consultation is free. We will understand the context and what you need first, then explain the scope and pricing once the required pieces are clear.'}
        </p>
      </div>
      <a
        href={'/' + locale + '/contact/'}
        class="btn btn-primary btn-cta"
        data-final-cta-event={analyticsEvent}
        data-final-cta-context={analyticsContext || undefined}
      >
        <span>{t('nav.start_project')}</span>
      </a>
    </div>
  </div>
</section>

<script>
  import { trackFunnelEvent, type FunnelEventName } from '../../scripts/funnel-analytics';

  const setupFinalCtaTracking = () => {
    document.querySelectorAll<HTMLElement>('[data-final-cta-event]').forEach((link) => {
      if (link.dataset.finalTrackingReady === 'true') return;
      link.dataset.finalTrackingReady = 'true';
      link.addEventListener('click', () => {
        const eventName = link.dataset.finalCtaEvent as FunnelEventName | undefined;
        if (!eventName) return;
        trackFunnelEvent(eventName, link.dataset.finalCtaContext
          ? { context: link.dataset.finalCtaContext }
          : {});
      });
    });
  };

  setupFinalCtaTracking();
  document.addEventListener('astro:page-load', setupFinalCtaTracking);
</script>

<style>
  .final-cta {
    position: relative;
    margin-top: -1px;
    min-height: 460px;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(ellipse 48% 54% at 50% 50%, rgba(81, 155, 204, 0.09), transparent 72%),
      linear-gradient(
        180deg,
        rgba(7, 11, 18, 0) 0%,
        rgba(7, 11, 18, 0.26) 24%,
        rgba(7, 11, 18, 0.76) 68%,
        #070b12 100%
      );
  }

  .final-cta--learn {
    margin-top:-1px;
    min-height:560px;
    padding-top:clamp(130px,17vh,190px);
    background:radial-gradient(ellipse 64% 60% at 50% 62%,rgba(81,155,204,.06),transparent 85%),
      linear-gradient(180deg,transparent 0%,rgba(7,11,18,.06) 22%,rgba(7,11,18,.28) 52%,rgba(7,11,18,.7) 82%,#070b12 100%);
  }

  .final-cta--founder-profile {
    margin-top: -2px;
    background:
      radial-gradient(ellipse 52% 58% at 50% 48%, rgba(81, 155, 204, 0.09), transparent 74%),
      linear-gradient(
        180deg,
        #07101a 0%,
        #07101a 8%,
        #070f18 34%,
        #070d15 68%,
        #070b12 100%
      );
  }

  .cta-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 28px;
    text-align: center;
  }

  .cta-content > div {
    max-width: 680px;
  }

  .cta-content h2 {
    max-width: 13ch;
    margin: 0 auto 18px;
    font-family: var(--font-display);
    font-weight: 400;
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.34);
  }

  .cta-content p {
    max-width: 48ch;
    margin-inline: auto;
    color: rgba(201, 211, 223, 0.86);
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.4);
  }

  .cta-content .btn {
    flex: 0 0 auto;
  }

  @media (max-width: 760px) {
    .final-cta {
      min-height: 460px;
    }

    .cta-content {
      align-items: center;
      gap: 28px;
    }

    .cta-content > div {
      width: 100%;
    }

    .cta-content p {
      max-width: 36ch;
    }

  }

</style>
