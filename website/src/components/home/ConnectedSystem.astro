---
interface Props { locale: 'id' | 'en'; }
const { locale } = Astro.props;
const copy = locale === 'id'
  ? {
      kicker: 'Pilihan layanan',
      title: 'Mulai dari kebutuhan Anda saat ini',
      description: 'Pilih kebutuhan yang paling penting sekarang. Kami menggunakan posisi, tujuan, dan kapasitas internal Anda untuk merekomendasikan titik awal yang praktis.',
      aria: 'Empat layanan Kultivate untuk prioritas yang berbeda',
      signal: 'Prioritas Anda',
      loop: 'Kebutuhan Anda memandu titik awal, layanan yang perlu berjalan bersama, dan pekerjaan yang tidak perlu dilakukan.',
      stages: [
        ['01', 'Visibility tradisional', 'SEO', 'Untuk saat halaman prioritas membutuhkan fondasi search yang lebih kuat di sekitar penawaran dan demand pelanggan.'],
        ['02', 'Pemahaman AI search', 'AEO & GEO', 'Untuk saat expertise Anda perlu dipahami dan diambil dengan jelas oleh AI search.'],
        ['03', 'Dukungan teknis', 'Web Services', 'Untuk saat performa, usability, atau implementasi website membatasi pekerjaan search.'],
        ['04', 'Ritme content', 'Content Management', 'Untuk saat content membutuhkan ritme publikasi dan pembaruan yang jelas.']
      ]
    }
  : {
      kicker: 'Service options',
      title: 'Start with what you need now',
      description: 'Choose the need that matters now. We use your current position, goals, and internal capacity to recommend a practical starting point.',
      aria: 'Four Kultivate services for different business priorities',
      signal: 'Your priorities',
      loop: 'What you need guides where we start, which services work together, and what we leave out.',
      stages: [
        ['01', 'Traditional visibility', 'SEO', 'For when priority pages need stronger search foundations around your offers and customer demand.'],
        ['02', 'AI search understanding', 'AEO & GEO', 'For when your expertise needs to be understood and retrieved clearly by AI search.'],
        ['03', 'Technical support', 'Web Services', 'For when performance, usability, or implementation limits the search work.'],
        ['04', 'Content rhythm', 'Content Management', 'For when useful content needs a clear publishing and refresh rhythm.']
      ]
    };
---

<section id="system" class="connected-system section-padding" aria-labelledby="system-title">
  <div class="system-glow" aria-hidden="true"></div>
  <div class="container">
    <header class="system-header">
      <span class="section-kicker">{copy.kicker}</span>
      <h2 id="system-title">{copy.title}</h2>
      <p>{copy.description}</p>
    </header>
    <div class="flow-frame">
      <ul class="system-flow" aria-label={copy.aria}>
        {copy.stages.map(([index, stage, channel, question]) => (
          <li class="system-step">
            <span class="stage-index text-mono">{index}</span>
            <div class="stage-heading"><span>{stage}</span><strong>{channel}</strong></div>
            <p>{question}</p>
          </li>
        ))}
      </ul>
      <div class="feedback-loop">
        <span class="loop-label text-mono">{copy.signal}</span>
        <div class="loop-track" aria-hidden="true"></div>
        <p>{copy.loop}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .connected-system { position: relative; overflow: hidden; background: radial-gradient(ellipse 52% 54% at 92% 24%, rgba(103,217,255,.065), transparent 74%), radial-gradient(ellipse 48% 60% at 12% 82%, rgba(23,107,255,.07), transparent 76%), linear-gradient(180deg, transparent, rgba(11,19,34,.3) 48%, transparent); }
  .system-glow { position:absolute; inset:14% -18% auto auto; width:66%; height:72%; border-radius:50%; background:radial-gradient(ellipse,rgba(49,117,255,.16),rgba(103,217,255,.035) 44%,transparent 70%); filter:blur(44px); pointer-events:none; }
  .system-header { position:relative; display:grid; grid-template-columns:minmax(0,.95fr) minmax(320px,.65fr); column-gap:clamp(48px,9vw,132px); align-items:end; margin-bottom:clamp(44px,6vw,72px); }
  .system-header .section-kicker { grid-column:1/-1; }
  .system-header h2 { max-width:18ch; }
  .system-header p { max-width:54ch; color:var(--steel); }
  .flow-frame { position:relative; overflow:hidden; border-radius:var(--border-radius-lg); background:rgba(39,50,68,.48); }
  .system-flow { position:relative; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:1px; list-style:none; }
  .system-step { position:relative; min-width:0; min-height:250px; display:flex; flex-direction:column; justify-content:space-between; padding:clamp(20px,2.2vw,30px); background:linear-gradient(150deg,rgba(11,19,34,.96),rgba(7,11,18,.98)); }
  .stage-index { color:rgba(201,211,223,.52); }
  .stage-heading { display:flex; flex-direction:column; gap:10px; margin-block:16px; }
  .stage-heading span { color:var(--steel); font-family:var(--font-mono); font-size:.63rem; letter-spacing:.09em; text-transform:uppercase; line-height:1.2; }
  .stage-heading strong { color:var(--cloud-white); font-family:var(--font-display); font-size:clamp(1.45rem,2vw,2.25rem); font-weight:400; letter-spacing:-.035em; line-height:1; }
  .system-step p { max-width:22ch; color:rgba(201,211,223,.72); font-size:.78rem; line-height:1.45; }
  .step-arrow { position:absolute; inset:50% -16px auto auto; z-index:2; display:grid; width:32px; height:32px; place-items:center; transform:translateY(-50%); border-radius:50%; background:var(--void-black); color:rgba(103,217,255,.8); }
  .feedback-loop { display:grid; grid-template-columns:160px minmax(140px,1fr) minmax(240px,420px); gap:28px; align-items:center; padding:24px clamp(24px,2.8vw,36px); background:rgba(7,11,18,.92); }
  .loop-label { color:var(--signal-ice); }
  .loop-track { position:relative; height:1px; overflow:hidden; background:rgba(39,50,68,.88); }
  .loop-track::after { content:''; position:absolute; inset:0 auto 0 -35%; width:35%; background:linear-gradient(90deg,transparent,var(--cyan-glow),transparent); animation:loop-scan 8.5s linear infinite; }
  .feedback-loop p { color:var(--steel); font-size:.8rem; line-height:1.45; }
  @keyframes loop-scan { to { transform:translate3d(390%,0,0); } }
  @media (max-width:1100px) { .system-flow { grid-template-columns:repeat(3,minmax(0,1fr)); } .step-arrow { display:none; } }
  @media (max-width:780px) { .system-header { grid-template-columns:1fr; gap:20px; } .system-flow { grid-template-columns:1fr; } .system-step { min-height:188px; } .feedback-loop { grid-template-columns:1fr; gap:14px; } }
  @media (prefers-reduced-motion:reduce) { .loop-track::after { animation:none; opacity:.45; transform:translate3d(185%,0,0); } }
</style>
