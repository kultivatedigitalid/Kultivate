---
interface Props { locale: 'id' | 'en'; }
const { locale } = Astro.props;
const copy = locale === 'id'
  ? {
      kicker: 'Satu sistem, dua keahlian',
      title: 'Search yang kuat membutuhkan website yang kuat',
      description: 'Kami melihat visibility dan website sebagai satu sistem. Strategi menemukan peluangnya; implementasi memastikan peluang itu benar-benar bekerja.',
      aria: 'Dua keahlian utama Kultivate',
      signal: 'Cara kami menentukan titik awal',
      loop: 'Kami mulai dari hambatan terbesar bisnis Anda—ditemukan atau dikonversi—kemudian menghubungkan kedua disiplin hanya ketika memang dibutuhkan.',
      stages: [
        ['01', 'Ditemukan oleh pelanggan yang tepat', 'SEO', 'Audit, search intent, struktur halaman, technical SEO, dan authority diarahkan pada demand yang bernilai bagi bisnis.'],
        ['02', 'Mengubah perhatian menjadi tindakan', 'Web Services', 'Strategy, UX, development, performance, dan maintenance disusun agar website bekerja sebagai aset bisnis.']
      ]
    }
  : {
      kicker: 'One system, two disciplines',
      title: 'Strong search needs a strong website',
      description: 'We treat visibility and the website as one system. Strategy finds the opportunity; implementation makes sure that opportunity can perform.',
      aria: 'Kultivate\'s two core disciplines',
      signal: 'How we choose the starting point',
      loop: 'We begin with the biggest business constraint—being found or converting attention—then connect both disciplines only when the work calls for it.',
      stages: [
        ['01', 'Be found by the right customers', 'SEO', 'Audits, search intent, page structure, technical SEO, and authority are directed at demand with real business value.'],
        ['02', 'Turn attention into action', 'Web Services', 'Strategy, UX, development, performance, and maintenance shape the website into a working business asset.']
      ]
    };
---

<section id="system" class="connected-system section-padding flow-section" aria-labelledby="system-title" data-scroll-key="home-system">
  <div class="system-glow" aria-hidden="true"></div>
  <div class="container">
    <header class="system-header" data-reveal>
      <span class="section-kicker">{copy.kicker}</span>
      <h2 id="system-title">{copy.title}</h2>
      <p>{copy.description}</p>
    </header>
    <div class="flow-frame">
      <ul class="system-flow" aria-label={copy.aria}>
        {copy.stages.map(([index, stage, channel, question], stepIndex) => (
          <li class="system-step" data-reveal style={`--reveal-delay: ${stepIndex * 100}ms`}>
            <span class="stage-index text-mono">{index}</span>
            <div class="stage-heading"><span>{stage}</span><strong>{channel}</strong></div>
            <p>{question}</p>
          </li>
        ))}
      </ul>
      <div class="system-note" data-reveal>
        <span class="loop-label text-mono">{copy.signal}</span>
        <p>{copy.loop}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .connected-system { position:relative; overflow:hidden; background:radial-gradient(ellipse 52% 54% at 92% 24%,rgba(103,217,255,.065),transparent 74%),radial-gradient(ellipse 48% 60% at 12% 82%,rgba(23,107,255,.07),transparent 76%),linear-gradient(180deg,transparent,rgba(11,19,34,.3) 48%,transparent); }
  .system-glow { position:absolute; inset:14% -18% auto auto; width:66%; height:72%; border-radius:50%; background:radial-gradient(ellipse,rgba(49,117,255,.16),rgba(103,217,255,.035) 44%,transparent 70%); filter:blur(44px); pointer-events:none; }
  .system-header { position:relative; display:grid; grid-template-columns:minmax(0,.95fr) minmax(320px,.65fr); column-gap:clamp(48px,9vw,132px); align-items:end; margin-bottom:clamp(44px,6vw,72px); }
  .system-header .section-kicker { grid-column:1/-1; }
  .system-header h2 { max-width:18ch; }
  .system-header p { max-width:54ch; color:var(--steel); }
  .flow-frame { position:relative; overflow:hidden; border-radius:var(--border-radius-lg); background:rgba(91,122,151,.28); box-shadow:0 28px 90px rgba(2,8,16,.2); }
  .system-flow { position:relative; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1px; list-style:none; }
  .system-step { position:relative; min-width:0; min-height:clamp(300px,30vw,390px); display:flex; flex-direction:column; justify-content:space-between; padding:clamp(26px,3.2vw,46px); background:linear-gradient(150deg,rgba(17,39,57,.96),rgba(10,23,36,.98)); transition:background-color 260ms ease,transform 300ms var(--ease-out); }
  .stage-index { color:rgba(201,211,223,.52); }
  .stage-heading { display:flex; flex-direction:column; gap:14px; margin-block:20px; }
  .stage-heading span { max-width:34ch; color:var(--steel); font-family:var(--font-mono); font-size:.65rem; letter-spacing:.09em; text-transform:uppercase; line-height:1.35; }
  .stage-heading strong { max-width:10ch; color:var(--cloud-white); font-family:var(--font-display); font-size:clamp(2.15rem,4vw,4.8rem); font-weight:400; letter-spacing:-.045em; line-height:.92; }
  .system-step p { max-width:46ch; color:rgba(201,211,223,.74); font-size:.9rem; line-height:1.58; }
  .system-note { display:grid; grid-template-columns:minmax(180px,.42fr) minmax(280px,1fr); gap:clamp(28px,5vw,76px); align-items:start; padding:clamp(26px,3.2vw,42px) clamp(26px,3.6vw,50px); background:rgba(7,18,29,.94); }
  .loop-label { color:var(--signal-ice); }
  .system-note p { max-width:58ch; color:rgba(201,211,223,.78); font-size:.9rem; line-height:1.55; }
  @media (hover:hover) and (pointer:fine) { .system-step:hover { background:linear-gradient(150deg,rgba(20,48,69,.98),rgba(10,26,41,.98)); transform:translateY(-2px); } }
  @media (max-width:780px) { .system-header { grid-template-columns:1fr; gap:20px; } .system-flow { grid-template-columns:1fr; } .system-step { min-height:270px; } .system-note { grid-template-columns:1fr; gap:14px; } }
  @media (prefers-reduced-motion:reduce) { .system-step { transition:none; } }
</style>
