---
import { founderIdentity } from '../../data/founder';

interface Props { locale: 'id' | 'en'; }
const { locale } = Astro.props;

const temporaryCeoImage = '/assets/about/collage/collage-07.webp';
const copy = locale === 'id'
  ? {
      note: 'Website yang baik harus membantu orang memahami bisnis Anda, mempercayainya, dan tahu langkah berikutnya. Kultivate selalu mulai dari konteks Anda, agar setiap rekomendasi memiliki alasan bisnis yang jelas.',
      imageAlt: 'Portrait anonim untuk catatan CEO Kultivate',
    }
  : {
      note: 'A good website should help people understand your business, trust it, and know what to do next. Kultivate starts with your context first, so every recommendation has a clear business reason behind it.',
      imageAlt: 'Anonymous portrait for the Kultivate CEO note',
    };
---

<section
  id="ceo-note"
  class="ceo-note-section flow-section"
  aria-label={locale === 'id' ? 'Catatan CEO Kultivate' : 'Kultivate CEO note'}
>
  <div class="container">
    <div class="ceo-note__layout">
      <figure class="ceo-portrait" data-reveal="image">
        <img
          src={temporaryCeoImage}
          alt={copy.imageAlt}
          width="1280"
          height="853"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <div class="ceo-note__copy" data-reveal>
        <blockquote>
          <p>“{copy.note}”</p>
          <footer>— {founderIdentity.name}</footer>
        </blockquote>
      </div>
    </div>
  </div>
</section>

<style>
  .ceo-note-section {
    padding-block: clamp(64px, 7vw, 96px);
    background: transparent;
  }

  .ceo-note__layout {
    display: grid;
    grid-template-columns: minmax(250px, 360px) minmax(0, 1fr);
    gap: clamp(46px, 8vw, 112px);
    align-items: center;
    width: min(100%, 1080px);
    margin-inline: auto;
  }

  .ceo-portrait {
    position: relative;
    width: min(100%, 360px);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 8px;
    background: #09131e;
  }

  .ceo-portrait::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 52%, rgba(4, 10, 17, 0.42) 100%);
  }

  .ceo-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% center;
    filter: brightness(0.78) saturate(0.72);
  }

  .ceo-note__copy {
    max-width: 690px;
  }

  .ceo-note__copy blockquote {
    margin: 0;
  }

  .ceo-note__copy blockquote p {
    max-width: 32ch;
    color: var(--cloud-white);
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(1.6rem, 2.35vw, 2.65rem);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .ceo-note__copy blockquote footer {
    margin-top: clamp(22px, 3vw, 30px);
    color: rgba(226, 234, 243, 0.72);
    font-size: 0.94rem;
  }

  @media (max-width: 800px) {
    .ceo-note__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 38px;
    }

    .ceo-portrait {
      width: min(72vw, 330px);
    }

    .ceo-note__copy {
      max-width: 620px;
    }
  }

  @media (max-width: 600px) {
    .ceo-note-section {
      padding-block: 56px;
    }

    .ceo-portrait {
      width: min(78vw, 300px);
    }

    .ceo-note__copy blockquote p { font-size: clamp(1.55rem, 7.6vw, 2.2rem); }
  }
</style>
