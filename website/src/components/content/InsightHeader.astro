---
interface Props {
  title: string;
  category: string;
  author: string;
  publishedAt: string;
  updatedAt?: string;
  heroImage: string;
  heroAlt: string;
  locale: 'id' | 'en';
}

const { title, category, author, publishedAt, updatedAt, heroImage, heroAlt, locale } = Astro.props;
const dateLocale = locale === 'id' ? 'id-ID' : 'en-GB';
const formatDate = (value: string) =>
  new Intl.DateTimeFormat(dateLocale, { day: 'numeric', month: 'long', year: 'numeric' })
    .format(new Date(value + 'T00:00:00'));
---

<header class="insight-header">
  <div class="insight-header-meta text-mono">
    <a href={'/' + locale + '/insights/'} class="back-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      <span>{locale === 'id' ? 'Kembali ke Blog' : 'Back to Blog'}</span>
    </a>
    <span class="badge">{category}</span>
  </div>

  <h1 class="insight-header-title">{title}</h1>

  <div class="insight-author-bar text-mono">
    <span>{locale === 'id' ? 'Oleh' : 'By'} <strong>{author}</strong></span>
    <span class="dot" aria-hidden="true">&bull;</span>
    <time datetime={publishedAt}>{formatDate(publishedAt)}</time>
    {updatedAt && (
      <>
        <span class="dot" aria-hidden="true">&bull;</span>
        <time datetime={updatedAt}>{locale === 'id' ? 'Diperbarui ' : 'Updated '}{formatDate(updatedAt)}</time>
      </>
    )}
  </div>

  <div class="insight-hero-media">
    <img src={heroImage} alt={heroAlt} loading="eager" fetchpriority="high" class="insight-hero-image" />
  </div>
</header>

<style>
  .insight-header { margin-bottom: var(--spacing-xl); }
  .insight-header-meta { display: flex; justify-content: space-between; align-items: center; gap: 24px; margin-bottom: var(--spacing-md); }
  .back-link { display: inline-flex; min-height: 44px; align-items: center; gap: var(--spacing-xs); color: var(--steel); font-size: 0.7rem; }
  .back-link:hover { color: var(--cyan-glow); }
  .insight-header-title { max-width: 18ch; margin-bottom: var(--spacing-md); color: var(--cloud-white); font-size: clamp(2.4rem, 4.6vw, 4.6rem); font-weight: 540; letter-spacing: -0.04em; line-height: 1; text-wrap: balance; }
  .insight-author-bar { display: flex; flex-wrap: wrap; align-items: center; gap: var(--spacing-xs); margin-bottom: var(--spacing-xl); color: var(--steel); font-size: 0.7rem; }
  .dot { color: var(--slate); }
  .insight-hero-media { width: 100%; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 8px; background: var(--deep-navy); }
  .insight-hero-image { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.76) saturate(0.82); }
  @media (max-width: 560px) {
    .insight-header-meta { align-items: flex-start; flex-direction: column; gap: 8px; }
  }
</style>