---
interface Props {
  title: string;
  slug: string;
  category: string;
  author: string;
  publishedAt: string;
  summary: string;
  heroImage: string;
  heroAlt: string;
  locale: 'id' | 'en';
}

const { title, slug, category, author, publishedAt, summary, heroImage, heroAlt, locale } = Astro.props;
---

<article class="insight-card card">
  <div class="insight-media">
    <img src={heroImage} alt={heroAlt} loading="lazy" class="insight-image" />
    <span class="insight-category text-mono">{category}</span>
  </div>

  <div class="insight-content">
    <div class="insight-meta text-mono">
      <span>{author}</span>
      <span class="dot">•</span>
      <time datetime={publishedAt}>{publishedAt}</time>
    </div>

    <h3 class="insight-title">
      <a href={`/${locale}/insights/${slug}/`}>{title}</a>
    </h3>

    <p class="insight-summary">{summary}</p>

    <a href={`/${locale}/insights/${slug}/`} class="read-more-link">
      <span>{locale === 'id' ? 'Baca Selengkapnya' : 'Read Article'}</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>
</article>

<style>
  .insight-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background-color: var(--deep-navy);
    transition: border-color var(--transition-micro), transform var(--transition-micro);
  }

  .insight-card:hover {
    border-color: var(--electric-blue);
    transform: translateY(-2px);
  }

  .insight-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--void-black);
    overflow: hidden;
  }

  .insight-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: opacity var(--transition-micro);
  }

  .insight-card:hover .insight-image {
    opacity: 1;
  }

  .insight-category {
    position: absolute;
    top: var(--spacing-xs);
    left: var(--spacing-xs);
    font-size: 0.75rem;
    color: var(--cloud-white);
    background-color: var(--electric-blue);
    padding: 2px 8px;
    border-radius: 4px;
  }

  .insight-content {
    display: flex;
    flex-direction: column;
    padding: var(--spacing-md);
    flex-grow: 1;
  }

  .insight-meta {
    font-size: 0.75rem;
    color: var(--steel);
    margin-bottom: var(--spacing-xs);
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
  }

  .dot {
    color: var(--slate);
  }

  .insight-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--cloud-white);
    margin-bottom: var(--spacing-xs);
    line-height: 1.35;
  }

  .insight-title a {
    color: inherit;
  }

  .insight-title a:hover {
    color: var(--cyan-glow);
  }

  .insight-summary {
    font-size: 0.875rem;
    color: var(--mist);
    margin-bottom: var(--spacing-md);
    line-height: 1.5;
    flex-grow: 1;
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--electric-blue);
  }

  .read-more-link:hover {
    color: var(--cyan-glow);
  }

  .read-more-link svg {
    transition: transform var(--transition-micro);
  }

  .read-more-link:hover svg {
    transform: translateX(4px);
  }
</style>
