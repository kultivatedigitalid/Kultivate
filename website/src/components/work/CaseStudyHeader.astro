---
interface Props {
  title: string;
  client: string;
  industry: string;
  period: string;
  services: string[];
  summary: string;
  coverImage: string;
  coverAlt: string;
  proofStatus: 'pending' | 'verified';
  locale: 'id' | 'en';
}

const { title, client, industry, period, services, summary, coverImage, coverAlt, proofStatus, locale } = Astro.props;
---

<header class="case-header">
  <div class="case-header-content">
    <div class="case-meta-row text-mono">
      <a href={`/${locale}/work/`} class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>{locale === 'id' ? 'Kembali ke Karya' : 'Back to Work'}</span>
      </a>
      {proofStatus === 'pending' && (
        <span class="proof-badge text-mono">PLACEHOLDER - NOT PUBLIC PROOF</span>
      )}
    </div>

    <h1 class="case-title">{title}</h1>
    <p class="case-summary">{summary}</p>

    <div class="case-details-grid card">
      <div class="detail-item">
        <span class="detail-label text-mono">{locale === 'id' ? 'Klien' : 'Client'}</span>
        <span class="detail-value">{client}</span>
      </div>
      <div class="detail-item">
        <span class="detail-label text-mono">{locale === 'id' ? 'Industri' : 'Industry'}</span>
        <span class="detail-value">{industry}</span>
      </div>
      <div class="detail-item">
        <span class="detail-label text-mono">{locale === 'id' ? 'Periode' : 'Period'}</span>
        <span class="detail-value">{period}</span>
      </div>
      <div class="detail-item">
        <span class="detail-label text-mono">{locale === 'id' ? 'Layanan' : 'Services'}</span>
        <div class="detail-tags">
          {services.map(service => (
            <span class="badge text-mono">{service}</span>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="case-hero-media">
    <img src={coverImage} alt={coverAlt} loading="eager" fetchpriority="high" class="case-hero-image" />
  </div>
</header>

<style>
  .case-header {
    margin-bottom: var(--spacing-xl);
  }

  .case-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-md);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: 0.8125rem;
    color: var(--steel);
  }

  .back-link:hover {
    color: var(--cyan-glow);
  }

  .proof-badge {
    font-size: 0.6875rem;
    color: var(--warning);
    background-color: rgba(7, 11, 18, 0.85);
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid var(--slate);
  }

  .case-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    color: var(--cloud-white);
    line-height: 1.15;
    margin-bottom: var(--spacing-sm);
  }

  .case-summary {
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    color: var(--mist);
    max-width: 800px;
    margin-bottom: var(--spacing-xl);
    line-height: 1.5;
  }

  .case-details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--spacing-md);
    padding: var(--spacing-md);
    margin-bottom: var(--spacing-xl);
    background-color: var(--deep-navy);
  }

  .detail-item {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .detail-label {
    font-size: 0.75rem;
    color: var(--steel);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .detail-value {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--cloud-white);
  }

  .detail-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .case-hero-media {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--deep-navy);
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    border: 1px solid var(--slate);
  }

  .case-hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
