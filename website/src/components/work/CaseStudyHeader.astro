---
interface Props {
  title: string;
  client: string;
  industry: string;
  period: string;
  services: string[];
  summary: string;
  coverImage: string;
  coverAlt: string;
  proofStatus: 'pending' | 'verified';
  locale: 'id' | 'en';
}

const { title, client, industry, period, services, summary, coverImage, coverAlt, proofStatus, locale } = Astro.props;
---

<header class="case-header">
  <div class="case-hero-media">
    <img src={coverImage} alt={coverAlt} width="1536" height="1024" loading="eager" fetchpriority="high" class="case-hero-image" />
  </div>

  <div class="case-header-content">
    <div class="case-meta-row text-mono">
      <a href={`/${locale}/work/`} class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>{locale === 'id' ? 'Kembali ke Karya' : 'Back to Work'}</span>
      </a>
    </div>

    <h1 class="case-title">{title}</h1>
    <p class="case-summary">{summary}</p>

    <div class="case-details-grid">
      <div class="detail-item">
        <span class="detail-label text-mono">{locale === 'id' ? 'Klien' : 'Client'}</span>
        <span class="detail-value">{client}</span>
      </div>
      <div class="detail-item">
        <span class="detail-label text-mono">{locale === 'id' ? 'Industri' : 'Industry'}</span>
        <span class="detail-value">{industry}</span>
      </div>
      {period && <div class="detail-item">
        <span class="detail-label text-mono">{locale === 'id' ? 'Periode' : 'Period'}</span>
        <span class="detail-value">{period}</span>
      </div>}
      <div class="detail-item">
        <span class="detail-label text-mono">{locale === 'id' ? 'Layanan' : 'Services'}</span>
        <div class="detail-tags">
          {services.map(service => (
            <span class="text-mono">{service}</span>
          ))}
        </div>
      </div>
    </div>
  </div>

</header>

<style>
  .case-header { margin-bottom: 0; }
  .case-hero-media { width: 100%; height: clamp(220px, 50svh, 520px); margin-bottom: clamp(28px, 4vw, 52px); overflow: hidden; border-radius: 8px; background: var(--deep-navy); }
  .case-hero-image { width: 100%; height: 100%; object-fit: contain; }
  .case-meta-row { margin-bottom: 24px; }
  .back-link { display: inline-flex; align-items: center; gap: 8px; color: var(--mist); font-size: .85rem; }
  .back-link:hover { color: var(--signal-ice); }
  .back-link:focus-visible { outline: 2px solid var(--signal-ice); outline-offset: 6px; }
  .case-title { max-width: 24ch; font-size: clamp(2rem, 4vw, 4rem); font-weight: 540; letter-spacing: -.035em; line-height: 1.05; color: var(--cloud-white); margin-bottom: 20px; }
  .case-summary { max-width: 65ch; color: var(--mist); font-size: clamp(1.05rem, 1.5vw, 1.25rem); line-height: 1.65; }
  .case-details-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px 40px; margin-top: 36px; }
  .detail-item { display: flex; flex-direction: column; gap: 10px; }
  .detail-label { font-size: .75rem; color: var(--steel); }
  .detail-value, .detail-tags { color: var(--mist); font-size: .95rem; line-height: 1.6; }
  .detail-tags { display: flex; flex-direction: column; gap: 4px; }
  .detail-tags span { font-family: var(--font-sans); }
  @media (max-width: 760px) { .case-hero-media { height: clamp(220px, 38svh, 360px); } .case-details-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; } }
</style>
