---
interface Props {
  title: string;
  client: string;
  industry: string;
  period: string;
  services: string[];
  summary: string;
  locale: 'id' | 'en';
}

const { title, client, industry, period, services, summary, locale } = Astro.props;
---

<header class="case-header">
  <div class="case-header-content">
    <div class="case-meta-row text-mono">
      <a href={`/${locale}/work/`} class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>{locale === 'id' ? 'Kembali ke Karya' : 'Back to Work'}</span>
      </a>
    </div>

    <h1 class="case-title">{title}</h1>
    <p class="case-summary">{summary}</p>

    <div class="case-details-grid">
      <div class="detail-item">
        <span class="detail-label text-mono">{locale === 'id' ? 'Klien' : 'Client'}</span>
        <span class="detail-value">{client}</span>
      </div>
      <div class="detail-item">
        <span class="detail-label text-mono">{locale === 'id' ? 'Industri' : 'Industry'}</span>
        <span class="detail-value">{industry}</span>
      </div>
      {period && <div class="detail-item">
        <span class="detail-label text-mono">{locale === 'id' ? 'Periode' : 'Period'}</span>
        <span class="detail-value">{period}</span>
      </div>}
      <div class="detail-item">
        <span class="detail-label text-mono">{locale === 'id' ? 'Layanan' : 'Services'}</span>
        <div class="detail-tags">
          {services.map(service => (
            <span class="text-mono">{service}</span>
          ))}
        </div>
      </div>
    </div>
  </div>

</header>

<style>
  .case-meta-row { margin-bottom: 24px; }
  .back-link { display: inline-flex; align-items: center; gap: 8px; color: var(--mist); font-size: .8rem; }
  .back-link:hover { color: var(--signal-ice); }
  .back-link:focus-visible { outline: 2px solid var(--signal-ice); outline-offset: 4px; }
  .case-title { font-size: clamp(1.6rem, 2.3vw, 2.2rem); font-weight: 540; letter-spacing: -.03em; line-height: 1.12; color: var(--cloud-white); margin-bottom: 18px; }
  .case-summary { color: var(--mist); font-size: .96rem; line-height: 1.65; }
  .case-details-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin-top: 24px; }
  .detail-item { display: flex; flex-direction: column; gap: 6px; }
  .detail-item:last-child { grid-column: 1 / -1; }
  .detail-label { font-size: .67rem; color: var(--mist); }
  .detail-value, .detail-tags { color: var(--mist); font-size: .86rem; line-height: 1.5; }
  .detail-tags { display: flex; flex-wrap: wrap; gap: 4px 16px; }
  .detail-tags span { font-family: var(--font-sans); color: inherit; }
  @media (max-width: 900px) { .case-title { font-size: clamp(1.8rem, 5vw, 2.6rem); } }
</style>
