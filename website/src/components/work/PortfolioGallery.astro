---
import InteriorHero from '../shared/InteriorHero.astro';
import { portfolioItems } from '../../data/editorial';

interface Props { locale: 'id' | 'en'; }

const { locale } = Astro.props;
const items = portfolioItems[locale];
const clusters = Array.from({ length: Math.ceil(items.length / 3) }, (_, index) => items.slice(index * 3, index * 3 + 3));
const copy = locale === 'id'
  ? {
      label: 'PORTOFOLIO',
      title: 'Karya pilihan kami',
      description: 'Website, SEO, dan social yang saling menguatkan.',
      note: 'Studi portofolio',
      disclosure: 'Studi konsep ini menunjukkan arah visual dan komposisi portofolio; tidak ditampilkan sebagai klaim keterlibatan klien.'
    }
  : {
      label: 'PORTFOLIO',
      title: 'Selected work',
      description: 'Website, SEO, and social designed to reinforce one another.',
      note: 'Portfolio studies',
      disclosure: 'These concept studies demonstrate portfolio art direction and composition; they are not presented as claims of client engagement.'
    };
---

<InteriorHero
  title={copy.title}
  description={copy.description}
  label={copy.label}
  image="/assets/banners/portfolio.webp"
  imageAlt={locale === 'id' ? 'Bidang arsitektur biru gelap yang bertemu menuju satu titik' : 'Dark blue architectural planes converging toward one point'}
  variant="work"
/>

<section
  class="portfolio-section flow-section"
  aria-label={locale === 'id' ? 'Studi portofolio' : 'Portfolio studies'}
  data-scroll-key="work-gallery"
>
  <div class="container portfolio-lead" data-reveal>
    <span class="text-mono">{copy.note}</span>
    <p>{copy.disclosure}</p>
  </div>

  <div class="portfolio-grid container">
    {clusters.map((cluster, clusterIndex) => (
      <div class="portfolio-cluster" data-work-cluster data-cluster={clusterIndex} data-active="-1">
        {cluster.map((item, itemIndex) => (
          <article
            class="portfolio-item"
            tabindex="0"
            data-cluster-item={itemIndex}
            data-reveal
            style={{ '--project-theme': item.theme, '--reveal-delay': `${itemIndex * 65}ms` }}
          >
            <figure class="portfolio-media">
              <img
                src={item.image}
                alt={item.alt}
                width="1536"
                height="1024"
                loading="lazy"
                decoding="async"
              />
              <figcaption class="portfolio-caption">
                <strong>{item.brand}</strong>
                <span>{item.descriptor}</span>
              </figcaption>
            </figure>
          </article>
        ))}
      </div>
    ))}
  </div>
</section>

<script>
  const setupPortfolioClusters = () => {
    document.querySelectorAll<HTMLElement>('[data-work-cluster]').forEach((cluster) => {
      if (cluster.dataset.ready === 'true') return;
      cluster.dataset.ready = 'true';

      const items = Array.from(cluster.querySelectorAll<HTMLElement>('[data-cluster-item]'));
      const activate = (item: HTMLElement) => {
        cluster.dataset.active = item.dataset.clusterItem ?? '-1';
      };

      items.forEach((item) => {
        item.addEventListener('pointerenter', () => activate(item));
        item.addEventListener('focusin', () => activate(item));
      });

      cluster.addEventListener('pointerleave', () => {
        cluster.dataset.active = '-1';
      });

      cluster.addEventListener('focusout', (event) => {
        const next = event.relatedTarget;
        if (!(next instanceof Node) || !cluster.contains(next)) cluster.dataset.active = '-1';
      });
    });
  };

  setupPortfolioClusters();
  document.addEventListener('astro:page-load', setupPortfolioClusters);
</script>

<style>
  .portfolio-section {
    position: relative;
    padding: clamp(58px, 7vw, 94px) 0 clamp(84px, 10vw, 132px);
    background:
      radial-gradient(ellipse 54% 22% at 50% 8%, rgba(23, 107, 255, 0.055), transparent 82%),
      linear-gradient(180deg, rgba(7, 11, 18, 0.24), rgba(5, 8, 14, 0.56) 52%, rgba(7, 11, 18, 0.32));
  }

  .portfolio-lead {
    display: grid;
    grid-template-columns: minmax(150px, 0.32fr) minmax(280px, 0.68fr);
    gap: 28px;
    align-items: start;
    margin-bottom: clamp(30px, 4vw, 50px);
  }

  .portfolio-lead > span { color: rgba(201, 211, 223, 0.5); }

  .portfolio-lead p {
    max-width: 64ch;
    color: rgba(201, 211, 223, 0.68);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .portfolio-grid {
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 1.5vw, 22px);
  }

  .portfolio-cluster {
    min-width: 0;
    display: grid;
    grid-template-columns: 1.42fr 0.84fr 1.06fr;
    gap: clamp(12px, 1.5vw, 22px);
    transition: grid-template-columns 540ms var(--ease-out);
  }

  .portfolio-cluster[data-cluster='1'] { grid-template-columns: 0.88fr 1.36fr 1fr; }
  .portfolio-cluster[data-cluster='2'] { grid-template-columns: 1.04fr 0.86fr 1.4fr; }
  .portfolio-cluster[data-cluster='3'] { grid-template-columns: 1.34fr 1fr 0.9fr; }

  .portfolio-cluster[data-active='0'] { grid-template-columns: 1.68fr 0.78fr 0.94fr; }
  .portfolio-cluster[data-active='1'] { grid-template-columns: 0.86fr 1.58fr 0.96fr; }
  .portfolio-cluster[data-active='2'] { grid-template-columns: 1fr 0.76fr 1.64fr; }

  .portfolio-item { min-width: 0; outline: none; }

  .portfolio-media {
    position: relative;
    height: clamp(300px, 28vw, 430px);
    overflow: hidden;
    border-radius: 7px;
    background: color-mix(in srgb, var(--project-theme) 34%, #07101a);
  }

  .portfolio-media::after {
    content: '';
    position: absolute;
    inset: 28% 0 0;
    background: linear-gradient(180deg, transparent, rgba(5, 8, 14, 0.9));
    opacity: 0.78;
    transition: opacity 320ms var(--ease-out);
  }

  .portfolio-media img {
    width: 104%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.88) saturate(0.9);
    transform: translate3d(-1.6%, 0, 0) scale(1.045);
    transition:
      transform 760ms var(--ease-out),
      filter 420ms var(--ease-out);
  }

  .portfolio-item:nth-child(2) img { transform: translate3d(-2.6%, 0, 0) scale(1.055); }
  .portfolio-item:nth-child(3) img { transform: translate3d(-0.8%, 0, 0) scale(1.05); }

  .portfolio-caption {
    position: absolute;
    z-index: 1;
    inset: auto 0 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    padding: clamp(18px, 2vw, 28px);
    color: var(--cloud-white);
    opacity: 0.82;
    transition: opacity 260ms var(--ease-out), transform 380ms var(--ease-out);
  }

  .portfolio-caption strong {
    font-size: clamp(1.05rem, 1.45vw, 1.45rem);
    font-weight: 590;
  }

  .portfolio-caption span {
    max-width: 18ch;
    color: rgba(226, 234, 243, 0.76);
    font-size: 0.82rem;
    line-height: 1.3;
    text-align: right;
  }

  @media (hover: hover) and (pointer: fine) {
    .portfolio-item:hover .portfolio-media::after,
    .portfolio-item:focus-visible .portfolio-media::after { opacity: 0.96; }

    .portfolio-item:hover .portfolio-caption,
    .portfolio-item:focus-visible .portfolio-caption {
      opacity: 1;
      transform: translate3d(0, -2px, 0);
    }

    .portfolio-item:hover img,
    .portfolio-item:focus-visible img {
      filter: brightness(0.98) saturate(1);
      transform: translate3d(-1.4%, 0, 0) scale(1.018);
    }

    .portfolio-item:focus-visible .portfolio-media {
      outline: 2px solid var(--signal-ice);
      outline-offset: 3px;
    }
  }

  @media (max-width: 1040px) {
    .portfolio-cluster,
    .portfolio-cluster[data-cluster],
    .portfolio-cluster[data-active] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      transition: none;
    }

    .portfolio-cluster .portfolio-item:last-child:nth-child(odd) { grid-column: 1 / -1; }
  }

  @media (max-width: 700px), (hover: none) {
    .portfolio-lead { grid-template-columns: 1fr; gap: 12px; }

    .portfolio-cluster,
    .portfolio-cluster[data-cluster],
    .portfolio-cluster[data-active] { grid-template-columns: 1fr; }

    .portfolio-cluster .portfolio-item:last-child:nth-child(odd) { grid-column: auto; }
    .portfolio-media { height: auto; aspect-ratio: 4 / 3; }
    .portfolio-media::after { opacity: 0.92; }
    .portfolio-caption { opacity: 1; transform: none; padding: 20px; }

    .portfolio-media img,
    .portfolio-item:nth-child(2) img,
    .portfolio-item:nth-child(3) img {
      width: 100%;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portfolio-cluster,
    .portfolio-media img,
    .portfolio-caption,
    .portfolio-media::after { transition: none; }

    .portfolio-media img,
    .portfolio-item:nth-child(2) img,
    .portfolio-item:nth-child(3) img { transform: none; }
  }
</style>
