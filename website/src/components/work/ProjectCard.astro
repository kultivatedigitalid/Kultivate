---
interface Props {
  title: string;
  slug: string;
  client: string;
  summary: string;
  services: string[];
  coverImage: string;
  coverAlt: string;
  locale: 'id' | 'en';
  featured?: boolean;
}

const { title, slug, client, summary, services, coverImage, coverAlt, locale, featured = false } = Astro.props;
---

<article class={`project-card card ${featured ? 'project-card-featured' : ''}`}>
  <div class="project-media">
    <img src={coverImage} alt={coverAlt} loading="lazy" class="project-image" />
    <span class="placeholder-badge text-mono">PLACEHOLDER - NOT PUBLIC PROOF</span>
  </div>

  <div class="project-content">
    <div class="project-tags">
      <span class="client-name text-mono">{client}</span>
      {services.map(service => (
        <span class="badge text-mono">{service}</span>
      ))}
    </div>

    <h3 class="project-title">
      <a href={`/${locale}/work/${slug}/`}>{title}</a>
    </h3>

    <p class="project-summary">{summary}</p>

    <a href={`/${locale}/work/${slug}/`} class="btn-link">
      <span>{locale === 'id' ? 'Lihat Case Study' : 'View Case Study'}</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    transition: border-color var(--transition-micro), transform var(--transition-micro);
  }

  .project-card:hover {
    border-color: var(--electric-blue);
    transform: translateY(-2px);
  }

  .project-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--void-black);
    overflow: hidden;
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
    transition: opacity var(--transition-micro);
  }

  .project-card:hover .project-image {
    opacity: 1;
  }

  .placeholder-badge {
    position: absolute;
    top: var(--spacing-xs);
    right: var(--spacing-xs);
    font-size: 0.6875rem;
    color: var(--warning);
    background-color: rgba(7, 11, 18, 0.85);
    padding: 2px 6px;
    border-radius: 4px;
    border: 1px solid var(--slate);
  }

  .project-content {
    display: flex;
    flex-direction: column;
    padding: var(--spacing-md);
    flex-grow: 1;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-sm);
  }

  .client-name {
    font-size: 0.75rem;
    color: var(--cyan-glow);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .project-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--cloud-white);
    margin-bottom: var(--spacing-xs);
    line-height: 1.3;
  }

  .project-title a {
    color: inherit;
  }

  .project-title a:hover {
    color: var(--cyan-glow);
  }

  .project-summary {
    font-size: 0.9375rem;
    color: var(--mist);
    margin-bottom: var(--spacing-md);
    line-height: 1.5;
    flex-grow: 1;
  }

  .btn-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--electric-blue);
    transition: color var(--transition-micro);
  }

  .btn-link:hover {
    color: var(--cyan-glow);
  }

  .btn-link svg {
    transition: transform var(--transition-micro);
  }

  .btn-link:hover svg {
    transform: translateX(4px);
  }

  .project-card-featured {
    grid-column: span 1;
  }

  @media (min-width: 1024px) {
    .project-card-featured {
      grid-column: span 2;
    }

    .project-card-featured .project-media {
      aspect-ratio: 21 / 9;
    }

    .project-card-featured .project-title {
      font-size: 1.625rem;
    }
  }
</style>
