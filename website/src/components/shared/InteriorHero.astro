---
import HeroShell from './HeroShell.astro';

import type { HeroSceneName } from '../../data/hero-scenes';

interface Props {
  scene?: HeroSceneName;
  title: string;
  description?: string;
  image: string;
  imageAlt?: string;
  label?: string;
  compact?: boolean;
  variant?: 'services' | 'work' | 'about' | 'insights' | 'contact' | 'legal-compact';
  focalPoint?: string;
}

const {
  title,
  scene,
  description,
  image,
  imageAlt = '',
  label,
  compact = false,
  variant = compact ? 'legal-compact' : 'work',
  focalPoint = '50% 50%',
} = Astro.props;
---

<HeroShell
  scene={scene}
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  label={label}
  variant={variant}
  compact={compact}
  focalPoint={focalPoint}
/>
