---
interface Props {
  src: string;
  alt?: string;
  priority?: boolean;
  ambient?: boolean;
  depth?: boolean;
  focalPoint?: string;
  motion?: boolean;
  centered?: boolean;
}

const {
  src,
  alt = '',
  priority = true,
  ambient = true,
  depth = false,
  focalPoint = '50% 50%',
  motion = false,
  centered = false,
} = Astro.props;
---

<div
  class="hero-visual"
  data-hero-visual
  data-depth={depth ? 'true' : undefined}
  data-motion={motion ? 'true' : undefined}
  data-centered={centered ? 'true' : undefined}
  aria-hidden={alt ? undefined : 'true'}
>
  <img
    src={src}
    alt={alt}
    width="1536"
    height="1024"
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={priority ? 'high' : 'auto'}
    data-ambient={ambient ? 'true' : undefined}
    data-load-reveal={motion ? 'true' : undefined}
    style={`--hero-focal-point: ${focalPoint}`}
  />
</div>

<script>
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const bindImageLoadReveals = () => {
    document.querySelectorAll<HTMLImageElement>('[data-hero-visual] img[data-load-reveal="true"]').forEach((image) => {
      if (image.dataset.loadRevealBound === 'true') return;
      image.dataset.loadRevealBound = 'true';
      const revealImage = () => {
        if (reducedMotion.matches) return;
        image.animate(
          [{ opacity: 0.32 }, { opacity: 1 }],
          { duration: 560, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
        );
      };
      if (image.complete && image.naturalWidth > 0) {
        requestAnimationFrame(revealImage);
      } else {
        image.addEventListener('load', revealImage, { once: true });
      }
    });
  };

  bindImageLoadReveals();
  document.addEventListener('astro:page-load', bindImageLoadReveals);
  document.querySelectorAll<HTMLElement>('[data-hero-visual][data-depth="true"]').forEach((visual) => {
    if (!finePointer.matches || reducedMotion.matches) return;
    const hero = visual.closest<HTMLElement>('[data-hero-shell]');
    if (!hero) return;

    let frame = 0;
    const update = (event: PointerEvent) => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const rect = hero.getBoundingClientRect();
        const x = ((event.clientX - rect.left) / rect.width - 0.5) * 8;
        const y = ((event.clientY - rect.top) / rect.height - 0.5) * 6;
        visual.style.setProperty('--hero-depth-x', `${x.toFixed(2)}px`);
        visual.style.setProperty('--hero-depth-y', `${y.toFixed(2)}px`);
      });
    };

    hero.addEventListener('pointermove', update, { passive: true });
    hero.addEventListener('pointerleave', () => {
      cancelAnimationFrame(frame);
      visual.style.setProperty('--hero-depth-x', '0px');
      visual.style.setProperty('--hero-depth-y', '0px');
    });
  });
</script>

<style>
  .hero-visual {
    position: absolute;
    inset: -10px;
    z-index: -2;
    overflow: hidden;
    transform: translate3d(var(--hero-depth-x, 0), var(--hero-depth-y, 0), 0);
    transition: transform 520ms cubic-bezier(0.16, 1, 0.3, 1);
    --hero-art-shift-y: 0%;
  }

  .hero-visual[data-centered='true'] {
    --hero-art-shift-y: -5%;
  }

  .hero-visual img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-visual img {
    object-fit: cover;
    object-position: var(--hero-focal-point);
    transform: scale(1.02) translate3d(0, var(--hero-art-shift-y), 0);
    animation: hero-ambient 20s var(--ease-in-out) infinite alternate;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 68%, rgba(0, 0, 0, 0.92) 78%, rgba(0, 0, 0, 0.48) 91%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 0%, #000 68%, rgba(0, 0, 0, 0.92) 78%, rgba(0, 0, 0, 0.48) 91%, transparent 100%);
  }

  .hero-visual[data-motion='true'] img[data-ambient='true'] {
    animation: hero-ambient-active 15s var(--ease-in-out) infinite alternate both;
  }

  @keyframes hero-ambient-active {
    from { transform: scale(1.025) translate3d(-0.55%, calc(var(--hero-art-shift-y) + 0.35%), 0); }
    to { transform: scale(1.055) translate3d(0.75%, calc(var(--hero-art-shift-y) - 0.55%), 0); }
  }


  @keyframes hero-ambient {
    from { transform: scale(1.02) translate3d(-0.25%, calc(var(--hero-art-shift-y) + 0.2%), 0); }
    to { transform: scale(1.045) translate3d(0.45%, calc(var(--hero-art-shift-y) - 0.35%), 0); }
  }

  @media (max-width: 760px) {
    .hero-visual {
      inset: 0;
      transform: none;
    }

    .hero-visual[data-centered='true'] {
      --hero-art-shift-y: -2.75%;
    }

    .hero-visual img {
      transform: scale(1.025) translate3d(0, var(--hero-art-shift-y), 0);
      animation-duration: 24s;
    }

    .hero-visual[data-motion='true'] img[data-ambient='true'] {
      animation-duration: 18s;
    }
  }

  @media (prefers-reduced-motion: reduce) {

    .hero-visual {
      transform: none;
      transition: none;
    }

    .hero-visual img {
      animation: none;
      transform: scale(1.02) translate3d(0, var(--hero-art-shift-y), 0);
    }
  }
</style>
