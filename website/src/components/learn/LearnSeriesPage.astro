---
import VideoLessonCard from '../learning/VideoLessonCard.astro';
import {
  getLearningLessonsForSeries,
  learningCategoryLabels,
  learningStageLabels,
  type LearningLocale,
  type LearningSeries,
} from '../../data/learning';

interface Props {
  locale: LearningLocale;
  series: LearningSeries;
}

const { locale, series } = Astro.props;
const lessons = getLearningLessonsForSeries(series.id);
const relatedServicePath = `/${locale}/services/${series.category}/`;
const serviceLabel = learningCategoryLabels[series.category];
const hasVideos = lessons.some(lesson => lesson.videoId.trim());
const learnPath = `/${locale}/learn/`;
const copy = locale === 'id' ? {
  back: 'Kembali ke Learn', course: `Course ${String(series.order).padStart(2, '0')}`,
  lessonCount: `${series.chapters.length} chapter · ${lessons.length} materi`,
  audience: 'Untuk', modules: 'Isi course', lesson: 'Materi',
  upcoming: 'Video akan tersedia. Jelajahi ringkasan dan tujuan setiap materi terlebih dahulu.',
  previous: 'Materi sebelumnya', next: 'Materi berikutnya', progress: 'Progress',
  related: 'Layanan terkait',
  relatedBody: 'Ingin menerapkan pemahaman ini pada kebutuhan bisnis Anda? Pelajari pendekatan layanan kami.',
  relatedCta: `Pelajari ${serviceLabel}`,
} : {
  back: 'Back to Learn', course: `Course ${String(series.order).padStart(2, '0')}`,
  lessonCount: `${series.chapters.length} chapters · ${lessons.length} lessons`,
  audience: 'For', modules: 'Course contents', lesson: 'Lesson',
  upcoming: 'Videos are coming. Explore the lesson summaries and learning objectives in the meantime.',
  previous: 'Previous lesson', next: 'Next lesson', progress: 'Progress',
  related: 'Related service',
  relatedBody: 'Ready to apply these ideas to your business? Explore how our service can help.',
  relatedCta: `Explore ${serviceLabel}`,
};
---

<div
  class="learn-series-page page-flow"
  data-learn-series
  data-series-id={series.id}
  data-locale={locale}
>
  <section class="learn-workspace flow-section" aria-labelledby="course-title">
    <div class="container">
      <div class="learn-workspace__layout">
        <aside class="learn-modules" aria-labelledby="course-title">
          <a class="learn-back" href={learnPath}>← {copy.back}</a>
          <span class="text-mono">{copy.course}</span>
          <h1 id="course-title">{series.title[locale]}</h1>
          <p class="learn-course-count">{copy.lessonCount}</p>
          {hasVideos && <div class="learn-progress" aria-label={copy.progress}>
            <div class="learn-progress__meta text-mono">
              <span>{copy.progress}</span>
              <span data-learn-progress-count>0 / {lessons.length}</span>
            </div>
            <div class="learn-progress__track" role="progressbar" aria-valuemin="0" aria-valuemax={lessons.length} aria-valuenow="0" data-learn-progress><span data-learn-progress-fill></span></div>
          </div>}
          <details class="learn-outline" open data-course-outline>
            <summary>{copy.modules}<span aria-hidden="true">⌄</span></summary>
            <nav aria-label={copy.modules}>
              <ol class="learn-chapters">
                {series.chapters.map((chapter, chapterIndex) => (
                  <li class="learn-chapter" data-chapter={chapter.id}>
                    <h2><span>{String(chapterIndex + 1).padStart(2, '0')}</span>{chapter.title[locale]}</h2>
                    <p class="learn-chapter__stage">{learningStageLabels[chapter.stage][locale]}</p>
                    <ol>
                      {chapter.lessons.map(lesson => (
                        <li>
                          <a href={`#lesson-${lesson.id}`} data-lesson-select={lesson.id} aria-controls={`series-panel-${lesson.id}`}>
                            <span class="learn-modules__title">{lesson.title[locale]}</span>
                            <span class="learn-modules__done" data-lesson-done hidden aria-label={locale === 'id' ? 'Selesai' : 'Complete'}>✓</span>
                          </a>
                        </li>
                      ))}
                    </ol>
                  </li>
                ))}
              </ol>
            </nav>
          </details>
        </aside>

        <div class="learn-player">
          <header class="learn-player__intro">
            <p>{series.description[locale]}</p>
            <p class="learn-audience"><strong>{copy.audience}</strong> {series.audience[locale]}</p>
            {!hasVideos && <p class="learn-availability">{copy.upcoming}</p>}
          </header>

          {lessons.map((lesson, index) => (
            <section
              id={`series-panel-${lesson.id}`}
              class="learn-player__panel"
              data-lesson-panel={lesson.id}
              aria-labelledby={`lesson-heading-${lesson.id}`}
            >
              <VideoLessonCard
                lesson={lesson}
                locale={locale}
                context="learn"
                index={index}
                display="player"
                eyebrow={`${series.chapters.find(chapter => chapter.id === lesson.chapterId)?.title[locale]} · ${copy.lesson} ${index + 1} / ${lessons.length}`}
              />

              <nav class="learn-player__controls" aria-label={locale === 'id' ? 'Navigasi materi' : 'Lesson navigation'}>
                {index > 0 ? (
                  <a href={`#lesson-${lessons[index - 1].id}`} class="link-hover-arrow" data-lesson-step={lessons[index - 1].id} data-step-direction="previous">
                    <span aria-hidden="true">&#8592;</span><span><small>{copy.previous}</small>{lessons[index - 1].title[locale]}</span>
                  </a>
                ) : <span></span>}
                {index < lessons.length - 1 ? (
                  <a href={`#lesson-${lessons[index + 1].id}`} class="link-hover-arrow" data-lesson-step={lessons[index + 1].id} data-step-direction="next">
                    <span><small>{copy.next}</small>{lessons[index + 1].title[locale]}</span><span aria-hidden="true">&#8594;</span>
                  </a>
                ) : <span></span>}
              </nav>
            </section>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="learn-related flow-section light-field" aria-labelledby="learn-related-title">
    <div class="container learn-related__layout" data-reveal>
      <div>
        <span class="text-mono">{copy.related}</span>
        <h2 id="learn-related-title">{serviceLabel}</h2>
      </div>
      <div>
        <p>{copy.relatedBody}</p>
        <a class="link-hover-arrow" href={relatedServicePath} data-learn-service-link>
          <span>{copy.relatedCta}</span><span aria-hidden="true">&#8594;</span>
        </a>
      </div>
    </div>
  </section>
</div>

<script>
  import { trackFunnelEvent } from '../../scripts/funnel-analytics';

  const setupLearnSeries = () => {
    document.querySelectorAll<HTMLElement>('[data-learn-series]').forEach(root => {
      if (root.dataset.seriesReady === 'true') return;
      root.dataset.seriesReady = 'true';
      const seriesId = root.dataset.seriesId ?? '';
      const selectors = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-lesson-select]'));
      const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-lesson-panel]'));
      const outline = root.querySelector<HTMLDetailsElement>('[data-course-outline]');
      const mobileLayout = matchMedia('(max-width: 920px)');
      const updateOutline = () => { if (outline) outline.open = !mobileLayout.matches; };
      mobileLayout.addEventListener('change', updateOutline);
      const storageKey = `kultivate:learn-progress:${root.dataset.locale}:${seriesId}`;
      const completionButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-lesson-complete]'));
      let completed = new Set<string>();
      try {
        const saved = JSON.parse(localStorage.getItem(storageKey) ?? '[]');
        if (Array.isArray(saved)) completed = new Set(saved.filter((id): id is string => typeof id === 'string'));
      } catch { /* Storage is optional; navigation does not depend on it. */ }
      const updateProgress = () => {
        const count = selectors.filter(link => completed.has(link.dataset.lessonSelect ?? '')).length;
        const counter = root.querySelector('[data-learn-progress-count]');
        const fill = root.querySelector<HTMLElement>('[data-learn-progress-fill]');
        if (counter) counter.textContent = `${count} / ${selectors.length}`;
        root.querySelector('[data-learn-progress]')?.setAttribute('aria-valuenow', String(count));
        if (fill) fill.style.width = `${selectors.length ? count / selectors.length * 100 : 0}%`;
        selectors.forEach(link => {
          const done = link.querySelector<HTMLElement>('[data-lesson-done]');
          if (done) done.hidden = !completed.has(link.dataset.lessonSelect ?? '');
        });
        completionButtons.forEach(button => {
          const done = completed.has(button.dataset.lessonComplete ?? '');
          button.setAttribute('aria-pressed', String(done));
          button.querySelector<HTMLElement>('[data-complete-default]')!.hidden = done;
          button.querySelector<HTMLElement>('[data-complete-active]')!.hidden = !done;
        });
      };
      const openLesson = (id: string, focus = false) => {
        const target = panels.find(panel => panel.dataset.lessonPanel === id) ?? panels[0];
        if (!target) return;
        const selectedId = target.dataset.lessonPanel;
        panels.forEach(panel => {
          const active = panel === target;
          if (!active) panel.querySelector('[data-video-lesson]')?.dispatchEvent(new Event('learn:pause-video'));
          panel.hidden = !active;
        });
        selectors.forEach(link => {
          if (link.dataset.lessonSelect === selectedId) link.setAttribute('aria-current', 'step');
          else link.removeAttribute('aria-current');
        });
        if (!mobileLayout.matches) {
          const current = selectors.find(link => link.dataset.lessonSelect === selectedId);
          const sidebar = root.querySelector<HTMLElement>('.learn-modules');
          if (current && sidebar) {
            const item = current.getBoundingClientRect(), bounds = sidebar.getBoundingClientRect();
            if (item.bottom > bounds.bottom) sidebar.scrollTop += item.bottom - bounds.bottom + 12;
            else if (item.top < bounds.top) sidebar.scrollTop -= bounds.top - item.top + 12;
          }
        }
        if (focus) {
          if (outline && matchMedia('(max-width: 920px)').matches) outline.open = false;
          const heading = target.querySelector<HTMLElement>('h2');
          heading?.focus({ preventScroll: true });
          target.scrollIntoView({ block: 'start', behavior: 'instant' });
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
            target.getAnimations().forEach(animation => animation.cancel());
            target.animate([{opacity: .55, transform: 'translateY(4px)'}, {opacity: 1, transform: 'translateY(0)'}], {duration: 180, easing: 'ease-out'});
          }
        }
      };
      root.querySelectorAll<HTMLAnchorElement>('[data-lesson-select], [data-lesson-step]').forEach(link => {
        link.addEventListener('click', event => {
          if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          const id = link.dataset.lessonSelect ?? link.dataset.lessonStep;
          if (!id) return;
          event.preventDefault();
          if (location.hash !== `#lesson-${id}`) history.pushState(null, '', `#lesson-${id}`);
          openLesson(id, true);
          trackFunnelEvent(link.dataset.stepDirection === 'next' ? 'learn_next_lesson' : 'learn_lesson_start', {
            series_id: seriesId, lesson_id: id, source: link.dataset.stepDirection ?? 'chapter',
          });
        });
      });
      completionButtons.forEach(button => button.addEventListener('click', () => {
        const id = button.dataset.lessonComplete!;
        const done = !completed.has(id);
        if (done) completed.add(id); else completed.delete(id);
        try { localStorage.setItem(storageKey, JSON.stringify([...completed])); } catch { /* Keep in-memory progress. */ }
        updateProgress();
        if (done) trackFunnelEvent('learn_lesson_complete', { series_id: seriesId, lesson_id: id });
      }));
      root.querySelector('[data-learn-service-link]')?.addEventListener('click', () => {
        trackFunnelEvent('learn_to_service_click', { series_id: seriesId });
      });
      const syncHash = () => openLesson(location.hash.replace(/^#lesson-/, ''));
      window.addEventListener('hashchange', syncHash);
      window.addEventListener('popstate', syncHash);
      document.addEventListener('astro:before-swap', () => {
        window.removeEventListener('hashchange', syncHash);
        window.removeEventListener('popstate', syncHash);
        mobileLayout.removeEventListener('change', updateOutline);
      }, { once: true });
      updateOutline();
      syncHash();
      updateProgress();
      trackFunnelEvent('learn_series_open', { series_id: seriesId, locale: root.dataset.locale ?? '' });
    });
  };
  setupLearnSeries();
  document.addEventListener('astro:page-load', setupLearnSeries);
</script>

<style>
  .learn-series-page {
    background:
      radial-gradient(ellipse 68% 28% at 78% 14%, rgba(103, 217, 255, 0.12), transparent 72%),
      linear-gradient(180deg, #3b4853 0%, #35434e 56%, #243441 76%, #101c27 90%, #070b12 100%);
  }

  .learn-workspace {
    padding: clamp(82px, 6.5vw, 94px) 0 clamp(48px, 6vw, 72px);
  }

  .learn-workspace__layout {
    display: grid;
    grid-template-columns: minmax(260px, 0.34fr) minmax(0, 1fr);
    gap: clamp(38px, 6vw, 84px);
    align-items: start;
  }

  .learn-modules { position: sticky; top: 102px; max-height: calc(100svh - 122px); overflow-y: auto; padding-right: 12px; scrollbar-width: thin; scrollbar-color: #7198b0 #243441; }
  .learn-back { display: block; margin: 0 0 28px; color: #d5e5f0; font-size: .88rem; }
  .learn-modules > .text-mono { color: #9fdef5; font-size: .68rem; }
  .learn-modules h1 { margin: 12px 0 16px; font-size: clamp(1.5rem, 2.1vw, 2.1rem); font-weight: 530; letter-spacing: -.03em; line-height: 1.15; text-wrap: balance; }
  .learn-course-count { margin-bottom: 22px; color: #c9dbe7; font-size: .8rem; }
  .learn-progress { margin-bottom: 22px; }
  .learn-progress__meta { display: flex; justify-content: space-between; margin-bottom: 8px; font-size: .7rem; }
  .learn-progress__track { height: 2px; background: #526573; }
  .learn-progress__track span { display: block; width: 0; height: 100%; background: var(--signal-ice); }
  .learn-outline summary { display: flex; justify-content: space-between; align-items: center; min-height: 44px; cursor: pointer; color: #eef5fa; font-size: .9rem; border-block: 1px solid #627988; padding-block: 12px; list-style: none; }
  .learn-outline summary::-webkit-details-marker { display: none; }
  .learn-outline[open] summary > span { transform: rotate(180deg); }
  .learn-modules ol { list-style: none; padding: 0; margin: 0; }
  .learn-chapter { padding-top: 24px; }
  .learn-chapter h2 { display: flex; align-items: baseline; gap: 10px; font-size: .91rem; line-height: 1.45; font-weight: 570; }
  .learn-chapter h2 > span { color: #a5ddef; font-family: var(--font-mono); font-size: .66rem; }
  .learn-chapter__stage { margin: 4px 0 10px 26px; color: #bfd4e2; font-size: .75rem; }
  .learn-chapter a { display: flex; gap: 10px; align-items: center; padding: 12px 12px 12px 26px; min-height: 44px; border-radius: 4px; color: #d5e5f0; font-size: .88rem; line-height: 1.45; transition: background 160ms ease-out; }
  .learn-chapter a[aria-current='step'] { color: #f4faff; background: #122c3e; outline: 1px solid #5d8a9f; outline-offset: -1px; }
  .learn-chapter a:hover { background: #233e51; }
  .learn-modules :is(a, summary):focus-visible { outline: 2px solid var(--signal-ice); outline-offset: -2px; }
  .learn-modules__done { margin-left: auto; color: #b7edff; }
  .learn-modules__done[hidden] { display: none; }
  .learn-player__intro { margin-bottom: 28px; padding-bottom: 22px; border-bottom: 1px solid #667e8e; }
  .learn-player__intro > p:first-child { color: #eef5fa; max-width: 65ch; font-size: 1.08rem; line-height: 1.65; }
  .learn-audience { margin-top: 12px; color: #d5e5f0; font-size: .87rem; line-height: 1.6; }
  .learn-audience strong { font-weight: 550; margin-right: 5px; }
  .learn-availability { margin-top: 12px; color: #bee8fa; font-size: .85rem; line-height: 1.55; }
  .learn-player__panel { scroll-margin-top: 100px; }
  .learn-player__panel + .learn-player__panel { margin-top: 60px; }
  [data-series-ready='true'] .learn-player__panel { margin-top: 0; }
  .learn-player__controls a { display: inline-flex; align-items: center; min-height: 56px; font-size: .9rem; line-height: 1.45; }
  .learn-player__controls a:last-child { justify-self: end; text-align: right; }
  .learn-player__controls small { display: block; color: #c8dce9; font-size: .74rem; margin-bottom: 4px; }
  .learn-player__controls a:focus-visible { outline: 2px solid var(--signal-ice); outline-offset: 4px; }

  .learn-player {
    min-width: 0;
    overflow: clip;
    scroll-margin-top: 84px;
  }

  .learn-series-page :global(.lesson-card--player .lesson-card__rank),
  .learn-series-page :global(.lesson-card--player .lesson-card__meta) {
    color: rgba(226, 234, 243, 0.72);
  }

  .learn-series-page :global(.lesson-card--player .lesson-card__body > p) {
    color: rgba(238, 245, 250, 0.86);
  }

  .learn-series-page :global(.lesson-card--player .lesson-card__outcome p) {
    color: rgba(244, 247, 251, 0.92);
  }

  .learn-player__panel[hidden] {
    display: none;
  }

  .learn-player__controls {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 28px;
    padding-top: 0;
  }

  .learn-player__controls > :last-child {
    justify-self: end;
  }

  .learn-player__controls a {
    color: rgba(226, 234, 243, 0.82);
  }

  .learn-related {
    padding: clamp(28px, 4vw, 52px) 0 clamp(88px, 10vw, 132px);
  }

  .learn-related__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(300px, 0.65fr);
    gap: clamp(40px, 9vw, 132px);
    align-items: end;
    padding-top: clamp(32px, 4vw, 48px);
  }

  .learn-related h2 {
    margin-top: 10px;
    font-size: clamp(2.3rem, 4.8vw, 5rem);
    font-weight: 520;
    letter-spacing: -0.04em;
  }

  .learn-related p {
    max-width: 48ch;
    margin-bottom: 22px;
    color: rgba(238, 245, 250, 0.86);
    line-height: 1.65;
  }

  @media (hover: hover) and (pointer: fine) {
    .learn-modules a:hover { color: var(--cloud-white); }
  }

  @media (max-width: 920px) {
    .learn-workspace__layout,
    .learn-related__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 34px;
    }

    .learn-modules {
      position: static;
    }

    .learn-modules { max-height: none; overflow: visible; padding-right: 0; }
    .learn-outline nav { max-height: min(55svh, 480px); overflow-y: auto; }

    .learn-modules h1 {
      max-width: none;
    }


  }

  @media (max-width: 560px) {
    .learn-player__controls {
      gap: 12px;
    }

    .learn-player__controls a {
      max-width: 15ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .learn-modules a {
      transition: none;
    }
    .learn-progress__track span { transition: none; }
  }

  .learn-related { padding-block:200px; }
  .learn-related :is(h2,p,.text-mono,.link-hover-arrow) { color:#12334d; }

</style>
