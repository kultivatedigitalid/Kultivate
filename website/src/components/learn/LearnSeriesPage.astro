---
import VideoLessonCard from '../learning/VideoLessonCard.astro';
import {
  getLearningLessonsForSeries,
  type LearningLocale,
  type LearningSeries,
} from '../../data/learning';

interface Props {
  locale: LearningLocale;
  series: LearningSeries;
}

const { locale, series } = Astro.props;
const lessons = getLearningLessonsForSeries(series.id);
const relatedServicePath = `/${locale}/services/${series.category}/`;
const roadmapPath = `/${locale}/services/#website-growth-roadmap`;
const learnPath = `/${locale}/learn/`;
const copy = locale === 'id'
  ? {
      back: 'Kembali ke Learn',
      course: `Course ${String(series.order).padStart(2, '0')}`,
      lessonCount: `${lessons.length} materi`,
      modules: 'Isi course',
      current: 'Sedang dibuka',
      lesson: 'Materi',
      previous: 'Materi sebelumnya',
      next: 'Materi berikutnya',
      progress: 'Progress',
      related: 'Layanan terkait',
      relatedBody: series.category === 'seo'
        ? 'Butuh bantuan menerapkan keputusan search ini ke konteks bisnis Anda? Lihat cara kami menangani SEO.'
        : 'Butuh bantuan menerapkan keputusan website ini ke konteks bisnis Anda? Lihat cara kami menangani Web Services.',
      relatedCta: series.category === 'seo' ? 'Pelajari layanan SEO' : 'Pelajari Web Services',
      roadmapTitle: 'Lanjutkan dari insight ke prioritas',
      roadmapBody: 'Gunakan Website Growth Roadmap untuk melihat apakah SEO, Web Services, atau keduanya menjadi langkah berikutnya yang paling berguna.',
      roadmapCta: 'Buka Website Growth Roadmap',
    }
  : {
      back: 'Back to Learn',
      course: `Course ${String(series.order).padStart(2, '0')}`,
      lessonCount: `${lessons.length} lessons`,
      modules: 'Course contents',
      current: 'Current',
      lesson: 'Lesson',
      previous: 'Previous lesson',
      next: 'Next lesson',
      progress: 'Progress',
      related: 'Related service',
      relatedBody: series.category === 'seo'
        ? 'Need help applying these search decisions to your business context? See how we approach SEO.'
        : 'Need help applying these website decisions to your business context? See how we approach Web Services.',
      relatedCta: series.category === 'seo' ? 'Explore SEO services' : 'Explore Web Services',
      roadmapTitle: 'Turn the insight into a priority',
      roadmapBody: 'Use the Website Growth Roadmap to see whether SEO, Web Services, or both should become your most useful next move.',
      roadmapCta: 'Open the Website Growth Roadmap',
    };
---

<div
  class="learn-series-page page-flow"
  data-learn-series
  data-series-id={series.id}
  data-locale={locale}
>
  <section class="learn-workspace flow-section" aria-labelledby="course-title">
    <div class="container">
      <div class="learn-workspace__layout">
        <aside class="learn-modules" aria-labelledby="course-title" data-reveal>
          <span class="text-mono">{copy.modules}</span>
          <h1 id="course-title">{series.title[locale]}</h1>
          <div class="learn-progress" aria-label={copy.progress}>
            <div class="learn-progress__meta text-mono">
              <span>{copy.progress}</span>
              <span data-learn-progress-count>0 / {lessons.length}</span>
            </div>
            <div class="learn-progress__track" role="progressbar" aria-valuemin="0" aria-valuemax={lessons.length} aria-valuenow="0" data-learn-progress><span data-learn-progress-fill></span></div>
          </div>
          <ol>
            {lessons.map((lesson, index) => (
              <li>
                <button
                  type="button"
                  data-lesson-select={lesson.id}
                  aria-controls={`series-panel-${lesson.id}`}
                  aria-current={index === 0 ? 'step' : undefined}
                >
                  <span class="learn-modules__index text-mono">{String(index + 1).padStart(2, '0')}</span>
                  <span class="learn-modules__title">{lesson.title[locale]}</span>
                  <span class="learn-modules__done" data-lesson-done hidden aria-label={locale === 'id' ? 'Selesai' : 'Complete'}>&#10003;</span>
                  <span class="learn-modules__current text-mono" data-current-label hidden={index !== 0}>
                    {copy.current}
                  </span>
                </button>
              </li>
            ))}
          </ol>
        </aside>

        <div class="learn-player" data-reveal="content">
          <div class="learn-player__topbar">
            <a class="link-hover-arrow" href={learnPath}>
              <span aria-hidden="true">&#8592;</span><span>{copy.back}</span>
            </a>
          </div>

          {lessons.map((lesson, index) => (
            <section
              id={`series-panel-${lesson.id}`}
              class="learn-player__panel"
              data-lesson-panel={lesson.id}
              hidden={index !== 0}
              aria-labelledby={`lesson-heading-${lesson.id}`}
            >
              <span id={`lesson-heading-${lesson.id}`} class="sr-only">
                {copy.lesson} {index + 1}: {lesson.title[locale]}
              </span>
              <VideoLessonCard
                lesson={lesson}
                locale={locale}
                context="learn"
                index={index}
                display="player"
              />

              {index === lessons.length - 1 && (
                <aside class="learn-roadmap-cta" aria-labelledby={`roadmap-cta-${series.id}`}>
                  <div>
                    <h2 id={`roadmap-cta-${series.id}`}>{copy.roadmapTitle}</h2>
                    <p>{copy.roadmapBody}</p>
                  </div>
                  <a class="btn btn-primary" href={roadmapPath} data-learn-roadmap-link>
                    <span>{copy.roadmapCta}</span><span aria-hidden="true">&#8594;</span>
                  </a>
                </aside>
              )}

              <nav class="learn-player__controls" aria-label={locale === 'id' ? 'Navigasi materi' : 'Lesson navigation'}>
                {index > 0 ? (
                  <button type="button" class="link-hover-arrow" data-lesson-step={lessons[index - 1].id} data-step-direction="previous">
                    <span aria-hidden="true">&#8592;</span><span>{copy.previous}</span>
                  </button>
                ) : <span></span>}
                {index < lessons.length - 1 ? (
                  <button type="button" class="link-hover-arrow" data-lesson-step={lessons[index + 1].id} data-step-direction="next">
                    <span>{copy.next}</span><span aria-hidden="true">&#8594;</span>
                  </button>
                ) : <span></span>}
              </nav>
            </section>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="learn-related flow-section" aria-labelledby="learn-related-title">
    <div class="container learn-related__layout" data-reveal>
      <div>
        <span class="text-mono">{copy.related}</span>
        <h2 id="learn-related-title">{series.category === 'seo' ? 'SEO' : 'Web Services'}</h2>
      </div>
      <div>
        <p>{copy.relatedBody}</p>
        <a class="link-hover-arrow" href={relatedServicePath} data-learn-service-link>
          <span>{copy.relatedCta}</span><span aria-hidden="true">&#8594;</span>
        </a>
      </div>
    </div>
  </section>
</div>

<script>
  import { trackFunnelEvent } from '../../scripts/funnel-analytics';

  const setupLearnSeries = () => {
    document.querySelectorAll<HTMLElement>('[data-learn-series]').forEach((root) => {
      if (root.dataset.seriesReady === 'true') return;
      root.dataset.seriesReady = 'true';

      const seriesId = root.dataset.seriesId ?? '';
      const selectors = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-lesson-select]'));
      const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-lesson-panel]'));
      const player = root.querySelector<HTMLElement>('.learn-player');
      const progress = root.querySelector<HTMLElement>('[data-learn-progress]');
      const progressFill = root.querySelector<HTMLElement>('[data-learn-progress-fill]');
      const progressCount = root.querySelector<HTMLElement>('[data-learn-progress-count]');
      const storageKey = `kultivate:learn-progress:${root.dataset.locale ?? ''}:${seriesId}`;
      let completed = new Set<string>();

      try {
        const saved = JSON.parse(window.localStorage.getItem(storageKey) ?? '[]');
        if (Array.isArray(saved)) completed = new Set(saved.filter((id): id is string => typeof id === 'string'));
      } catch {
        completed = new Set();
      }

      const updateProgress = () => {
        const completedCount = selectors.filter((button) => completed.has(button.dataset.lessonSelect ?? '')).length;
        if (progressCount) progressCount.textContent = `${completedCount} / ${selectors.length}`;
        if (progress) progress.setAttribute('aria-valuenow', String(completedCount));
        if (progressFill) progressFill.style.width = `${selectors.length ? (completedCount / selectors.length) * 100 : 0}%`;

        selectors.forEach((button) => {
          const isComplete = completed.has(button.dataset.lessonSelect ?? '');
          button.dataset.completed = String(isComplete);
          const done = button.querySelector<HTMLElement>('[data-lesson-done]');
          if (done) done.hidden = !isComplete;
        });

        root.querySelectorAll<HTMLButtonElement>('[data-lesson-complete]').forEach((button) => {
          const isComplete = completed.has(button.dataset.lessonComplete ?? '');
          button.setAttribute('aria-pressed', String(isComplete));
          const defaultLabel = button.querySelector<HTMLElement>('[data-complete-default]');
          const activeLabel = button.querySelector<HTMLElement>('[data-complete-active]');
          if (defaultLabel) defaultLabel.hidden = isComplete;
          if (activeLabel) activeLabel.hidden = !isComplete;
        });
      };

      const persistProgress = () => {
        try {
          window.localStorage.setItem(storageKey, JSON.stringify(Array.from(completed)));
        } catch {
          // Progress remains available for this page view when storage is unavailable.
        }
        updateProgress();
      };

      const openLesson = (lessonId: string, source: 'module' | 'previous' | 'next') => {
        const targetPanel = panels.find((panel) => panel.dataset.lessonPanel === lessonId);
        if (!targetPanel) return;

        const activePanel = panels.find((panel) => !panel.hidden);
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const shouldAnimate = Boolean(player && activePanel && activePanel !== targetPanel && !reduceMotion);
        const previousHeight = shouldAnimate ? player?.getBoundingClientRect().height ?? 0 : 0;

        selectors.forEach((button) => {
          const isCurrent = button.dataset.lessonSelect === lessonId;
          if (isCurrent) button.setAttribute('aria-current', 'step');
          else button.removeAttribute('aria-current');
          const label = button.querySelector<HTMLElement>('[data-current-label]');
          if (label) label.hidden = !isCurrent;
        });

        panels.forEach((panel) => {
          panel.hidden = panel.dataset.lessonPanel !== lessonId;
        });

        if (shouldAnimate && player) {
          const nextHeight = player.getBoundingClientRect().height;
          player.getAnimations().forEach((animation) => animation.cancel());
          player.animate(
            [
              { height: `${previousHeight}px` },
              { height: `${nextHeight}px` },
            ],
            {
              duration: 420,
              easing: 'cubic-bezier(0.23, 1, 0.32, 1)',
            },
          );
          targetPanel.animate(
            [
              { opacity: 0, transform: 'translate3d(0, 10px, 0)' },
              { opacity: 1, transform: 'translate3d(0, 0, 0)' },
            ],
            { duration: 360, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
          );
        }

        history.replaceState(null, '', `#lesson-${lessonId}`);
        trackFunnelEvent(source === 'next' ? 'learn_next_lesson' : 'learn_lesson_start', {
          series_id: seriesId,
          lesson_id: lessonId,
          source,
        });

        if (source === 'module' && window.matchMedia('(max-width: 920px)').matches) {
          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.requestAnimationFrame(() => {
            root.querySelector<HTMLElement>('.learn-player')?.scrollIntoView({
              behavior: reduceMotion ? 'auto' : 'smooth',
              block: 'start',
            });
          });
        }
      };

      selectors.forEach((button) => {
        button.addEventListener('click', () => {
          const lessonId = button.dataset.lessonSelect;
          if (lessonId) openLesson(lessonId, 'module');
        });
      });

      root.querySelectorAll<HTMLButtonElement>('[data-lesson-step]').forEach((button) => {
        button.addEventListener('click', () => {
          const lessonId = button.dataset.lessonStep;
          const source = button.dataset.stepDirection === 'next' ? 'next' : 'previous';
          if (lessonId) openLesson(lessonId, source);
        });
      });

      root.querySelector<HTMLElement>('[data-learn-service-link]')?.addEventListener('click', () => {
        trackFunnelEvent('learn_to_service_click', { series_id: seriesId });
      });

      root.querySelector<HTMLElement>('[data-learn-roadmap-link]')?.addEventListener('click', () => {
        trackFunnelEvent('learn_to_service_click', { series_id: seriesId, target: 'website-growth-roadmap' });
      });

      root.querySelectorAll<HTMLButtonElement>('[data-lesson-complete]').forEach((button) => {
        button.addEventListener('click', () => {
          const lessonId = button.dataset.lessonComplete;
          if (!lessonId) return;
          const isNowComplete = !completed.has(lessonId);
          if (isNowComplete) completed.add(lessonId);
          else completed.delete(lessonId);
          persistProgress();
          if (isNowComplete) {
            trackFunnelEvent('learn_lesson_complete', { series_id: seriesId, lesson_id: lessonId });
          }
        });
      });

      const hashLesson = window.location.hash.replace('#lesson-', '');
      if (hashLesson && panels.some((panel) => panel.dataset.lessonPanel === hashLesson)) {
        openLesson(hashLesson, 'module');
      }
      updateProgress();

      trackFunnelEvent('learn_series_open', {
        series_id: seriesId,
        locale: root.dataset.locale ?? '',
      });
    });
  };

  setupLearnSeries();
  document.addEventListener('astro:page-load', setupLearnSeries);
</script>

<style>
  .learn-series-page {
    background:
      radial-gradient(ellipse 68% 28% at 78% 14%, rgba(103, 217, 255, 0.12), transparent 72%),
      linear-gradient(180deg, #3b4853 0%, #35434e 56%, #243441 76%, #101c27 90%, #070b12 100%);
  }

  .learn-workspace {
    padding: clamp(82px, 6.5vw, 94px) 0 clamp(48px, 6vw, 72px);
  }

  .learn-workspace__layout {
    display: grid;
    grid-template-columns: minmax(260px, 0.34fr) minmax(0, 1fr);
    gap: clamp(38px, 6vw, 84px);
    align-items: start;
  }

  .learn-modules {
    position: sticky;
    top: 94px;
  }

  .learn-modules > .text-mono,
  .learn-related .text-mono {
    color: rgba(103, 217, 255, 0.72);
    font-size: 0.6rem;
  }

  .learn-modules h1 {
    max-width: 15ch;
    margin: 13px 0 26px;
    font-size: clamp(1.55rem, 2.2vw, 2.3rem);
    font-weight: 530;
    letter-spacing: -0.034em;
    line-height: 1.04;
  }

  .learn-progress { margin-bottom: 22px; }
  .learn-progress__meta { display: flex; justify-content: space-between; gap: 18px; margin-bottom: 9px; color: rgba(226, 234, 243, 0.78); font-size: 0.55rem; }
  .learn-progress__track { height: 2px; overflow: hidden; background: rgba(201, 211, 223, 0.16); }
  .learn-progress__track span { display: block; width: 0; height: 100%; background: var(--signal-ice); transition: width 320ms var(--ease-out); }

  .learn-modules ol {
    list-style: none;
    border-top: 1px solid rgba(126, 153, 178, 0.22);
  }

  .learn-modules li {
    border-bottom: 1px solid rgba(126, 153, 178, 0.2);
  }

  .learn-modules button {
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr) auto;
    gap: 7px 11px;
    padding: 14px 12px 14px 0;
    color: rgba(226, 234, 243, 0.82);
    text-align: left;
    transition: color 180ms var(--ease-out), padding-left 180ms var(--ease-out), background 180ms var(--ease-out);
  }

  .learn-modules button[aria-current='step'] {
    padding-left: 10px;
    color: var(--cloud-white);
    background: rgba(5, 18, 29, 0.28);
    box-shadow: inset 0 0 0 1px rgba(103, 217, 255, 0.2);
  }

  .learn-modules__index {
    color: rgba(103, 217, 255, 0.64);
    font-size: 0.56rem;
  }

  .learn-modules__title {
    font-size: 0.84rem;
    line-height: 1.35;
  }

  .learn-modules__current {
    grid-column: 2;
    color: rgba(103, 217, 255, 0.72);
    font-size: 0.52rem;
  }

  .learn-player {
    min-width: 0;
    overflow: clip;
    scroll-margin-top: 84px;
  }

  .learn-player__topbar {
    min-height: 36px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: 12px;
  }

  .learn-player__topbar .link-hover-arrow {
    color: rgba(238, 245, 250, 0.84);
    font-size: 0.82rem;
  }

  .learn-series-page :global(.lesson-card--player .lesson-card__rank),
  .learn-series-page :global(.lesson-card--player .lesson-card__meta) {
    color: rgba(226, 234, 243, 0.72);
  }

  .learn-series-page :global(.lesson-card--player .lesson-card__body > p) {
    color: rgba(238, 245, 250, 0.86);
  }

  .learn-series-page :global(.lesson-card--player .lesson-card__outcome p) {
    color: rgba(244, 247, 251, 0.92);
  }

  .learn-modules__done {
    grid-column: 3;
    grid-row: 1;
    color: rgba(103, 217, 255, 0.82);
    font-size: 0.72rem;
  }

  .learn-player__panel[hidden] {
    display: none;
  }

  .learn-player__controls {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 28px;
    padding-top: 0;
  }

  .learn-player__controls > :last-child {
    justify-self: end;
  }

  .learn-player__controls button {
    color: rgba(226, 234, 243, 0.82);
  }

  .learn-roadmap-cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px 40px;
    align-items: center;
    margin-top: 32px;
    border-radius: 12px;
    padding: clamp(22px, 3vw, 32px);
    background: rgba(5, 15, 24, 0.34);
  }

  .learn-roadmap-cta h2 {
    max-width: 18ch;
    font-size: clamp(1.55rem, 2.4vw, 2.35rem);
    font-weight: 540;
    letter-spacing: -0.03em;
  }

  .learn-roadmap-cta p {
    max-width: 58ch;
    margin-top: 10px;
    color: rgba(226, 234, 243, 0.78);
    font-size: 0.9rem;
  }

  .learn-related {
    padding: clamp(28px, 4vw, 52px) 0 clamp(88px, 10vw, 132px);
  }

  .learn-related__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(300px, 0.65fr);
    gap: clamp(40px, 9vw, 132px);
    align-items: end;
    padding-top: clamp(32px, 4vw, 48px);
  }

  .learn-related h2 {
    margin-top: 10px;
    font-size: clamp(2.3rem, 4.8vw, 5rem);
    font-weight: 520;
    letter-spacing: -0.04em;
  }

  .learn-related p {
    max-width: 48ch;
    margin-bottom: 22px;
    color: rgba(238, 245, 250, 0.86);
    line-height: 1.65;
  }

  @media (hover: hover) and (pointer: fine) {
    .learn-modules button:hover {
      color: var(--cloud-white);
      padding-left: 6px;
    }
  }

  @media (max-width: 920px) {
    .learn-workspace__layout,
    .learn-related__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 34px;
    }

    .learn-modules {
      position: static;
    }

    .learn-player {
      order: -1;
    }

    .learn-modules h1 {
      max-width: none;
    }

    .learn-roadmap-cta {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .learn-player__controls {
      gap: 12px;
    }

    .learn-player__controls button {
      max-width: 15ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .learn-modules button {
      transition: none;
    }
    .learn-progress__track span { transition: none; }
  }
</style>
