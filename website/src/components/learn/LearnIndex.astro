---
import HeroShell from '../shared/HeroShell.astro';
import LearnSeriesCard from './LearnSeriesCard.astro';
import { getLearningSeries, type LearningLocale } from '../../data/learning';

interface Props { locale: LearningLocale; }
const { locale } = Astro.props;
const series = getLearningSeries();

const copy = locale === 'id'
  ? {
      title: 'Belajar untuk Prioritas Anda',
      description: 'Pahami bagaimana search, web, visual, dan social media dapat membantu bisnis Anda.',
      heroAlt: 'Buku terbuka berbentuk sculptural dengan garis cahaya biru di ruang gelap',
      introTitle: 'Mulai dari pertanyaan yang sedang Anda hadapi',
      introBody: 'Pilih course yang paling dekat dengan kondisi bisnis Anda saat ini. Setiap course berisi enam lesson yang membantu Anda memahami masalah, menilai pilihan, dan menentukan next step.',
    }
  : {
      title: 'Learn for Your Priorities',
      description: 'Understand how search, web, visual, and social media could help your business.',
      heroAlt: 'A sculptural open book with an ice-blue edge in a dark space',
      introTitle: 'Start with the question in front of you',
      introBody: 'Choose the course closest to your business today. Each course includes six lessons that help you understand the problem, assess the options, and choose a useful next step.',
    };
---

<div class="learn-page page-flow" data-learn-index data-locale={locale}>
  <HeroShell
    title={copy.title}
    description={copy.description}
    image="/assets/banners/learn-book.png"
    imageAlt={copy.heroAlt}
    label="LEARN"
    variant="insights"
    depth
    focalPoint="68% 55%"
  />

  <section class="learn-directory flow-section" aria-labelledby="learn-directory-title" data-scroll-key="learn-directory">
    <div class="container">
      <header class="learn-directory__header" data-reveal>
        <div>
          <h2 id="learn-directory-title">{copy.introTitle}</h2>
        </div>
        <p>{copy.introBody}</p>
      </header>

    </div>
    {[series.slice(0,2), series.slice(2,4), series.slice(4)].map((group,index) => (
      <div class:list={['learn-course-band', index === 1 && 'light-field']}>
        <div class="container learn-series-grid">
          {group.map(item => <LearnSeriesCard locale={locale} series={item} />)}
        </div>
      </div>
    ))}
  </section>
</div>

<script>
  import { trackFunnelEvent } from '../../scripts/funnel-analytics';

  const setupLearnIndexTracking = () => {
    document.querySelectorAll<HTMLElement>('[data-learn-index]').forEach((root) => {
      if (root.dataset.trackingReady === 'true') return;
      root.dataset.trackingReady = 'true';
      trackFunnelEvent('learn_view', { locale: root.dataset.locale ?? '' });
    });
  };

  setupLearnIndexTracking();
  document.addEventListener('astro:page-load', setupLearnIndexTracking);
</script>

<style>
  .learn-page :global(.hero-shell--insights) {
    background: transparent;
    mask-image: linear-gradient(180deg, #000 0%, #000 58%, rgba(0,0,0,.96) 70%, rgba(0,0,0,.65) 84%, rgba(0,0,0,.24) 94%, transparent 100%);
  }
  .learn-page.learn-page :global(.hero-shell--insights + .learn-directory::before) { display: none; }

  .learn-page :global(.hero-shell__media img) {
    filter: brightness(0.8) saturate(0.86);
  }

  @media (min-width: 900px) {
    .learn-page :global(.hero-shell h1) {
      max-width: none;
      white-space: nowrap;
      font-size: clamp(3.4rem, 5vw, 5.3rem);
    }
  }

  .learn-directory {
    padding: clamp(82px, 9vw, 126px) 0 clamp(96px, 11vw, 150px);
    background: transparent;
  }

  .learn-directory__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.68fr);
    gap: clamp(36px, 8vw, 118px);
    align-items: end;
    margin-bottom: clamp(52px, 7vw, 82px);
  }

  .learn-directory__header .text-mono {
    display: block;
    margin-bottom: 18px;
    color: rgba(103, 217, 255, 0.72);
    font-size: 0.64rem;
  }

  .learn-directory__header h2 {
    max-width: 14ch;
    font-size: clamp(2.4rem, 4vw, 4.55rem);
    font-weight: 530;
    letter-spacing: -0.04em;
    line-height: 0.99;
  }

  .learn-directory__header > p {
    max-width: 50ch;
    color: rgba(226, 234, 243, 0.78);
    line-height: 1.68;
  }

  .learn-series-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(58px, 7vw, 92px) clamp(24px, 4vw, 54px);
  }

  @media (max-width: 780px) {
    .learn-directory__header,
    .learn-series-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .learn-directory__header {
      gap: 26px;
    }

    .learn-series-grid {
      gap: 58px;
    }
  }

  .learn-course-band { padding-block:36px; }
  .learn-course-band.light-field { padding-block:180px; margin-block:30px; }
  .learn-course-band.light-field :global(.learn-series-card h3) { color:#0b2033; }
  .learn-course-band.light-field :global(.learn-series-card p),
  .learn-course-band.light-field :global(.learn-series-card__meta) { color:#294b63; }
  .learn-course-band.light-field :global(.learn-series-card__link) { color:#163e5a; border-color:rgba(18,56,85,.5); }
  .learn-course-band.light-field :global(.learn-series-card__link:hover) { color:#081e31; border-color:#081e31; }
  @media(max-width:780px) { .learn-course-band.light-field::after { background:linear-gradient(180deg,transparent,#bed9e8 12%,#e4f1f7 32%,#aacce3 85%,transparent); } }

</style>
