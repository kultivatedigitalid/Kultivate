---
import HeroShell from '../shared/HeroShell.astro';
import LearnSeriesCard from './LearnSeriesCard.astro';
import { founderIdentity, founderProfilePath } from '../../data/founder';
import { getLearningSeries, type LearningLocale } from '../../data/learning';

interface Props { locale: LearningLocale; }
const { locale } = Astro.props;
const series = getLearningSeries();

const copy = locale === 'id'
  ? {
      title: 'Belajar sebelum menentukan arah',
      description: 'Empat series singkat untuk memahami search, website, dan keputusan yang menghubungkan keduanya.',
      heroAlt: 'Bidang informasi abstrak tersusun dalam kedalaman biru',
      introTitle: 'Materi untuk melihat masalah dengan lebih jernih',
      introBody: 'Mulai dari pertanyaan yang paling dekat dengan kondisi bisnis Anda. Setiap series menyusun dua materi yang saling terhubung agar konteksnya mudah diikuti.',
      directory: 'Empat series',
      teachingTitle: 'Dibuat untuk proses belajar yang tenang',
      teachingBody: 'Materi final akan menggunakan dokumentasi natural saat founder menjelaskan, berdiskusi, dan mengajar. Area ini disiapkan untuk foto tersebut tanpa menggantikannya dengan visual founder palsu.',
      teachingPlaceholder: 'Placeholder foto founder mengajar',
      teachingAlt: 'Placeholder pengembangan untuk foto natural Galdino, Hans saat mengajar',
      founderLink: 'Kenali ' + founderIdentity.name,
      servicesLink: 'Lihat layanan terkait',
    }
  : {
      title: 'Learn before choosing a direction',
      description: 'Four short series for understanding search, websites, and the decisions that connect them.',
      heroAlt: 'Abstract information surfaces arranged in blue depth',
      introTitle: 'Material for seeing the problem more clearly',
      introBody: 'Start with the question closest to your business today. Each series brings two connected lessons together so the context is easy to follow.',
      directory: 'Four series',
      teachingTitle: 'Made for calm, focused learning',
      teachingBody: 'Final materials will use natural documentation of the founder explaining, discussing, and teaching. This space is prepared for those images without substituting fake founder visuals.',
      teachingPlaceholder: 'Founder teaching photo placeholder',
      teachingAlt: 'Development placeholder for a natural teaching photo of Galdino, Hans',
      founderLink: 'Meet ' + founderIdentity.name,
      servicesLink: 'View related services',
    };
---

<div class="learn-page page-flow" data-learn-index data-locale={locale}>
  <HeroShell
    title={copy.title}
    description={copy.description}
    image="/assets/banners/insights-gradient.webp"
    imageAlt={copy.heroAlt}
    label="LEARN"
    variant="insights"
    depth
    focalPoint="56% 50%"
  />

  <section class="learn-directory flow-section" aria-labelledby="learn-directory-title" data-scroll-key="learn-directory">
    <div class="container">
      <header class="learn-directory__header" data-reveal>
        <div>
          <span class="text-mono">{copy.directory}</span>
          <h2 id="learn-directory-title">{copy.introTitle}</h2>
        </div>
        <p>{copy.introBody}</p>
      </header>

      <div class="learn-series-grid">
        {series.map((item, index) => (
          <LearnSeriesCard locale={locale} series={item} />
        ))}
      </div>
    </div>
  </section>

  <section class="learn-teaching flow-section" aria-labelledby="learn-teaching-title">
    <div class="container learn-teaching__layout">
      <div class="learn-teaching__placeholder" role="img" aria-label={copy.teachingAlt} data-reveal="image">
        <span aria-hidden="true"></span>
        <span class="text-mono">{copy.teachingPlaceholder}</span>
      </div>

      <div class="learn-teaching__copy" data-reveal>
        <h2 id="learn-teaching-title">{copy.teachingTitle}</h2>
        <p>{copy.teachingBody}</p>
        <div class="learn-teaching__links">
          <a class="link-hover-arrow" href={founderProfilePath(locale)}>
            <span>{copy.founderLink}</span><span aria-hidden="true">&#8594;</span>
          </a>
          <a class="link-hover-arrow" href={'/' + locale + '/services/'}>
            <span>{copy.servicesLink}</span><span aria-hidden="true">&#8594;</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  import { trackFunnelEvent } from '../../scripts/funnel-analytics';

  const setupLearnIndexTracking = () => {
    document.querySelectorAll<HTMLElement>('[data-learn-index]').forEach((root) => {
      if (root.dataset.trackingReady === 'true') return;
      root.dataset.trackingReady = 'true';
      trackFunnelEvent('learn_view', { locale: root.dataset.locale ?? '' });
    });
  };

  setupLearnIndexTracking();
  document.addEventListener('astro:page-load', setupLearnIndexTracking);
</script>

<style>
  .learn-directory {
    padding: clamp(90px, 10vw, 146px) 0 clamp(104px, 12vw, 168px);
    background: transparent;
  }

  .learn-directory__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.68fr);
    gap: clamp(36px, 8vw, 118px);
    align-items: end;
    margin-bottom: clamp(64px, 8vw, 102px);
  }

  .learn-directory__header .text-mono {
    display: block;
    margin-bottom: 18px;
    color: rgba(103, 217, 255, 0.7);
    font-size: 0.64rem;
  }

  .learn-directory__header h2 {
    max-width: 15ch;
    font-size: clamp(2.5rem, 4.2vw, 4.8rem);
    font-weight: 530;
    letter-spacing: -0.038em;
    line-height: 0.98;
  }

  .learn-directory__header > p {
    max-width: 50ch;
    color: rgba(226, 234, 243, 0.76);
    line-height: 1.7;
  }

  .learn-series-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(72px, 9vw, 124px) clamp(24px, 4vw, 54px);
  }

  .learn-teaching {
    padding: clamp(76px, 9vw, 128px) 0 clamp(104px, 12vw, 164px);
    background: transparent;
  }

  .learn-teaching__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(300px, 0.88fr);
    gap: clamp(40px, 8vw, 112px);
    align-items: center;
  }

  .learn-teaching__placeholder {
    aspect-ratio: 16 / 10;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 18px;
    border-radius: 8px;
    padding: 28px;
    color: rgba(226, 234, 243, 0.6);
    text-align: center;
    background:
      radial-gradient(ellipse 42% 58% at 48% 42%, rgba(103, 217, 255, 0.12), transparent 72%),
      linear-gradient(145deg, rgba(16, 42, 62, 0.94), rgba(5, 12, 20, 0.99));
  }

  .learn-teaching__placeholder > span:first-child {
    width: clamp(76px, 10vw, 126px);
    height: 1px;
    background: rgba(103, 217, 255, 0.66);
  }

  .learn-teaching__placeholder .text-mono {
    max-width: 28ch;
    font-size: 0.62rem;
    line-height: 1.5;
  }

  .learn-teaching__copy h2 {
    max-width: 14ch;
    margin-bottom: 20px;
    font-size: clamp(2.2rem, 3.5vw, 4rem);
    font-weight: 530;
    letter-spacing: -0.038em;
    line-height: 1;
  }

  .learn-teaching__copy p {
    max-width: 50ch;
    color: rgba(226, 234, 243, 0.74);
    line-height: 1.68;
  }

  .learn-teaching__links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
    margin-top: 28px;
  }

  @media (max-width: 820px) {
    .learn-directory__header,
    .learn-teaching__layout {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .learn-series-grid {
      grid-template-columns: 1fr;
      gap: 72px;
    }

    .learn-teaching__copy { max-width: 620px; }
  }
</style>
