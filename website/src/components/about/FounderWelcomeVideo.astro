---
import { founderIdentity, founderProfilePath } from '../../data/founder';

interface Props {
  locale: 'id' | 'en';
  videoSrc?: string;
  poster?: string;
  captionsSrc?: string;
}

const {
  locale,
  videoSrc = '',
  poster = '',
  captionsSrc = '',
} = Astro.props;

const copy = locale === 'id'
  ? {
      title: 'Melihat cara kami bekerja dari dekat',
      body: 'Ruang ini mempertemukan penjelasan langsung, proses mengajar, dan potongan suasana kerja founder—agar Anda dapat memahami bukan hanya apa yang Kultivate kerjakan, tetapi bagaimana sebuah keputusan dibentuk.',
      support: 'Video akan dibuat dengan ritme natural, minim distraksi, dan fokus pada proses berpikir di balik pekerjaan.',
      placeholder: 'Visual film founder Kultivate',
      placeholderLabel: 'Founder film',
      cta: 'Kenali founder kami',
      captions: 'Subtitle Bahasa Indonesia',
    }
  : {
      title: 'A closer look at how we work',
      body: 'This space brings together direct explanations, teaching moments, and the founder’s working environment—so you can understand not only what Kultivate does, but how a decision takes shape.',
      support: 'The film will use a natural, minimally edited rhythm that keeps the thinking behind the work in focus.',
      placeholder: 'Kultivate founder film visual',
      placeholderLabel: 'Founder film',
      cta: 'Get to know our founder',
      captions: 'English captions',
    };
---

<section id="founder-welcome" class="founder-welcome flow-section" aria-labelledby="founder-welcome-title" data-scroll-key="about-founder-welcome">
  <div class="container founder-welcome__layout">
    <div class="founder-welcome__media" data-reveal="image">
      {videoSrc ? (
        <video
          controls
          preload="metadata"
          playsinline
          poster={poster || undefined}
          aria-label={copy.title}
        >
          <source src={videoSrc} />
          {captionsSrc && (
            <track
              kind="captions"
              src={captionsSrc}
              srclang={locale}
              label={copy.captions}
              default
            />
          )}
        </video>
      ) : (
        <div class="founder-welcome__placeholder" role="img" aria-label={copy.placeholder}>
          <span class="founder-welcome__signal" aria-hidden="true"><i></i></span>
          <span class="text-mono">{copy.placeholderLabel}</span>
        </div>
      )}
    </div>

    <div class="founder-welcome__content" data-reveal>
      <header class="founder-welcome__intro">
        <h2 id="founder-welcome-title">{copy.title}</h2>
        <p>{copy.body}</p>
        <p class="founder-welcome__support">{copy.support}</p>
      </header>

      <footer class="founder-welcome__footer">
        <div>
          <strong>{founderIdentity.name}</strong>
          <span class="text-mono">{founderIdentity.role}</span>
        </div>
        <a class="link-hover-arrow" href={founderProfilePath(locale)} data-about-founder-profile>
          <span>{copy.cta}</span><span aria-hidden="true">&#8594;</span>
        </a>
      </footer>
    </div>
  </div>
</section>

<script>
  import { trackFunnelEvent } from '../../scripts/funnel-analytics';

  const setupFounderWelcomeTracking = () => {
    document.querySelectorAll<HTMLElement>('[data-about-founder-profile]').forEach((link) => {
      if (link.dataset.trackingReady === 'true') return;
      link.dataset.trackingReady = 'true';
      link.addEventListener('click', () => trackFunnelEvent('about_founder_profile_click'));
    });
  };

  setupFounderWelcomeTracking();
  document.addEventListener('astro:page-load', setupFounderWelcomeTracking);
</script>

<style>
  .founder-welcome {
    display: grid;
    align-items: center;
    min-height: clamp(620px, 82svh, 820px);
    padding: clamp(58px, 7vw, 88px) 0;
    background: transparent;
  }

  .founder-welcome__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.76fr);
    gap: clamp(44px, 7vw, 104px);
    align-items: center;
  }

  .founder-welcome__media {
    position: relative;
    width: min(100%, 660px);
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 8px;
    background: #07101a;
  }

  .founder-welcome__media video,
  .founder-welcome__placeholder {
    width: 100%;
    height: 100%;
  }

  .founder-welcome__media video {
    display: block;
    object-fit: cover;
    background: #05080e;
  }

  .founder-welcome__placeholder {
    position: relative;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 20px;
    padding: 28px;
    color: rgba(226, 234, 243, 0.66);
    text-align: center;
    background:
      radial-gradient(ellipse 46% 58% at 50% 48%, rgba(103, 217, 255, 0.13), transparent 72%),
      linear-gradient(145deg, rgba(15, 38, 57, 0.94), rgba(5, 12, 20, 0.99));
  }

  .founder-welcome__placeholder::after {
    content: '';
    position: absolute;
    inset: 9%;
    border: 1px solid rgba(207, 247, 255, 0.09);
    border-radius: 4px;
  }

  .founder-welcome__signal {
    position: relative;
    z-index: 1;
    width: 64px;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border: 1px solid rgba(207, 247, 255, 0.38);
    border-radius: 50%;
    background: rgba(7, 16, 26, 0.42);
  }

  .founder-welcome__signal i {
    width: 0;
    height: 0;
    margin-left: 4px;
    border-block: 7px solid transparent;
    border-left: 11px solid rgba(226, 244, 252, 0.86);
  }

  .founder-welcome__placeholder .text-mono {
    position: relative;
    z-index: 1;
    font-size: 0.62rem;
  }

  .founder-welcome__content {
    display: grid;
    align-content: center;
    gap: clamp(40px, 6vw, 68px);
  }

  .founder-welcome__intro h2 {
    max-width: 11ch;
    font-size: clamp(2.35rem, 3.7vw, 4.35rem);
    font-weight: 530;
    letter-spacing: -0.04em;
    line-height: 0.98;
  }

  .founder-welcome__intro p {
    max-width: 49ch;
    margin-top: 24px;
    color: rgba(226, 234, 243, 0.76);
    line-height: 1.68;
  }

  .founder-welcome__intro .founder-welcome__support {
    margin-top: 14px;
    color: rgba(201, 211, 223, 0.58);
    font-size: 0.9rem;
  }

  .founder-welcome__footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 26px;
    border-top: 1px solid rgba(89, 106, 130, 0.34);
    padding-top: 22px;
  }

  .founder-welcome__footer > div {
    display: grid;
    gap: 5px;
  }

  .founder-welcome__footer strong {
    font-size: 1.05rem;
    font-weight: 560;
  }

  .founder-welcome__footer .text-mono {
    color: rgba(201, 211, 223, 0.56);
    font-size: 0.6rem;
  }

  @media (max-width: 900px) {
    .founder-welcome {
      min-height: 0;
    }

    .founder-welcome__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 38px;
    }

    .founder-welcome__media {
      width: min(100%, 620px);
    }

    .founder-welcome__content {
      max-width: 680px;
    }
  }

  @media (max-width: 600px) {
    .founder-welcome {
      padding: 46px 0;
    }

    .founder-welcome__layout {
      gap: 30px;
    }

    .founder-welcome__media {
      aspect-ratio: 5 / 4;
    }

    .founder-welcome__content {
      gap: 30px;
    }

    .founder-welcome__support {
      display: none;
    }

    .founder-welcome__footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 16px;
    }
  }
</style>
