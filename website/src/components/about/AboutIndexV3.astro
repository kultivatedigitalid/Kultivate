---
import HeroShell from '../shared/HeroShell.astro';
import AboutOrbit3D from './AboutOrbit3D.astro';

interface Props { locale: 'id' | 'en'; }

const { locale } = Astro.props;
const copy = locale === 'id'
  ? {
      title: 'SEO Agency untuk Prioritas Anda',
      description: 'Kami mulai dari apa yang dibutuhkan bisnis Anda untuk tumbuh.',
      heroAlt: 'Lima bentuk berbeda yang berkumpul mengitari satu pusat biru',
      cultureTitle: 'Kami percaya digital seharusnya terasa lebih terarah',
      cultureBody: 'Kultivate dibangun untuk menyatukan cara bisnis dipahami, ditemukan, dan digunakan ke dalam satu arah yang mudah dijalankan. Kami bekerja dekat dengan owner dan tim internal, mendengarkan konteksnya, mempertanyakan hal yang belum jelas, lalu mengubahnya menjadi keputusan yang dapat dipahami bersama.',
      cultureLabel: 'Kolase ilustrasi editorial tentang proses kerja Kultivate',
      partnershipTitle: 'Dibangun untuk tetap berguna',
      partnershipBody: 'Hasil yang baik seharusnya tetap masuk akal bagi tim Anda, berguna dalam pekerjaan sehari-hari, dan bisa berkembang bersama bisnis. Nilainya tidak seharusnya berhenti saat handover.',
      partnershipLabel: 'Hal yang Kultivate tinggalkan bersama setiap pekerjaan',
      partnershipClosing: 'Kami ingin tim Anda pulang dengan lebih dari sebuah deliverable. Anda juga membawa konteks, keyakinan, dan kemampuan untuk mengambil langkah berikutnya.',
      promises: [
        ['Pahami alasannya', 'Alasan di balik setiap struktur, prioritas, dan rekomendasi dibuat jelas, agar keputusan tidak terasa seperti instruksi dari agency.'],
        ['Gunakan setiap hari', 'Website, content, dan sistem kerja disusun mengikuti kapasitas nyata tim Anda, bukan sekadar terlihat sempurna saat presentasi.'],
        ['Terus bergerak', 'Konteks dan prioritas tetap bersama tim Anda, sehingga langkah berikutnya tidak perlu dimulai lagi dari nol.']
      ],
      teamTitle: 'Peran yang menjaga pekerjaan tetap utuh',
      teamNote: 'Delivery roles',
      teamIntro: 'Orang yang terlibat menyesuaikan kebutuhan proyek. Empat tanggung jawab ini tetap memiliki owner yang jelas dari discovery sampai review.'
    }
  : {
      title: 'SEO Agency for Your Priorities',
      description: 'We start with what your business needs to grow.',
      heroAlt: 'Five distinct forms gathered around one blue center',
      cultureTitle: 'We believe digital should feel more directed',
      cultureBody: 'Kultivate was built to bring the way a business is understood, found, and used into one direction people can act on. We work closely with owners and in-house teams, listen to the context, question what is unclear, and turn it into decisions people can understand together.',
      cultureLabel: 'A collage of editorial illustrations about the Kultivate working process',
      partnershipTitle: 'Built to stay useful',
      partnershipBody: 'A good outcome should make sense to your team, work in the day to day, and grow with the business. Its value should not stop at handover.',
      partnershipLabel: 'What Kultivate leaves behind with every engagement',
      partnershipClosing: 'We want your team to leave with more than a deliverable. You should also have the context, confidence, and ability to take the next step.',
      promises: [
        ['Know the why', 'Clear reasoning sits behind every structure, priority, and recommendation, so decisions never feel like agency instructions.'],
        ['Use it every day', 'Websites, content, and working systems are shaped around your team’s real capacity, not presentation-day perfection.'],
        ['Keep moving', 'Clear context and priorities stay with your team, so the next step never needs to start from zero.']
      ],
      teamTitle: 'The roles that keep the work connected',
      teamNote: 'Delivery roles',
      teamIntro: 'The people involved follow the needs of the engagement. These four responsibilities keep a clear owner from discovery through review.'
    };

const collageImages = [
  ['/assets/about/collage/collage-01.webp', 'Tim meninjau strategi website bersama', 'A team reviewing website strategy together'],
  ['/assets/about/collage/collage-02.webp', 'Pemilik bisnis dan strategist membahas pengalaman pencarian', 'A business owner and strategist discussing search discovery'],
  ['/assets/about/collage/collage-03.webp', 'Workshop customer journey dan prioritas bisnis', 'A workshop mapping customer journeys and business priorities'],
  ['/assets/about/collage/collage-04.webp', 'Tim digital menyatukan website, SEO, dan content', 'A digital team connecting website, SEO, and content work'],
  ['/assets/about/collage/collage-05.webp', 'Technical specialist mengaudit fondasi website', 'A technical specialist auditing a website foundation'],
  ['/assets/about/collage/collage-06.webp', 'Strategist dan writer menyusun arah content', 'A strategist and writer shaping content direction'],
  ['/assets/about/collage/collage-07.webp', 'Designer dan developer meninjau prototype responsif', 'A designer and developer reviewing a responsive prototype'],
  ['/assets/about/collage/collage-08.webp', 'Tim membaca hasil measurement bersama', 'A team reviewing measurement results together'],
  ['/assets/about/collage/collage-09.webp', 'Percakapan discovery bersama pemilik bisnis', 'A discovery conversation with a business owner'],
  ['/assets/about/collage/collage-10.webp', 'Pengujian pengalaman website di tablet dan ponsel', 'Testing a website experience on tablet and mobile'],
  ['/assets/about/collage/collage-11.webp', 'Riset authority dari beberapa sumber tepercaya', 'Authority research across credible sources'],
  ['/assets/about/collage/collage-12.webp', 'Tim melakukan quality review sebelum launch', 'A team running a pre-launch quality review']
];

const marqueeRows = [collageImages.slice(0, 6), collageImages.slice(6)].map((row) => [
  ...row.map((item) => ({ item, duplicate: false })),
  ...row.map((item) => ({ item, duplicate: true }))
]);

const deliveryRoles = locale === 'id'
  ? [
      ['Strategy & discovery', 'Menerjemahkan tujuan, audiens, batasan, dan economics bisnis menjadi prioritas yang dapat diuji.', 'Terlibat pada framing masalah, scope, dan keputusan utama.'],
      ['Technical delivery', 'Menjaga implementasi, performa, accessibility, search readiness, dan acceptance criteria.', 'Terlibat dari feasibility sampai QA dan handover.'],
      ['Content & authority', 'Menyusun informasi agar berguna bagi pelanggan, konsisten dengan expertise, dan mudah dipelihara.', 'Terlibat pada research, structure, evidence, dan editorial review.'],
      ['Project stewardship', 'Menjaga ownership, checkpoint, dependensi, dan catatan keputusan tetap jelas bagi semua pihak.', 'Terlibat sepanjang ritme komunikasi dan review.']
    ]
  : [
      ['Strategy & discovery', 'Turns goals, audience, constraints, and business economics into priorities the team can test.', 'Involved in problem framing, scope, and major decisions.'],
      ['Technical delivery', 'Owns implementation quality, performance, accessibility, search readiness, and acceptance criteria.', 'Involved from feasibility through QA and handover.'],
      ['Content & authority', 'Shapes information to help customers, reflect expertise, and remain maintainable.', 'Involved in research, structure, evidence, and editorial review.'],
      ['Project stewardship', 'Keeps ownership, checkpoints, dependencies, and decision records clear for everyone.', 'Involved throughout communication and review.']
    ];
---

<div class="about-page page-flow">
  <HeroShell
    title={copy.title}
    description={copy.description}
    image="/assets/banners/about-gradient.webp"
    imageAlt={copy.heroAlt}
    variant="about"
  />

  <section class="about-culture flow-section" aria-labelledby="culture-title" data-scroll-key="about-culture">
    <div class="container culture-copy" data-reveal>
      <h2 id="culture-title">{copy.cultureTitle}</h2>
      <p>{copy.cultureBody}</p>
    </div>

    <div class="culture-collage" role="group" aria-label={copy.cultureLabel} data-reveal="image">
      {marqueeRows.map((items, rowIndex) => (
        <div class:list={['collage-row', rowIndex === 0 ? 'collage-row--top' : 'collage-row--bottom']}>
          <ul class="collage-track">
            {items.map(({ item, duplicate }) => (
              <li class="collage-item" tabindex={duplicate ? -1 : 0} aria-hidden={duplicate ? 'true' : undefined}>
                <figure>
                  <img
                    src={item[0]}
                    alt={duplicate ? '' : (locale === 'id' ? 'Ilustrasi editorial: ' + item[1] : 'Editorial illustration: ' + item[2])}
                    width="1280"
                    height="853"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <AboutOrbit3D locale={locale} />

  <section class="about-partnership flow-section" aria-label={copy.partnershipLabel} data-scroll-key="about-partnership">
    <div class="container partnership-intro" data-reveal>
      <h2>{copy.partnershipTitle}</h2>
      <p class="partnership-statement">{copy.partnershipClosing}</p>
      <p class="partnership-context">{copy.partnershipBody}</p>
    </div>
    <div class="container partnership-promises">
      {copy.promises.map(([title, description], index) => (
        <article data-reveal style={`--reveal-delay: ${index * 70}ms`}>
          <h3>{title}</h3>
          <p>{description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="team-section flow-section" aria-labelledby="team-title" data-scroll-key="about-team">
    <div class="container team-heading" data-reveal>
      <div>
        <h2 id="team-title">{copy.teamTitle}</h2>
        <p>{copy.teamIntro}</p>
      </div>
      <span class="text-mono">{copy.teamNote}</span>
    </div>
    <div class="container team-grid">
      {deliveryRoles.map(([role, responsibility, involvement], index) => (
        <article class="delivery-role" data-reveal style={{ '--reveal-delay': (index * 70) + 'ms' }}>
          <span class="role-index text-mono">0{index + 1}</span>
          <div>
            <h3>{role}</h3>
            <p>{responsibility}</p>
            <small>{involvement}</small>
          </div>
        </article>
      ))}
    </div>
  </section>
</div>


<style>
  .about-culture {
    margin-top: -1px;
    padding: clamp(82px, 9vw, 132px) 0 clamp(42px, 5vw, 74px);
    background: transparent;
  }

  .culture-copy {
    display: grid;
    grid-template-columns: minmax(260px, 0.76fr) minmax(320px, 1.24fr);
    gap: clamp(36px, 8vw, 132px);
    align-items: end;
  }

  .culture-copy h2 {
    max-width: 14ch;
    font-size: clamp(2.2rem, 3.5vw, 4.2rem);
    font-weight: 540;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .culture-copy p {
    max-width: 52ch;
    color: rgba(226, 234, 243, 0.78);
    font-size: clamp(1rem, 1.18vw, 1.12rem);
    line-height: 1.72;
    text-wrap: pretty;
  }

  .culture-collage {
    --collage-gap: clamp(16px, 1.7vw, 26px);
    display: grid;
    gap: clamp(4px, 0.7vw, 10px);
    width: min(100%, 1720px);
    margin: clamp(48px, 7vw, 92px) auto 0;
    padding-inline: clamp(14px, 2vw, 32px);
  }

  .collage-row {
    overflow: visible;
    padding-block: clamp(16px, 2vw, 28px);
  }

  .collage-track {
    display: flex;
    width: max-content;
    gap: var(--collage-gap);
    list-style: none;
    will-change: transform;
  }

  .collage-row--top .collage-track { animation: collage-right 62s linear infinite; }
  .collage-row--bottom .collage-track { animation: collage-left 68s linear infinite; }

  .collage-item {
    position: relative;
    z-index: 0;
    flex: 0 0 clamp(232px, 22vw, 354px);
    outline: none;
    transform: translate3d(0, 0, 0) scale(1);
    transition: transform 880ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .collage-item figure {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 8px;
    background: #07101a;
  }

  .collage-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) brightness(0.74) contrast(1.05);
    transform: scale(1.045);
    transition: transform 880ms cubic-bezier(0.16, 1, 0.3, 1), filter 420ms var(--ease-out);
  }

  @keyframes collage-left {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(calc(-50% - var(--collage-gap) / 2), 0, 0); }
  }

  @keyframes collage-right {
    from { transform: translate3d(calc(-50% - var(--collage-gap) / 2), 0, 0); }
    to { transform: translate3d(0, 0, 0); }
  }

  .about-partnership {
    padding: clamp(48px, 5vw, 72px) 0 clamp(72px, 8vw, 112px);
    background: transparent;
  }

  .partnership-intro {
    text-align: center;
  }

  .partnership-intro h2 {
    margin-bottom: clamp(26px, 3vw, 42px);
    color: rgba(226, 234, 243, 0.72);
    font-size: clamp(1rem, 1.2vw, 1.16rem);
    font-weight: 580;
    letter-spacing: -0.01em;
    line-height: 1.3;
    text-wrap: balance;
  }

  .partnership-statement {
    max-width: 31ch;
    margin-inline: auto;
    color: var(--cloud-white);
    font-size: clamp(2rem, 3.9vw, 4.35rem);
    font-weight: 510;
    letter-spacing: -0.038em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .partnership-context {
    max-width: 59ch;
    margin: clamp(30px, 4vw, 52px) auto 0;
    color: rgba(226, 234, 243, 0.76);
    font-size: clamp(1rem, 1.16vw, 1.12rem);
    line-height: 1.72;
    text-wrap: pretty;
  }

  .partnership-promises {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(40px, 7vw, 96px);
    margin-top: clamp(72px, 8vw, 112px);
  }

  .partnership-promises article {
    min-width: 0;
  }

  .partnership-promises h3 {
    max-width: 18ch;
    margin-bottom: 16px;
    font-size: clamp(1.2rem, 1.75vw, 1.62rem);
    font-weight: 580;
    letter-spacing: -0.025em;
    line-height: 1.16;
    text-wrap: balance;
  }

  .partnership-promises p {
    max-width: 38ch;
    color: rgba(226, 234, 243, 0.74);
    line-height: 1.66;
    text-wrap: pretty;
  }
  .team-section { padding-block: clamp(96px, 11vw, 160px); background: transparent; }
  .team-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 36px; margin-bottom: 42px; }
  .team-heading > div { max-width: 820px; }
  .team-heading h2 { max-width: 14ch; font-size: clamp(2.5rem, 4.5vw, 5rem); font-weight: 520; letter-spacing: -0.04em; line-height: 0.98; }
  .team-heading p { max-width: 52ch; margin-top: 22px; color: var(--steel); line-height: 1.66; }
  .team-heading > span { flex: none; color: rgba(201, 211, 223, 0.52); }
  .team-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid rgba(89, 106, 130, 0.34); }
  .delivery-role { min-width: 0; display: grid; grid-template-columns: 52px minmax(0, 1fr); gap: 18px; padding: clamp(30px, 4vw, 48px); border-bottom: 1px solid rgba(89, 106, 130, 0.34); }
  .delivery-role:nth-child(odd) { border-right: 1px solid rgba(89, 106, 130, 0.34); }
  .role-index { padding-top: 4px; color: rgba(201, 211, 223, 0.46); }
  .delivery-role h3 { margin-bottom: 13px; font-size: clamp(1.25rem, 1.9vw, 1.72rem); font-weight: 570; letter-spacing: -0.025em; }
  .delivery-role p { max-width: 45ch; color: rgba(226, 234, 243, 0.76); line-height: 1.62; }
  .delivery-role small { display: block; max-width: 47ch; margin-top: 18px; color: var(--steel); font-size: 0.78rem; line-height: 1.52; }
  @media (hover: hover) and (pointer: fine) {
    .collage-row:hover .collage-track,
    .collage-row:focus-within .collage-track { animation-play-state: paused; }

    .collage-row--top .collage-item:hover,
    .collage-row--top .collage-item:focus-visible { z-index: 2; transform: translate3d(0, -14px, 0) scale(1.075); }

    .collage-row--bottom .collage-item:hover,
    .collage-row--bottom .collage-item:focus-visible { z-index: 2; transform: translate3d(0, 14px, 0) scale(1.075); }

    .collage-item:hover img,
    .collage-item:focus-visible img { filter: grayscale(0) brightness(0.98) saturate(1.03); transform: scale(1.018); }
    .collage-item:focus-visible figure { outline: 2px solid var(--signal-ice); outline-offset: 3px; }

  }

  @media (max-width: 1000px) {
    .culture-copy { grid-template-columns: 1fr; gap: 22px; }
    .culture-copy p { max-width: 58ch; }
    .partnership-statement { max-width: 29ch; }
    .team-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 760px) {
    .culture-collage { --collage-gap: 16px; padding-inline: 12px; }
    .collage-row { padding-block: 14px; }
    .collage-item { flex-basis: min(70vw, 270px); }
    .partnership-statement { max-width: 24ch; }
    .partnership-promises { grid-template-columns: 1fr; gap: 36px; }
    .partnership-promises h3 { margin-bottom: 10px; }
    .team-heading { align-items: flex-start; flex-direction: column; }
    .team-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 440px) { .team-grid { grid-template-columns: 1fr; } .delivery-role:nth-child(odd) { border-right: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .collage-track { animation: none; transform: none; }
    .collage-item,
    .collage-item img { transition: none; }
    .collage-item { transform: none; }
  }
</style>
