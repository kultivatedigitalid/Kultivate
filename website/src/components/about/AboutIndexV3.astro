---
import HeroShell from '../shared/HeroShell.astro';

interface Props { locale: 'id' | 'en'; }

const { locale } = Astro.props;
const copy = locale === 'id'
  ? {
      title: 'SEO Agency yang Memprioritaskan Kebutuhan Anda',
      description: 'Kami mulai dari apa yang dibutuhkan bisnis Anda untuk tumbuh.',
      heroAlt: 'Lima bentuk berbeda yang berkumpul mengitari satu pusat biru',
      cultureTitle: 'Kami bekerja sebagai satu tim untuk prioritas Anda',
      cultureBody: 'Strategi, technical SEO, content, authority, dan measurement kami bawa ke dalam satu percakapan. Dengan begitu, setiap rekomendasi tetap dekat dengan konteks bisnis Anda dan lebih mudah dijalankan bersama tim.',
      cultureAlt: 'Lima profesional Indonesia meninjau riset bersama di ruang kerja',
      journeyTitle: 'Arah yang jelas, dibangun bersama Anda',
      journeyBody: 'Kami tidak memulai dari paket yang sama untuk semua bisnis. Kami mendengarkan, menyepakati prioritas, mengerjakan yang paling berarti, lalu menentukan langkah berikutnya bersama Anda.',
      journeyLabel: 'Cara Kultivate bekerja bersama tim Anda',
      steps: [
        ['Kami mendengarkan sebelum merekomendasikan', 'Kami memahami apa yang Anda tawarkan, siapa yang ingin dijangkau, dan apa yang saat ini menghambat pertumbuhan.'],
        ['Kami menyepakati yang paling penting', 'Kami membantu Anda memilih prioritas yang paling relevan dengan tujuan, kapasitas, dan momentum bisnis Anda.'],
        ['Kami tetap dekat dengan pekerjaan', 'Tim yang menyusun arah tetap terlibat saat halaman, konten, dan perbaikan teknis dikerjakan.'],
        ['Kami meninjau dan bergerak maju', 'Kami membahas hasilnya bersama Anda, menjelaskan apa yang berubah, dan menyepakati langkah yang paling berguna berikutnya.']
      ],
      teamTitle: 'Orang-orang di balik pekerjaan kami',
      teamNote: 'Tim inti'
    }
  : {
      title: 'An SEO Agency That Prioritize Your Needs',
      description: 'We start with what your business needs to grow.',
      heroAlt: 'Five distinct forms gathered around one blue center',
      cultureTitle: 'We work as one team around your priorities',
      cultureBody: 'We bring strategy, technical SEO, content, authority, and measurement into one conversation. That keeps every recommendation close to your business context and easier to carry forward with your team.',
      cultureAlt: 'Five Indonesian professionals reviewing research together in a workspace',
      journeyTitle: 'A clear path, built with you',
      journeyBody: 'We do not begin with the same package for every business. We listen, agree on priorities, stay close to the work, and decide the next useful move with you.',
      journeyLabel: 'How Kultivate works with your team',
      steps: [
        ['We listen before we prescribe', 'We learn what you offer, who you need to reach, and what is currently getting in the way of growth.'],
        ['We agree on what matters first', 'Together, we choose the priorities that best fit your goals, capacity, and current business momentum.'],
        ['We stay close to the work', 'The people shaping the direction remain involved as pages, content, and technical improvements are carried out.'],
        ['We review and move forward', 'We discuss the outcome with you, explain what changed, and agree on the next move that will be most useful.']
      ],
      teamTitle: 'The people behind the work',
      teamNote: 'Core team'
    };

const team = locale === 'id'
  ? [
      ['Mira Santoso', 'Strategi & Riset SEO', '/assets/team/mira-santoso.webp'],
      ['Raka Pratama', 'Technical SEO', '/assets/team/raka-pratama.webp'],
      ['Ayu Mahendra', 'Content & On-Page', '/assets/team/ayu-mahendra.webp'],
      ['Dimas Wirawan', 'Authority & Outreach', '/assets/team/dimas-wirawan.webp'],
      ['Nadia Putri', 'Measurement & Growth', '/assets/team/nadia-putri.webp']
    ]
  : [
      ['Mira Santoso', 'SEO Strategy & Research', '/assets/team/mira-santoso.webp'],
      ['Raka Pratama', 'Technical SEO', '/assets/team/raka-pratama.webp'],
      ['Ayu Mahendra', 'Content & On-Page', '/assets/team/ayu-mahendra.webp'],
      ['Dimas Wirawan', 'Authority & Outreach', '/assets/team/dimas-wirawan.webp'],
      ['Nadia Putri', 'Measurement & Growth', '/assets/team/nadia-putri.webp']
    ];
---

<HeroShell
  title={copy.title}
  description={copy.description}
  image="/assets/banners/about-minimal.webp"
  imageAlt={copy.heroAlt}
  variant="about"
/>

<section class="about-culture flow-section" aria-labelledby="culture-title" data-scroll-key="about-culture">
  <div class="container culture-layout">
    <figure data-reveal="image">
      <img src="/assets/about/culture-v3.webp" alt={copy.cultureAlt} width="1920" height="1080" loading="lazy" decoding="async" />
    </figure>
    <div class="culture-copy" data-reveal>
      <h2 id="culture-title">{copy.cultureTitle}</h2>
      <p>{copy.cultureBody}</p>
    </div>
  </div>
</section>

<section class="about-journey flow-section" aria-label={copy.journeyLabel} data-scroll-key="about-journey" data-about-journey>
  <div class="container journey-layout">
    <div class="journey-intro" data-reveal>
      <h2>{copy.journeyTitle}</h2>
      <p>{copy.journeyBody}</p>
      <div class="journey-progress" aria-hidden="true"><span></span></div>
    </div>
    <div class="journey-steps">
      {copy.steps.map(([title, description], index) => (
        <article data-about-step={index} data-reveal>
          <span class="journey-index text-mono">0{index + 1}</span>
          <div><h3>{title}</h3><p>{description}</p></div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="team-section flow-section" aria-labelledby="team-title" data-scroll-key="about-team">
  <div class="container team-heading" data-reveal>
    <h2 id="team-title">{copy.teamTitle}</h2>
    <span class="text-mono">{copy.teamNote}</span>
  </div>
  <div class="container team-grid">
    {team.map(([name, role, image], index) => (
      <article class="person" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
        <figure><img src={image} alt={(locale === 'id' ? 'Foto profil — ' : 'Profile portrait — ') + name} width="1120" height="1400" loading="lazy" decoding="async" /></figure>
        <div><h3>{name}</h3><p>{role}</p></div>
      </article>
    ))}
  </div>
</section>

<script>
  const setupAboutJourney = () => {
    document.querySelectorAll<HTMLElement>('[data-about-journey]').forEach((root) => {
      if (root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';
      const steps = Array.from(root.querySelectorAll<HTMLElement>('[data-about-step]'));
      if (!steps.length) return;

      const activate = (step: HTMLElement) => {
        const index = Number(step.dataset.aboutStep ?? 0);
        steps.forEach((item, itemIndex) => {
          if (itemIndex === index) item.setAttribute('aria-current', 'step');
          else item.removeAttribute('aria-current');
        });
        root.style.setProperty('--about-progress', `${((index + 1) / steps.length) * 100}%`);
      };

      if (!('IntersectionObserver' in window)) {
        activate(steps[0]);
        return;
      }

      const observer = new IntersectionObserver((entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible?.target instanceof HTMLElement) activate(visible.target);
      }, { rootMargin: '-24% 0px -54%', threshold: [0.18, 0.45, 0.72] });

      steps.forEach((step) => observer.observe(step));
      activate(steps[0]);
    });
  };

  setupAboutJourney();
  document.addEventListener('astro:page-load', setupAboutJourney);
</script>

<style>
  .about-culture {
    margin-top: -1px;
    padding: clamp(82px, 9vw, 132px) 0 clamp(104px, 12vw, 168px);
    background: linear-gradient(180deg, #070b12 0%, #07101a 54%, #060a11 100%);
  }

  .culture-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.42fr) minmax(300px, 0.58fr);
    gap: clamp(38px, 7vw, 108px);
    align-items: end;
  }

  .about-culture figure { aspect-ratio: 16 / 10; overflow: hidden; border-radius: 10px; background: #07101a; }
  .about-culture img { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.86) contrast(1.02); transition: transform 900ms var(--ease-out), filter 600ms var(--ease-out); }
  .culture-copy { padding-bottom: clamp(8px, 3vw, 34px); }
  .culture-copy h2 { max-width: 14ch; margin-bottom: 22px; font-size: clamp(2.2rem, 3.5vw, 4.2rem); font-weight: 540; letter-spacing: -0.04em; line-height: 1; }
  .culture-copy p { max-width: 44ch; color: var(--steel); }

  .about-journey {
    padding-bottom: clamp(108px, 13vw, 182px);
    background: radial-gradient(ellipse 42% 34% at 8% 46%, rgba(70, 134, 183, 0.12), transparent 76%), #060a11;
  }

  .journey-layout { display: grid; grid-template-columns: minmax(280px, 0.72fr) minmax(520px, 1.28fr); gap: clamp(52px, 8vw, 126px); align-items: start; }
  .journey-intro h2 { max-width: 12ch; margin-bottom: 22px; font-size: clamp(2.5rem, 4vw, 4.8rem); font-weight: 520; letter-spacing: -0.04em; line-height: 0.98; }
  .journey-intro p { max-width: 42ch; color: var(--steel); }
  .journey-progress { height: 1px; margin-top: 34px; overflow: hidden; background: rgba(89, 106, 130, 0.34); }
  .journey-progress span { display: block; width: var(--about-progress, 25%); height: 100%; background: var(--signal-ice); transition: width 700ms var(--ease-out); }
  .journey-steps { border-top: 1px solid rgba(89, 106, 130, 0.34); }
  .journey-steps article { display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: clamp(18px, 3vw, 38px); border-bottom: 1px solid rgba(89, 106, 130, 0.3); padding-block: clamp(42px, 6vw, 72px); opacity: 0.58; transform: translate3d(0, 8px, 0); transition: opacity 520ms var(--ease-out), transform 700ms var(--ease-out); }
  .journey-steps article[aria-current='step'] { opacity: 1; transform: none; }
  .journey-index { padding-top: 6px; color: rgba(201, 211, 223, 0.43); }
  .journey-steps h3 { max-width: 23ch; margin-bottom: 16px; font-size: clamp(1.65rem, 2.6vw, 3rem); font-weight: 540; letter-spacing: -0.035em; line-height: 1.04; text-wrap: balance; }
  .journey-steps p { max-width: 49ch; color: var(--steel); }

  .team-section { padding-block: clamp(96px, 11vw, 160px); background: radial-gradient(ellipse 56% 30% at 88% 4%, rgba(70, 134, 183, 0.16), transparent 78%), linear-gradient(180deg, #060a11, #05080e); }
  .team-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 28px; margin-bottom: 42px; }
  .team-heading h2 { max-width: 12ch; font-size: clamp(2.5rem, 4.5vw, 5rem); font-weight: 520; letter-spacing: -0.04em; }
  .team-heading span { color: rgba(201, 211, 223, 0.46); }
  .team-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: clamp(10px, 1.5vw, 22px); }
  .person { min-width: 0; }
  .person figure { aspect-ratio: 4 / 5; overflow: hidden; border-radius: 8px; background: #07101a; }
  .person img { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.84); transition: transform 820ms var(--ease-out), filter 520ms var(--ease-out); }
  .person > div { padding-top: 16px; }
  .person h3 { margin-bottom: 5px; font-size: clamp(1rem, 1.25vw, 1.22rem); font-weight: 580; }
  .person p { color: var(--steel); font-size: 0.8rem; }

  @media (hover: hover) and (pointer: fine) {
    .about-culture figure:hover img { transform: scale(1.018); filter: saturate(0.96); }
    .person:hover img { transform: scale(1.03); filter: saturate(1); }
  }

  @media (min-width: 1001px) and (min-height: 720px) { .journey-intro { position: sticky; top: 126px; } }
  @media (max-width: 1000px) { .culture-layout, .journey-layout { grid-template-columns: 1fr; } .team-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .about-culture figure { aspect-ratio: 4 / 5; } .about-culture img { object-position: 52% center; } .journey-steps article { grid-template-columns: 36px minmax(0, 1fr); } .team-heading { align-items: flex-start; flex-direction: column; } .team-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 440px) { .team-grid { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .about-culture img, .journey-progress span, .journey-steps article, .person img { transition: none; } .journey-steps article { transform: none; } }
</style>