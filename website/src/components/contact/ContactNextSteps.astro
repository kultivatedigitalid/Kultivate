---
interface Props { locale: 'id' | 'en'; }
const { locale } = Astro.props;
// Internal provenance: provisional working copy; the 1–2 working day expectation is explicitly requested by the team.
const steps = locale === 'id' ? [
  ['Tunggu 1–2 hari kerja', 'Setelah inquiry Anda terkirim.'],
  ['Kami menghubungi Anda', 'Melalui email atau WhatsApp.'],
  ['Lengkapi konteks', 'Ceritakan tujuan dan hambatan Anda.'],
  ['Kami meninjau', 'Menilai kecocokan dan prioritas.'],
  ['Discovery singkat', 'Konsultasi pertama tanpa biaya.'],
  ['Perjelas scope', 'Kami jelaskan pekerjaan dan langkah berikutnya.'],
] : [
  ['Allow 1–2 working days', 'After sending your enquiry.'],
  ['We reach out', 'By email or WhatsApp.'],
  ['Share your context', 'Tell us your goals and constraints.'],
  ['We review', 'We assess fit and priorities.'],
  ['Short discovery', 'A free first conversation.'],
  ['Clarify the scope', 'We explain the work and next steps.'],
];
---
<section class="next-steps-card" aria-labelledby="contact-next-title">
  <h2 id="contact-next-title">{locale === 'id' ? 'Langkah berikutnya' : 'What happens next'}</h2>
  <ol>{steps.map(([title, description], index) => <li>
    <span class="step-number" aria-hidden="true">{index + 1}</span>
    <div><h3>{title}</h3><p>{description}</p></div>
  </li>)}</ol>
</section>
<style>
  .next-steps-card { padding: 0; border: 0; border-radius: 0; background: transparent; }
  h2 { margin-bottom: 24px; color: var(--cloud-white); font-size: 1.25rem; font-weight: 650; line-height: 1.2; }
  ol { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 20px; list-style: none; }
  li { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 8px; align-items: baseline; }
  .step-number { color: var(--signal-ice); font-size: .8rem; }
  h3 { margin-bottom: 5px; font-size: .94rem; font-weight: 600; line-height: 1.4; color: var(--cloud-white); }
  p { font-size: .9rem; line-height: 1.5; color: var(--mist); }
</style>
