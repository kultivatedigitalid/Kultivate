---
interface Props {
  data?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const { data } = Astro.props;
const entries = data ? (Array.isArray(data) ? data : [data]) : [];
const serialize = (value: Record<string, unknown>) => JSON.stringify(value).replace(/</g, '\\u003c');
---

{entries.map((entry) => <script type="application/ld+json" set:html={serialize(entry)} />)}
