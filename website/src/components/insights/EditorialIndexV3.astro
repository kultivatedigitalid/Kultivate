---
import HeroShell from '../shared/HeroShell.astro';
import { editorialItems } from '../../data/editorial';

interface Props { locale: 'id' | 'en'; }

const { locale } = Astro.props;
const articles = editorialItems[locale];
const topics = [...new Set(articles.map((article) => article.category))];
const copy = locale === 'id'
  ? {
      label: 'BLOG',
      title: 'Artikel Blog',
      description: 'Insight untuk membantu Anda memahami pilihan digital, strategi, dan hal yang mendukung keputusan lebih baik.',
      heroAlt: 'Bidang informasi biru tersusun dalam kedalaman',
      topics: 'Topik',
      allTopic: 'Semua',
      all: 'Semua artikel',
      featured: 'Artikel pilihan',
      story: 'Story',
      read: 'Baca artikel',
      result: 'artikel ditampilkan'
    }
  : {
      label: 'BLOG',
      title: 'Blog Post',
      description: 'Insights to help you understand digital choices, strategies, and what drives better decisions.',
      heroAlt: 'Blue information surfaces arranged with depth',
      topics: 'Topics',
      allTopic: 'All',
      all: 'All stories',
      featured: 'Featured story',
      story: 'Story',
      read: 'Read article',
      result: 'stories shown'
    };
---

<div class="insights-page page-flow">
  <HeroShell scene="insights"
    title={copy.title}
    description={copy.description}
    image="/assets/hero-scenes/insights-wave.webp"
    imageAlt={copy.heroAlt}
    label={copy.label}
    variant="insights"
    depth
    focalPoint="56% 50%"
  />

  <section
    class="editorial flow-section"
    id="all-stories"
    data-scroll-key="insights-stories"
    data-insights-index
    data-filtered="false"
  >
    <div class="container">
      <nav class="topic-row" aria-label={copy.topics} data-reveal>
        <span class="text-mono">{copy.topics}</span>
        <div class="topic-controls">
          <button type="button" data-topic="" aria-pressed="true">{copy.allTopic}</button>
          {topics.map((topic) => (
            <button type="button" data-topic={topic} aria-pressed="false">{topic}</button>
          ))}
        </div>
      </nav>

      <section class="stories-block" aria-labelledby="stories-title">
        <header class="stories-heading" data-reveal>
          <div>
            <span class="section-label text-mono">{copy.label}</span>
            <h2 id="stories-title" data-stories-title>{copy.all}</h2>
          </div>
          <p class="result-count text-mono" aria-live="polite" data-result-count>
            {articles.length} {copy.result}
          </p>
        </header>

        <div class="story-grid" data-story-grid>
          <div class="story-backdrop light-field" aria-hidden="true"></div>
          {articles.map((article, index) => (
            <div class:list={[index === 0 ? 'story-feature' : 'story-item']}>
            <a
              href={'/' + locale + '/insights/' + article.slug + '/'}
              class="story-card"
              data-story-card
              data-topic-value={article.category}
              data-rank={index}
              data-reveal
              style={`--reveal-delay: ${Math.min(index, 4) * 55}ms`}
            >
              <figure>
                <img
                  src={article.image}
                  alt={article.alt}
                  width="1536"
                  height="1024"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <div class="story-copy">
                <div class="story-rank text-mono">{index === 0 ? copy.featured : copy.story}</div>
                <div class="story-meta text-mono">
                  <span>{article.category}</span>
                  <time>{article.date}</time>
                </div>
                <h3>{article.title}</h3>
                <p>{article.summary}</p>
                <span class="story-link">
                  <span>{copy.read}</span><span aria-hidden="true">&#8594;</span>
                </span>
              </div>
            </a>
            </div>
          ))}
        </div>
      </section>
    </div>
  </section>
</div>

<script>
  const setupInsightsFilters = () => {
    document.querySelectorAll<HTMLElement>('[data-insights-index]').forEach((root) => {
      if (root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-topic]'));
      const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-story-card]'));
      const title = root.querySelector<HTMLElement>('[data-stories-title]');
      const count = root.querySelector<HTMLElement>('[data-result-count]');
      const allTitle = title?.textContent?.trim() ?? '';
      const resultLabel = count?.textContent?.replace(/^\s*\d+\s*/, '').trim() ?? '';

      const grid = root.querySelector<HTMLElement>('[data-story-grid]');
      const feature = root.querySelector<HTMLElement>('.story-feature');
      // The light field belongs to the result area, never to a filtered card.
      // Capture the normal feature footprint before switching to equal cards.
      const syncBackdrop = () => {
        if (!grid || !feature || root.dataset.filtered === 'true') return;
        const height = Math.ceil(feature.getBoundingClientRect().height);
        if (height > 0) grid.style.setProperty('--story-field-height', `${height}px`);
      };
      const observer = new ResizeObserver(syncBackdrop);
      if (feature) observer.observe(feature);
      document.fonts.ready.then(syncBackdrop);
      syncBackdrop();
      document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });

      const applyFilter = (topic: string) => {
        syncBackdrop();
        root.dataset.filtering = 'true';
        root.dataset.filtered = topic ? 'true' : 'false';

        let visibleCount = 0;
        cards.forEach((card) => {
          const matches = !topic || card.dataset.topicValue === topic;
          card.hidden = !matches;
          if (matches) visibleCount += 1;
        });


        buttons.forEach((button) => {
          button.setAttribute('aria-pressed', String((button.dataset.topic ?? '') === topic));
        });

        if (title) {
          title.textContent = topic
            ? topic
            : allTitle;
        }
        if (count) count.textContent = `${visibleCount} ${resultLabel}`;

        requestAnimationFrame(() => {
          root.dataset.filtering = 'false';
        });
      };

      buttons.forEach((button) => {
        button.addEventListener('click', () => applyFilter(button.dataset.topic ?? ''));
      });
    });
  };

  setupInsightsFilters();
  document.addEventListener('astro:page-load', setupInsightsFilters);
</script>


<style>
  .editorial {
    position: relative;
    padding: clamp(28px, 4vw, 48px) 0 clamp(64px, 7vw, 96px);
    background: linear-gradient(180deg, rgba(7, 11, 18, 0.24), rgba(6, 10, 17, 0.56) 54%, rgba(5, 8, 14, 0.48));
  }

  .topic-row {
    display: grid;
    grid-template-columns: minmax(130px, 0.34fr) 1.66fr;
    gap: clamp(28px, 6vw, 88px);
    align-items: center;
    border: 0;
    padding-block: 8px;
  }

  .topic-row > span { color: rgba(201, 211, 223, 0.5); }

  .topic-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .topic-controls button {
    min-height: 40px;
    border: 1px solid rgba(201, 211, 223, 0.16);
    border-radius: 999px;
    padding: 8px 15px;
    background: rgba(7, 11, 18, 0.32);
    color: rgba(226, 234, 243, 0.74);
    font: inherit;
    font-size: 0.82rem;
    cursor: pointer;
    transition:
      border-color 180ms var(--ease-out),
      background-color 180ms var(--ease-out),
      color 180ms var(--ease-out);
  }

  .topic-controls button[aria-pressed='true'] {
    border-color: rgba(207, 247, 255, 0.48);
    background: rgba(103, 217, 255, 0.1);
    color: var(--cloud-white);
  }

  .topic-controls button:focus-visible {
    outline: 2px solid var(--signal-ice);
    outline-offset: 3px;
  }

  .stories-block { padding-top: clamp(24px, 3vw, 40px); }

  .stories-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: clamp(20px, 2.5vw, 32px);
  }

  .section-label {
    display: block;
    margin-bottom: 16px;
    color: rgba(201, 211, 223, 0.52);
  }

  .stories-heading h2 {
    font-size: clamp(2.2rem, 3.6vw, 4.2rem);
    font-weight: 540;
    letter-spacing: -0.04em;
  }

  .result-count { color: rgba(201, 211, 223, 0.5); }

  .story-grid {
    position: relative;
    isolation: isolate;
    min-height: var(--story-field-height, 520px);
    align-content: start;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(32px, 4vw, 56px) clamp(18px, 3vw, 42px);
    transition: opacity 180ms var(--ease-out);
  }

  [data-filtering='true'] .story-grid { opacity: 0.48; }

  .story-card {
    min-width: 0;
    grid-column: span 4;
    color: inherit;
  }

  .story-card[data-rank='0'] {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(340px, 0.82fr);
    gap: clamp(38px, 6vw, 84px);
    align-items: end;
    width: min(100%, 1180px);
  }


  [data-filtered='true'] .story-card,
  [data-filtered='true'] .story-card[data-rank] {
    grid-column: span 4;
    display: block;
  }

  .story-card[hidden] { display: none !important; }

  .story-card figure {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 8px;
    background: #07101a;
  }

  .story-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.78) saturate(0.84);
    transform: scale(1.025);
    transition:
      transform 620ms var(--ease-out),
      filter 400ms var(--ease-out);
  }

  .story-copy { padding-top: 20px; }
  .story-card[data-rank='0'] .story-copy { padding-block: 0 clamp(4px, 2vw, 24px); }

  .story-rank {
    margin-bottom: 14px;
    color: rgba(201, 211, 223, 0.46);
  }

  [data-filtered='true'] .story-rank { display: none; }

  .story-meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: rgba(201, 211, 223, 0.55);
  }

  .story-card h3 {
    max-width: 24ch;
    margin: 16px 0 11px;
    font-size: clamp(1.4rem, 2vw, 2rem);
    font-weight: 540;
    line-height: 1.08;
  }

  .story-card[data-rank='0'] h3 {
    max-width: 15ch;
    font-size: clamp(2rem, 3.5vw, 4rem);
    line-height: 0.99;
  }

  [data-filtered='true'] .story-card[data-rank] h3 {
    max-width: 24ch;
    font-size: clamp(1.4rem, 2vw, 2rem);
    line-height: 1.08;
  }

  .story-card p { color: var(--steel); font-size: 0.9rem; }

  .story-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
    color: var(--mist);
    font-size: 0.82rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .story-card:hover img,
    .story-card:focus-visible img {
      transform: scale(1.045);
      filter: brightness(0.92) saturate(0.98);
    }

    .story-card:hover .story-link,
    .story-card:focus-visible .story-link { color: var(--cloud-white); }
  }

  @media (max-width: 1050px) {
    .story-card[data-rank='0'] { grid-template-columns: 1fr; }
    .story-card[data-rank='0'] .story-copy { max-width: 720px; padding-top: 20px; }

    [data-filtered='true'] .story-card,
    [data-filtered='true'] .story-card[data-rank] { grid-column: span 6; }
  }

  @media (max-width: 760px) {
    .topic-row { grid-template-columns: 1fr; gap: 14px; }
    .topic-controls { flex-wrap: nowrap; overflow-x: auto; padding: 2px 2px 8px; }
    .topic-controls button { flex: none; }

    .stories-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }

    .story-grid { grid-template-columns: 1fr; gap: 36px; }

    .story-card,
    .story-card[data-rank],
    [data-filtered='true'] .story-card,
    [data-filtered='true'] .story-card[data-rank] {
      grid-column: auto;
      display: block;
    }

    .story-card[data-rank='0'] h3,
    [data-filtered='true'] .story-card[data-rank] h3 {
      max-width: 24ch;
      font-size: clamp(1.65rem, 7vw, 2.35rem);
      line-height: 1.04;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .story-grid,
    .topic-controls button,
    .story-card img { transition: none; }

    .story-card img { transform: none; }
  }
  /* Matches the pill CTA used by Blog cards on Home. */
  .story-link {
    width: fit-content;
    gap: 9px;
    border: 1px solid rgba(201, 211, 223, 0.36);
    border-radius: 999px;
    padding: 8px 15px;
    font-family: var(--font-mono);
    font-size: 0.61rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: border-color 180ms var(--ease-out), color 180ms var(--ease-out), transform 180ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .story-card:hover .story-link,
    .story-card:focus-visible .story-link {
      border-color: rgba(207, 247, 255, 0.72);
      color: var(--cloud-white);
      transform: translateY(-2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .story-link { transition: none; }
  }

  .story-item { display:contents; }
  .story-feature { grid-column:1/-1; padding-block:clamp(28px,3.5vw,48px); margin-block:0 12px; }
  :global(#main-content) .story-backdrop::after { left:calc((min(100vw,1440px) - 100vw) / 2 - 10vw); right:calc((min(100vw,1440px) - 100vw) / 2 - 10vw); }
  .story-feature > .story-card { width:100%; }
  .story-feature :is(h3,.story-link) { color:#0c2940; }
  .story-feature :is(p,.story-rank,.story-meta) { color:#2a4c65; }
  .story-feature .story-link { border-color:rgba(16,57,87,.45); }
  .story-feature .story-card:is(:hover,:focus-visible) .story-link { color:#071c2d; border-color:#071c2d; }
  .story-backdrop.light-field { position:absolute; inset:0 0 auto; height:var(--story-field-height,520px); z-index:-1; pointer-events:none; }
  [data-filtered='true'] .story-feature { display:contents; }
  [data-filtered='true'] .story-card[data-rank] { display:flex; flex-direction:column; width:100%; min-width:0; gap:0; align-items:stretch; background:#0b1b29; border-radius:8px; overflow:hidden; }
  [data-filtered='true'] .story-card figure { flex:none; width:100%; border-radius:0; }
  [data-filtered='true'] .story-card .story-copy { display:flex; flex-direction:column; flex:1; padding:20px; max-width:none; }
  [data-filtered='true'] .story-card h3 { color:#edf5fa; }
  [data-filtered='true'] .story-card :is(p,.story-meta) { color:#c1d4e1; }
  [data-filtered='true'] .story-card .story-link { color:#d6edf8; border-color:#7393aa; margin-top:auto; align-self:flex-start; }
  [data-filtered='true'] .story-card .story-copy > p { margin-bottom:20px; }
  [data-filtered='true'] .story-card:is(:hover,:focus-visible) .story-link { color:#fff; border-color:#c6edfc; }
  .story-feature[hidden] { display:none; }
  @media(max-width:1050px) {
    .story-feature { padding-block:32px; }
    :global(#main-content) .story-backdrop::after { background:linear-gradient(180deg,transparent,#bfd8e7 15%,#e5f1f7 39%,#b6d2e6 83%,transparent); }

  }

</style>
