---
import HeroShell from '../shared/HeroShell.astro';
import { editorialItems } from '../../data/editorial';

interface Props { locale: 'id' | 'en'; }

const { locale } = Astro.props;
const articles = editorialItems[locale];
const topics = [...new Set(articles.map((article) => article.category))];
const copy = locale === 'id'
  ? {
      label: 'BLOG',
      title: 'Catatan praktis tentang search',
      description: 'Penjelasan yang membantu Anda memahami pilihan, pekerjaan, dan alasan di balik rekomendasi search',
      heroAlt: 'Bidang informasi biru tersusun dalam kedalaman',
      topics: 'Topik',
      allTopic: 'Semua',
      all: 'Semua artikel',
      filtered: 'Artikel terpilih',
      featured: 'Featured story',
      story: 'Story',
      read: 'Baca artikel',
      result: 'artikel ditampilkan',
      pathsLabel: 'Jalur belajar',
      pathsTitle: 'Mulai dari situasi Anda',
      pathsIntro: 'Pilih jalur untuk membaca insight dalam urutan yang lebih berguna.',
      allPaths: 'Semua insight',
      startHere: 'Mulai di sini'
    }
  : {
      label: 'BLOG',
      title: 'Practical search notes',
      description: 'Clear explanations to help you understand the choices, work, and reasoning behind search recommendations',
      heroAlt: 'Blue information surfaces arranged with depth',
      topics: 'Topics',
      allTopic: 'All',
      all: 'All stories',
      filtered: 'Filtered stories',
      featured: 'Featured story',
      story: 'Story',
      read: 'Read article',
      result: 'stories shown',
      pathsLabel: 'Learning paths',
      pathsTitle: 'Start from your situation',
      pathsIntro: 'Choose a path to read the insights in a more useful sequence.',
      allPaths: 'All insights',
      startHere: 'Start here'
    };

const pathways = locale === 'id'
  ? [
      {
        id: 'website-decisions',
        title: 'Keputusan Website',
        description: 'Untuk memperjelas penawaran, user journey, dan fondasi pengalaman.',
        slugs: ['website-sebagai-pusat-sistem', 'kecepatan-dan-positioning']
      },
      {
        id: 'trust-conversion',
        title: 'Trust & Conversion',
        description: 'Untuk menyambungkan discovery dengan keyakinan dan langkah berikutnya.',
        slugs: ['setelah-ditemukan', 'arah-sebelum-channel']
      },
      {
        id: 'search-demand',
        title: 'Search & Demand',
        description: 'Untuk menghubungkan intent, struktur, dan sistem content.',
        slugs: ['seo-sebelum-keyword', 'konten-dimulai-dari-sistem']
      }
    ]
  : [
      {
        id: 'website-decisions',
        title: 'Website Decisions',
        description: 'Clarify the offer, user journey, and experience foundation.',
        slugs: ['website-as-the-system-center', 'speed-and-positioning']
      },
      {
        id: 'trust-conversion',
        title: 'Trust & Conversion',
        description: 'Connect discovery with confidence and the next useful step.',
        slugs: ['what-happens-after-discovery', 'direction-before-channels']
      },
      {
        id: 'search-demand',
        title: 'Search & Demand',
        description: 'Connect intent, structure, and the content system.',
        slugs: ['seo-before-keywords', 'content-starts-with-a-system']
      }
    ];

const getPathway = (slug: string) => pathways.find((pathway) => pathway.slugs.includes(slug));
const isPathStart = (slug: string) => pathways.some((pathway) => pathway.slugs[0] === slug);
---

<div class="insights-page page-flow">
  <HeroShell
    title={copy.title}
    description={copy.description}
    image="/assets/banners/insights-gradient.webp"
    imageAlt={copy.heroAlt}
    label={copy.label}
    variant="insights"
    depth
    focalPoint="56% 50%"
  />

  <main
    class="editorial flow-section"
    id="all-stories"
    data-scroll-key="insights-stories"
    data-insights-index
    data-filtered="false"
  >
    <div class="container">
      <section class="pathway-chooser" aria-labelledby="pathways-title" data-reveal>
        <header class="pathway-intro">
          <span class="text-mono">{copy.pathsLabel}</span>
          <h2 id="pathways-title">{copy.pathsTitle}</h2>
          <p>{copy.pathsIntro}</p>
        </header>
        <div class="pathway-options">
          <button type="button" data-pathway="" aria-pressed="true">
            <span>{copy.allPaths}</span>
            <small>{articles.length} {copy.result}</small>
          </button>
          {pathways.map((pathway) => (
            <button type="button" data-pathway={pathway.id} aria-pressed="false">
              <span>{pathway.title}</span>
              <small>{pathway.description}</small>
            </button>
          ))}
        </div>
      </section>

      <nav class="topic-row" aria-label={copy.topics} data-reveal>
        <span class="text-mono">{copy.topics}</span>
        <div class="topic-controls">
          <button type="button" data-topic="" aria-pressed="true">{copy.allTopic}</button>
          {topics.map((topic) => (
            <button type="button" data-topic={topic} aria-pressed="false">{topic}</button>
          ))}
        </div>
      </nav>

      <section class="stories-block" aria-labelledby="stories-title">
        <header class="stories-heading" data-reveal>
          <div>
            <span class="section-label text-mono">{copy.label}</span>
            <h2 id="stories-title" data-stories-title>{copy.all}</h2>
          </div>
          <p class="result-count text-mono" aria-live="polite" data-result-count>
            {articles.length} {copy.result}
          </p>
        </header>

        <div class="story-grid" data-story-grid>
          {articles.map((article, index) => (
            <a
              href={'/' + locale + '/insights/' + article.slug + '/'}
              class="story-card"
              data-story-card
              data-topic-value={article.category}
              data-pathway-value={getPathway(article.slug)?.id}
              data-rank={index}
              data-reveal
              style={`--reveal-delay: ${Math.min(index, 4) * 55}ms`}
            >
              <figure>
                <img
                  src={article.image}
                  alt={article.alt}
                  width="1536"
                  height="1024"
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <div class="story-copy">
                <div class="story-rank text-mono">{index === 0 ? copy.featured : copy.story}</div>
                {isPathStart(article.slug) && <span class="pathway-start text-mono">{copy.startHere}</span>}
                <div class="story-meta text-mono">
                  <span>{article.category}</span>
                  <time>{article.date}</time>
                </div>
                <h3>{article.title}</h3>
                <p>{article.summary}</p>
                <span class="story-link">
                  <span>{copy.read}</span><span aria-hidden="true">&#8594;</span>
                </span>
              </div>
            </a>
          ))}
        </div>
      </section>
    </div>
  </main>
</div>

<script>
  const setupInsightsFilters = () => {
    document.querySelectorAll<HTMLElement>('[data-insights-index]').forEach((root) => {
      if (root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const topicButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-topic]'));
      const pathwayButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-pathway]'));
      const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-story-card]'));
      const title = root.querySelector<HTMLElement>('[data-stories-title]');
      const count = root.querySelector<HTMLElement>('[data-result-count]');
      const allTitle = title?.textContent?.trim() ?? '';
      const filteredTitle = root.ownerDocument.querySelector<HTMLElement>('[data-filtered-title]')?.textContent?.trim() ?? '';
      const resultLabel = count?.textContent?.replace(/^\s*\d+\s*/, '').trim() ?? '';
      let activeTopic = '';
      let activePathway = '';
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const applyFilters = () => {
        root.dataset.filtering = 'true';
        root.dataset.filtered = activeTopic || activePathway ? 'true' : 'false';

        let visibleCount = 0;
        cards.forEach((card) => {
          const matchesTopic = !activeTopic || card.dataset.topicValue === activeTopic;
          const matchesPathway = !activePathway || card.dataset.pathwayValue === activePathway;
          const matches = matchesTopic && matchesPathway;
          card.hidden = !matches;
          if (matches) visibleCount += 1;
        });

        topicButtons.forEach((button) => {
          button.setAttribute('aria-pressed', String((button.dataset.topic ?? '') === activeTopic));
        });
        pathwayButtons.forEach((button) => {
          button.setAttribute('aria-pressed', String((button.dataset.pathway ?? '') === activePathway));
        });

        if (title) {
          const activePathLabel = pathwayButtons
            .find((button) => (button.dataset.pathway ?? '') === activePathway)
            ?.querySelector('span')?.textContent?.trim();
          const filterLabel = activeTopic || activePathLabel;
          title.textContent = filterLabel
            ? (filteredTitle || (root.ownerDocument.documentElement.lang.startsWith('id') ? 'Artikel' : 'Stories')) + ': ' + filterLabel
            : allTitle;
        }
        if (count) count.textContent = visibleCount + ' ' + resultLabel;

        requestAnimationFrame(() => {
          root.dataset.filtering = 'false';
        });
      };

      topicButtons.forEach((button) => {
        button.addEventListener('click', () => {
          activeTopic = button.dataset.topic ?? '';
          applyFilters();
        });
      });

      pathwayButtons.forEach((button) => {
        button.addEventListener('click', () => {
          activePathway = button.dataset.pathway ?? '';
          activeTopic = '';
          applyFilters();
          root.querySelector<HTMLElement>('[data-stories-title]')?.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'start' });
        });
      });
    });
  };

  setupInsightsFilters();
  document.addEventListener('astro:page-load', setupInsightsFilters);
</script>

<span class="visually-hidden" data-filtered-title>{copy.filtered}</span>

<style>
  .editorial {
    position: relative;
    padding: 0 0 clamp(96px, 11vw, 148px);
    background: linear-gradient(180deg, rgba(7, 11, 18, 0.24), rgba(6, 10, 17, 0.56) 54%, rgba(5, 8, 14, 0.48));
  }

  .pathway-chooser {
    display: grid;
    grid-template-columns: minmax(240px, 0.6fr) minmax(0, 1.4fr);
    gap: clamp(44px, 8vw, 118px);
    padding: clamp(72px, 9vw, 122px) 0;
  }

  .pathway-intro > .text-mono { display: block; margin-bottom: 18px; color: rgba(201, 211, 223, 0.5); }
  .pathway-intro h2 { max-width: 12ch; font-size: clamp(2.25rem, 3.8vw, 4.3rem); font-weight: 530; letter-spacing: -0.04em; line-height: 1; }
  .pathway-intro p { max-width: 38ch; margin-top: 22px; color: var(--steel); line-height: 1.62; }
  .pathway-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid rgba(89, 106, 130, 0.34); }
  .pathway-options button {
    min-height: 146px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 22px;
    border: 0;
    border-bottom: 1px solid rgba(89, 106, 130, 0.34);
    padding: 24px;
    background: transparent;
    color: rgba(226, 234, 243, 0.78);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: background-color 200ms var(--ease-out), color 200ms var(--ease-out), transform 320ms var(--ease-out);
  }
  .pathway-options button:nth-child(odd) { border-right: 1px solid rgba(89, 106, 130, 0.34); }
  .pathway-options button > span { font-size: clamp(1.08rem, 1.45vw, 1.36rem); font-weight: 540; }
  .pathway-options button small { max-width: 34ch; color: var(--steel); font-size: 0.78rem; line-height: 1.48; }
  .pathway-options button[aria-pressed='true'] { background: linear-gradient(135deg, rgba(103, 217, 255, 0.1), rgba(23, 107, 255, 0.025)); color: var(--cloud-white); transform: translate3d(0, -3px, 0); }
  .pathway-options button:focus-visible { outline: 2px solid var(--signal-ice); outline-offset: -2px; }

  .topic-row {
    display: grid;
    grid-template-columns: minmax(130px, 0.34fr) 1.66fr;
    gap: clamp(28px, 6vw, 88px);
    align-items: center;
    border-block: 1px solid rgba(89, 106, 130, 0.34);
    padding-block: 18px;
  }

  .topic-row > span { color: rgba(201, 211, 223, 0.5); }

  .topic-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .topic-controls button {
    min-height: 40px;
    border: 1px solid rgba(201, 211, 223, 0.16);
    border-radius: 999px;
    padding: 8px 15px;
    background: rgba(7, 11, 18, 0.32);
    color: rgba(226, 234, 243, 0.74);
    font: inherit;
    font-size: 0.82rem;
    cursor: pointer;
    transition:
      border-color 180ms var(--ease-out),
      background-color 180ms var(--ease-out),
      color 180ms var(--ease-out);
  }

  .topic-controls button[aria-pressed='true'] {
    border-color: rgba(207, 247, 255, 0.48);
    background: rgba(103, 217, 255, 0.1);
    color: var(--cloud-white);
  }

  .topic-controls button:focus-visible {
    outline: 2px solid var(--signal-ice);
    outline-offset: 3px;
  }

  .stories-block { padding-top: clamp(68px, 8vw, 110px); }

  .stories-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: clamp(28px, 4vw, 50px);
  }

  .section-label {
    display: block;
    margin-bottom: 16px;
    color: rgba(201, 211, 223, 0.52);
  }

  .stories-heading h2 {
    font-size: clamp(2.2rem, 3.6vw, 4.2rem);
    font-weight: 540;
    letter-spacing: -0.04em;
  }

  .result-count { color: rgba(201, 211, 223, 0.5); }

  .story-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(54px, 7vw, 92px) clamp(18px, 3vw, 42px);
    transition: opacity 180ms var(--ease-out);
  }

  [data-filtering='true'] .story-grid { opacity: 0.48; }

  .story-card {
    min-width: 0;
    grid-column: span 4;
    color: inherit;
  }

  .story-card[data-rank='0'] {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(340px, 0.82fr);
    gap: clamp(38px, 6vw, 84px);
    align-items: end;
    width: min(100%, 1180px);
  }


  [data-filtered='true'] .story-card,
  [data-filtered='true'] .story-card[data-rank] {
    grid-column: span 4;
    display: block;
  }

  .story-card[hidden] { display: none !important; }

  .story-card figure {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 8px;
    background: #07101a;
  }

  .story-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.78) saturate(0.84);
    transform: scale(1.025);
    transition:
      transform 620ms var(--ease-out),
      filter 400ms var(--ease-out);
  }

  .story-copy { padding-top: 20px; }
  .story-card[data-rank='0'] .story-copy { padding-block: 0 clamp(4px, 2vw, 24px); }

  .story-rank {
    margin-bottom: 14px;
    color: rgba(201, 211, 223, 0.46);
  }

  [data-filtered='true'] .story-rank { display: none; }

  .pathway-start {
    width: fit-content;
    display: block;
    margin: -4px 0 14px;
    border: 1px solid rgba(103, 217, 255, 0.3);
    border-radius: 999px;
    padding: 5px 9px;
    color: var(--signal-ice);
    font-size: 0.65rem;
  }

  .story-meta {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: rgba(201, 211, 223, 0.55);
  }

  .story-card h3 {
    max-width: 24ch;
    margin: 16px 0 11px;
    font-size: clamp(1.4rem, 2vw, 2rem);
    font-weight: 540;
    line-height: 1.08;
  }

  .story-card[data-rank='0'] h3 {
    max-width: 15ch;
    font-size: clamp(2rem, 3.5vw, 4rem);
    line-height: 0.99;
  }

  [data-filtered='true'] .story-card[data-rank] h3 {
    max-width: 24ch;
    font-size: clamp(1.4rem, 2vw, 2rem);
    line-height: 1.08;
  }

  .story-card p { color: var(--steel); font-size: 0.9rem; }

  .story-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
    color: var(--mist);
    font-size: 0.82rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .story-card:hover img,
    .story-card:focus-visible img {
      transform: scale(1.045);
      filter: brightness(0.92) saturate(0.98);
    }

    .story-card:hover .story-link,
    .story-card:focus-visible .story-link { color: var(--cloud-white); }
  }

  @media (max-width: 1050px) {
    .story-card[data-rank='0'] { grid-template-columns: 1fr; }
    .story-card[data-rank='0'] .story-copy { max-width: 720px; padding-top: 20px; }

    [data-filtered='true'] .story-card,
    [data-filtered='true'] .story-card[data-rank] { grid-column: span 6; }
  }

  @media (max-width: 760px) {
    .pathway-chooser { grid-template-columns: 1fr; gap: 34px; }
    .pathway-options { grid-template-columns: 1fr; }
    .pathway-options button:nth-child(odd) { border-right: 0; }
    .topic-row { grid-template-columns: 1fr; gap: 14px; }
    .topic-controls { flex-wrap: nowrap; overflow-x: auto; padding: 2px 2px 8px; }
    .topic-controls button { flex: none; }

    .stories-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }

    .story-grid { grid-template-columns: 1fr; gap: 58px; }

    .story-card,
    .story-card[data-rank],
    [data-filtered='true'] .story-card,
    [data-filtered='true'] .story-card[data-rank] {
      grid-column: auto;
      display: block;
    }

    .story-card[data-rank='0'] h3,
    [data-filtered='true'] .story-card[data-rank] h3 {
      max-width: 24ch;
      font-size: clamp(1.65rem, 7vw, 2.35rem);
      line-height: 1.04;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pathway-options button,
    .story-grid,
    .topic-controls button,
    .story-card img { transition: none; }

    .story-card img { transform: none; }
  }
</style>
