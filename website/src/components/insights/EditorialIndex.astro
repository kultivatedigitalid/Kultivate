---
import InteriorHero from '../shared/InteriorHero.astro';
import { editorialItems } from '../../data/editorial';

interface Props { locale: 'id' | 'en'; }
const { locale } = Astro.props;
const [latest, ...articles] = editorialItems[locale];
const copy = locale === 'id'
  ? {
      label: 'BLOG',
      title: 'Wawasan kerja digital.',
      description: 'Catatan tentang website, SEO, dan content.',
      latest: 'Terbaru',
      archive: 'Blog lainnya',
      note: 'Pilihan Kultivate'
    }
  : {
      label: 'BLOG',
      title: 'Notes for digital growth.',
      description: 'Practical notes on websites, SEO, and content.',
      latest: 'Latest',
      archive: 'More from the blog',
      note: 'Kultivate notes'
    };
---

<InteriorHero
  title={copy.title}
  description={copy.description}
  label={copy.label}
  image="/assets/banners/blog.webp"
  imageAlt={locale === 'id' ? 'Lapisan halaman gelap yang disatukan garis cahaya biru' : 'Dark layered pages connected by a blue line of light'}
/>

<section class="editorial" aria-labelledby="latest-title">
  <div class="container editorial-container">
    <span class="editorial-note text-mono">{copy.note}</span>

    <a href={'/' + locale + '/insights/' + latest.slug + '/'} class="latest-story">
      <figure class="latest-media">
        <img src={latest.image} alt={latest.alt} width="1536" height="1024" decoding="async" />
      </figure>
      <div class="latest-copy">
        <div class="latest-meta text-mono"><span>{copy.latest}</span><time>{latest.date}</time></div>
        <span class="latest-category">{latest.category}</span>
        <h2 id="latest-title">{latest.title}</h2>
        <p>{latest.summary}</p>
      </div>
    </a>

    <div class="archive-heading">
      <h2>{copy.archive}</h2>
    </div>

    <div class="editorial-grid">
      {articles.map((article) => (
        <a href={'/' + locale + '/insights/' + article.slug + '/'} class="editorial-card">
          <figure>
            <img src={article.image} alt={article.alt} width="1536" height="1024" loading="lazy" decoding="async" />
          </figure>
          <div class="editorial-card__meta text-mono"><span>{article.category}</span><time>{article.date}</time></div>
          <h3>{article.title}</h3>
          <p>{article.summary}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .editorial {
    margin-top: -1px;
    padding: clamp(36px, 5vw, 72px) 0 clamp(72px, 9vw, 132px);
    background:
      radial-gradient(ellipse 50% 24% at 50% 10%, rgba(23, 107, 255, 0.05), transparent 82%),
      linear-gradient(180deg, #070b12 0%, #070b12 11%, #060a11 40%, #05080e 70%, #070b12 100%);
  }

  .editorial-note { display: block; margin-bottom: 26px; color: rgba(201, 211, 223, 0.48); }

  .latest-story {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(300px, 0.72fr);
    gap: clamp(32px, 5vw, 76px);
    align-items: center;
    color: inherit;
  }

  .latest-media { aspect-ratio: 16 / 10; overflow: hidden; border-radius: 8px; background: #07101a; }
  .latest-media img,
  .editorial-card figure img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.76) saturate(0.82); transition: transform 650ms var(--ease-out), filter 400ms var(--ease-out); }
  .latest-copy { padding-block: 28px; }
  .latest-meta,
  .editorial-card__meta { display: flex; justify-content: space-between; gap: 16px; color: rgba(201, 211, 223, 0.55); }
  .latest-category { display: block; margin: 34px 0 16px; color: var(--cyan-glow); font-size: 0.9rem; }
  .latest-copy h2 { max-width: 13ch; margin-bottom: 22px; color: var(--cloud-white); font-size: clamp(2.2rem, 3.7vw, 4rem); font-weight: 520; letter-spacing: -0.04em; line-height: 0.98; }
  .latest-copy p { max-width: 42ch; color: var(--steel); }

  .archive-heading { margin: clamp(96px, 12vw, 168px) 0 38px; }
  .archive-heading h2 { font-size: clamp(2rem, 3vw, 3.25rem); font-weight: 520; }

  .editorial-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(56px, 8vw, 112px) clamp(18px, 3vw, 42px); }
  .editorial-card { min-width: 0; display: block; color: inherit; }
  .editorial-card figure { aspect-ratio: 16 / 10; overflow: hidden; border-radius: 8px; margin-bottom: 20px; background: #07101a; }
  .editorial-card__meta { margin-bottom: 18px; }
  .editorial-card h3 { max-width: 18ch; margin-bottom: 12px; color: var(--cloud-white); font-size: clamp(1.45rem, 2.25vw, 2.2rem); font-weight: 540; line-height: 1.06; }
  .editorial-card p { max-width: 50ch; color: var(--steel); font-size: 0.93rem; }

  @media (hover: hover) and (pointer: fine) {
    .latest-story:hover img,
    .latest-story:focus-visible img,
    .editorial-card:hover img,
    .editorial-card:focus-visible img { transform: scale(1.035); filter: brightness(0.9) saturate(0.96); }
  }

  @media (max-width: 920px) {
    .editorial-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 800px) {
    .latest-story { grid-template-columns: 1fr; gap: 12px; }
    .latest-copy { padding-bottom: 0; }
    .archive-heading { margin-top: 92px; }
  }

  @media (max-width: 620px) {
    .editorial-grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .latest-media img,
    .editorial-card figure img { transition: none; }
  }
</style>