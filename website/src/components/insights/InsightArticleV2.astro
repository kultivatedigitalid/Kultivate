---
import ArticleHeaderV2 from './ArticleHeaderV2.astro';
import { editorialItems } from '../../data/editorial';

interface Props {
  article: any;
  Content: any;
  headings: Array<{ depth: number; slug: string; text: string }>;
  locale: 'id' | 'en';
}

const { article, Content, headings, locale } = Astro.props;
const toc = headings.filter((heading) => heading.depth === 2);
const related = editorialItems[locale].filter((item) => item.slug !== article.data.slug).slice(0, 3);
const copy = locale === 'id'
  ? { contents: 'Di halaman ini', sources: 'Sumber & referensi', related: 'Artikel terkait', read: 'Baca artikel' }
  : { contents: 'On this page', sources: 'Sources & references', related: 'Related posts', read: 'Read article' };
---

<article class="article-page page-flow">
  <ArticleHeaderV2
    title={article.data.title}
    summary={article.data.summary}
    category={article.data.category}
    author={article.data.author}
    publishedAt={article.data.publishedAt}
    updatedAt={article.data.updatedAt}
    heroImage={article.data.heroImage}
    heroAlt={article.data.heroAlt}
    heroFocalPoint={article.data.heroFocalPoint}
    heroTextTone={article.data.heroTextTone}
    heroScrim={article.data.heroScrim}
    locale={locale}
  />

  <div class="article-surface flow-section" data-scroll-key="article-body" data-article-shell>
    <div class="container">
      <div class="article-layout">
        {toc.length > 0 && (
          <aside class="article-toc" aria-label={copy.contents} data-article-toc data-reveal>
            <span class="text-mono">{copy.contents}</span>
            <ol>
              {toc.map((heading, index) => (
                <li>
                  <a
                    href={'#' + heading.slug}
                    data-toc-link={heading.slug}
                    aria-current={index === 0 ? 'location' : undefined}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </aside>
        )}

        <div class="article-main">
          <div class="article-body"><Content /></div>

          {article.data.sources && article.data.sources.length > 0 && (
            <section class="article-sources" aria-labelledby="sources-title" data-reveal>
              <h2 id="sources-title">{copy.sources}</h2>
              <ul>{article.data.sources.map((source: string) => <li>{source}</li>)}</ul>
            </section>
          )}
        </div>
      </div>

      <section
        class="related-posts"
        aria-labelledby="related-title"
        data-scroll-key="article-related"
      >
        <h2 id="related-title" data-reveal>{copy.related}</h2>
        <div class="related-rail">
          {related.map((item, index) => (
            <a
              class="related-card"
              href={'/' + locale + '/insights/' + item.slug + '/'}
              data-reveal
              style={`--reveal-delay: ${index * 65}ms`}
            >
              <figure>
                <img src={item.image} alt={item.alt} width="1536" height="1024" loading="lazy" decoding="async" />
              </figure>
              <div class="related-meta text-mono"><span>{item.category}</span><time>{item.date}</time></div>
              <h3>{item.title}</h3>
              <span class="related-link"><span>{copy.read}</span><span aria-hidden="true">&#8594;</span></span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</article>

<script>
  const setupArticleToc = () => {
    document.querySelectorAll<HTMLElement>('[data-article-shell]').forEach((shell) => {
      if (shell.dataset.tocReady === 'true') return;
      shell.dataset.tocReady = 'true';

      const links = Array.from(shell.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
      const pairs = links
        .map((link) => {
          const id = link.dataset.tocLink ?? '';
          const target = document.getElementById(id);
          return target ? { link, target } : null;
        })
        .filter((pair): pair is { link: HTMLAnchorElement; target: HTMLElement } => Boolean(pair));

      if (!pairs.length) return;

      const activate = (activeLink: HTMLAnchorElement) => {
        links.forEach((link) => {
          if (link === activeLink) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      };

      links.forEach((link) => {
        link.addEventListener('click', () => activate(link));
      });

      if (!('IntersectionObserver' in window)) {
        activate(pairs[0].link);
        return;
      }

      const observer = new IntersectionObserver((entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];

        if (visible?.target instanceof HTMLElement) {
          const pair = pairs.find((item) => item.target === visible.target);
          if (pair) activate(pair.link);
        }
      }, { rootMargin: '-18% 0px -70%', threshold: 0 });

      pairs.forEach(({ target }) => observer.observe(target));
      activate(pairs[0].link);
    });
  };

  setupArticleToc();
  document.addEventListener('astro:page-load', setupArticleToc);
</script>

<style>
  .article-surface {
    position: relative;
    padding: 1px 0 clamp(96px, 11vw, 148px);
    background: linear-gradient(180deg, rgba(7, 11, 18, 0.28), rgba(6, 10, 17, 0.58) 58%, rgba(5, 8, 14, 0.5));
  }

  .article-layout {
    display: grid;
    grid-template-columns: minmax(180px, 0.36fr) minmax(0, 1fr);
    gap: clamp(40px, 8vw, 126px);
    max-width: 1080px;
    margin: clamp(72px, 9vw, 116px) auto 0;
    align-items: start;
  }

  .article-toc > span {
    display: block;
    margin-bottom: 20px;
    color: rgba(201, 211, 223, 0.48);
  }

  .article-toc ol {
    display: flex;
    flex-direction: column;
    gap: 4px;
    list-style: none;
  }

  .article-toc a {
    position: relative;
    display: block;
    border-left: 1px solid rgba(89, 106, 130, 0.3);
    padding: 7px 0 7px 14px;
    color: rgba(201, 211, 223, 0.64);
    font-size: 0.82rem;
    line-height: 1.4;
    transition:
      border-color 180ms var(--ease-out),
      color 180ms var(--ease-out),
      transform 220ms var(--ease-out);
  }

  .article-toc a[aria-current='location'] {
    border-color: var(--signal-ice);
    color: var(--cloud-white);
    transform: translate3d(4px, 0, 0);
  }

  .article-main { min-width: 0; max-width: 720px; }

  .article-body {
    color: var(--mist);
    font-size: clamp(1.04rem, 1.18vw, 1.13rem);
    line-height: 1.8;
  }

  .article-body :global(h2) {
    scroll-margin-top: 112px;
    margin: clamp(54px, 7vw, 84px) 0 20px;
    color: var(--cloud-white);
    font-size: clamp(1.75rem, 2.6vw, 2.55rem);
    font-weight: 560;
    letter-spacing: -0.035em;
    line-height: 1.08;
  }

  .article-body :global(p) {
    margin-bottom: 24px;
    color: rgba(226, 234, 243, 0.78);
  }

  .article-body :global(a) {
    color: var(--signal-ice);
    text-decoration: underline;
    text-decoration-color: rgba(207, 247, 255, 0.4);
    text-underline-offset: 3px;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 26px 1.2em;
    color: rgba(226, 234, 243, 0.78);
  }

  .article-sources {
    margin-top: clamp(62px, 8vw, 96px);
    border-top: 1px solid rgba(89, 106, 130, 0.34);
    padding-top: 28px;
  }

  .article-sources h2 {
    margin-bottom: 18px;
    font-size: 1.35rem;
    font-weight: 560;
  }

  .article-sources ul {
    margin-left: 1.2em;
    color: var(--steel);
    font-size: 0.88rem;
  }

  .related-posts {
    margin-top: clamp(94px, 12vw, 154px);
    border-top: 1px solid rgba(89, 106, 130, 0.36);
    padding-top: 34px;
  }

  .related-posts > h2 {
    margin-bottom: 34px;
    font-size: clamp(2rem, 3vw, 3.3rem);
    font-weight: 540;
    letter-spacing: -0.04em;
  }

  .related-rail {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .related-card {
    min-width: 0;
    display: block;
    color: inherit;
  }

  .related-card figure {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    margin-bottom: 16px;
    border-radius: 7px;
    background: #07101a;
  }

  .related-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.78) saturate(0.82);
    transition: transform 620ms var(--ease-out), filter 400ms var(--ease-out);
  }

  .related-meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 13px;
    color: rgba(201, 211, 223, 0.52);
    font-size: 0.61rem;
  }

  .related-card h3 {
    max-width: 24ch;
    min-height: 2.35em;
    color: var(--cloud-white);
    font-size: clamp(1.08rem, 1.5vw, 1.38rem);
    font-weight: 540;
    line-height: 1.18;
  }

  .related-link {
    width: fit-content;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 18px;
    border: 1px solid rgba(201, 211, 223, 0.36);
    border-radius: 999px;
    padding: 8px 15px;
    color: var(--mist);
    font-family: var(--font-mono);
    font-size: 0.61rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: border-color 180ms var(--ease-out), color 180ms var(--ease-out), transform 180ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .article-toc a:hover,
    .related-card:hover .related-link { color: var(--cloud-white); }

    .related-card:hover .related-link {
      border-color: rgba(207, 247, 255, 0.72);
      transform: translateY(-2px);
    }

    .related-card:hover img {
      filter: brightness(0.9) saturate(0.96);
      transform: scale(1.035);
    }
  }

  @media (min-width: 821px) and (min-height: 680px) {
    .article-toc { position: sticky; top: 116px; }
  }

  @media (max-width: 820px) {
    .article-layout { grid-template-columns: 1fr; }

    .article-toc {
      border-bottom: 1px solid rgba(89, 106, 130, 0.34);
      padding-bottom: 30px;
    }

    .article-main { max-width: none; }

    .related-rail {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: minmax(270px, 84vw);
      overflow-x: auto;
      padding-bottom: 18px;
      scroll-snap-type: inline mandatory;
      scrollbar-color: rgba(103, 217, 255, 0.34) transparent;
      scrollbar-width: thin;
    }

    .related-card { scroll-snap-align: start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-toc a,
    .related-card img,
    .related-link { transition: none; }

    .article-toc a[aria-current='location'] { transform: none; }
  }
</style>
