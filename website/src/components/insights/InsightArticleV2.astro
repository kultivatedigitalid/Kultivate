---
import ArticleHeaderV2 from './ArticleHeaderV2.astro';
import { editorialItems } from '../../data/editorial';

interface Props {
  article: any;
  Content: any;
  headings: Array<{ depth: number; slug: string; text: string }>;
  locale: 'id' | 'en';
}

const { article, Content, headings, locale } = Astro.props;
const toc = headings.filter((heading) => heading.depth === 2);
const related = editorialItems[locale].filter((item) => item.slug !== article.data.slug).slice(0, 3);
const copy = locale === 'id'
  ? { contents: 'Di halaman ini', sources: 'Sumber & referensi', related: 'Artikel terkait' }
  : { contents: 'On this page', sources: 'Sources & references', related: 'Related posts' };
---

<article class="article-page">
  <div class="container">
    <ArticleHeaderV2
      title={article.data.title}
      summary={article.data.summary}
      category={article.data.category}
      author={article.data.author}
      publishedAt={article.data.publishedAt}
      updatedAt={article.data.updatedAt}
      heroImage={article.data.heroImage}
      heroAlt={article.data.heroAlt}
      locale={locale}
    />

    <div class="article-layout">
      {toc.length > 0 && (
        <aside class="article-toc" aria-label={copy.contents}>
          <span class="text-mono">{copy.contents}</span>
          <ol>{toc.map((heading) => <li><a href={'#' + heading.slug}>{heading.text}</a></li>)}</ol>
        </aside>
      )}

      <div class="article-main">
        <div class="article-body"><Content /></div>

        {article.data.sources && article.data.sources.length > 0 && (
          <section class="article-sources" aria-labelledby="sources-title">
            <h2 id="sources-title">{copy.sources}</h2>
            <ul>{article.data.sources.map((source: string) => <li>{source}</li>)}</ul>
          </section>
        )}
      </div>
    </div>

    <section class="related-posts" aria-labelledby="related-title">
      <h2 id="related-title">{copy.related}</h2>
      <div>
        {related.map((item) => (
          <a href={'/' + locale + '/insights/' + item.slug + '/'}>
            <span class="text-mono">{item.category}</span>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
</article>

<style>
  .article-page { padding: clamp(132px, 15vw, 204px) 0 clamp(96px, 12vw, 164px); background: linear-gradient(180deg, #070b12 0%, #060a11 58%, #05080e 100%); }
  .article-layout { display: grid; grid-template-columns: minmax(180px, 0.36fr) minmax(0, 1fr); gap: clamp(40px, 8vw, 126px); max-width: 1080px; margin: clamp(72px, 9vw, 124px) auto 0; align-items: start; }
  .article-toc { position: sticky; top: 116px; }
  .article-toc > span { display: block; margin-bottom: 20px; color: rgba(201, 211, 223, 0.48); }
  .article-toc ol { display: flex; flex-direction: column; gap: 14px; list-style: none; }
  .article-toc a { color: rgba(201, 211, 223, 0.7); font-size: 0.82rem; line-height: 1.4; }
  .article-main { min-width: 0; max-width: 720px; }
  .article-body { color: var(--mist); font-size: clamp(1.04rem, 1.18vw, 1.13rem); line-height: 1.8; }
  .article-body :global(h2) { scroll-margin-top: 112px; margin: clamp(54px, 7vw, 84px) 0 20px; color: var(--cloud-white); font-size: clamp(1.75rem, 2.6vw, 2.55rem); font-weight: 560; line-height: 1.08; }
  .article-body :global(p) { margin-bottom: 24px; color: rgba(226, 234, 243, 0.78); }
  .article-body :global(a) { color: var(--signal-ice); text-decoration: underline; text-decoration-color: rgba(207, 247, 255, 0.4); text-underline-offset: 3px; }
  .article-body :global(ul), .article-body :global(ol) { margin: 0 0 26px 1.2em; color: rgba(226, 234, 243, 0.78); }
  .article-sources { margin-top: clamp(62px, 8vw, 96px); border-top: 1px solid rgba(89, 106, 130, 0.34); padding-top: 28px; }
  .article-sources h2 { margin-bottom: 18px; font-size: 1.35rem; font-weight: 560; }
  .article-sources ul { margin-left: 1.2em; color: var(--steel); font-size: 0.88rem; }
  .related-posts { margin-top: clamp(108px, 14vw, 188px); border-top: 1px solid rgba(89, 106, 130, 0.36); padding-top: 34px; }
  .related-posts > h2 { margin-bottom: 34px; font-size: clamp(2rem, 3vw, 3.3rem); font-weight: 540; }
  .related-posts > div { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: rgba(89, 106, 130, 0.26); }
  .related-posts a { display: block; min-width: 0; background: #07101a; padding: clamp(24px, 3vw, 36px); }
  .related-posts span { color: rgba(201, 211, 223, 0.48); }
  .related-posts h3 { margin: 24px 0 12px; font-size: clamp(1.25rem, 1.8vw, 1.75rem); font-weight: 540; line-height: 1.08; }
  .related-posts p { color: var(--steel); font-size: 0.86rem; }
  @media (hover: hover) and (pointer: fine) { .article-toc a:hover, .related-posts a:hover h3 { color: var(--cloud-white); } .related-posts a:hover { background: #0b1d2b; } }
  @media (max-width: 820px) { .article-layout { grid-template-columns: 1fr; } .article-toc { position: static; border-bottom: 1px solid rgba(89, 106, 130, 0.34); padding-bottom: 30px; } .article-main { max-width: none; } .related-posts > div { grid-template-columns: 1fr; } }
</style>
