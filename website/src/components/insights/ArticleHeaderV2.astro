---
import HeroShell from '../shared/HeroShell.astro';

interface Props {
  title: string;
  summary: string;
  category: string;
  author: string;
  publishedAt: string;
  updatedAt?: string;
  heroImage: string;
  heroAlt: string;
  locale: 'id' | 'en';
}

const { title, summary, category, author, publishedAt, updatedAt, heroImage, heroAlt, locale } = Astro.props;
const dateLocale = locale === 'id' ? 'id-ID' : 'en-GB';
const formatDate = (value: string) =>
  new Intl.DateTimeFormat(dateLocale, { day: 'numeric', month: 'long', year: 'numeric' })
    .format(new Date(value + 'T00:00:00'));
---

<HeroShell
  title={title}
  description={summary}
  image={heroImage}
  imageAlt={heroAlt}
  label={category}
  variant="editorial-compact"
  titleId="article-title"
  focalPoint="52% 50%"
>
  <Fragment slot="meta">
    <div class="article-byline text-mono">
      <span>{locale === 'id' ? 'Oleh' : 'By'} <strong>{author}</strong></span>
      <time datetime={publishedAt}>{formatDate(publishedAt)}</time>
      {updatedAt && (
        <time datetime={updatedAt}>
          {locale === 'id' ? 'Diperbarui ' : 'Updated '}{formatDate(updatedAt)}
        </time>
      )}
    </div>
  </Fragment>

  <Fragment slot="actions">
    <a href={'/' + locale + '/insights/'} class="back-link text-mono">
      <span aria-hidden="true">&#8592;</span>
      <span>{locale === 'id' ? 'Kembali ke Blog' : 'Back to Blog'}</span>
    </a>
  </Fragment>
</HeroShell>

<style>
  .article-byline {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 20px;
    color: rgba(201, 211, 223, 0.66);
  }

  .article-byline strong {
    color: rgba(238, 245, 250, 0.9);
    font-weight: 560;
  }

  .back-link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    border: 1px solid rgba(201, 211, 223, 0.22);
    border-radius: 999px;
    padding: 9px 16px;
    color: rgba(226, 234, 243, 0.78);
    transition: border-color 180ms var(--ease-out), color 180ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .back-link:hover {
      border-color: rgba(207, 247, 255, 0.5);
      color: var(--cloud-white);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-link { transition: none; }
  }
</style>
