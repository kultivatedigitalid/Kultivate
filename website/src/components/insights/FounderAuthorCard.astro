---
import { founderCopy, founderIdentity, founderProfilePath } from '../../data/founder';

interface Props { locale: 'id' | 'en'; }
const { locale } = Astro.props;
const copy = founderCopy[locale];
---

<aside class="founder-author" aria-labelledby="founder-author-name" data-reveal>
  <div class="founder-author__portrait" role="img" aria-label={copy.portraitAlt}>
    <strong aria-hidden="true">GH</strong>
    <span class="text-mono">{copy.portraitLabel}</span>
  </div>

  <div class="founder-author__copy">
    <span class="founder-author__role text-mono">{founderIdentity.role}</span>
    <h2 id="founder-author-name">{founderIdentity.name}</h2>
    <p>{copy.shortBio}</p>
    <a class="link-hover-arrow" href={founderProfilePath(locale)} data-article-author-profile>
      <span>{copy.profileCta}</span><span aria-hidden="true">&#8594;</span>
    </a>
  </div>
</aside>

<script>
  import { trackFunnelEvent } from '../../scripts/funnel-analytics';

  const setupAuthorCardTracking = () => {
    document.querySelectorAll<HTMLElement>('[data-article-author-profile]').forEach((link) => {
      if (link.dataset.authorTrackingReady === 'true') return;
      link.dataset.authorTrackingReady = 'true';
      link.addEventListener('click', () => trackFunnelEvent('article_author_profile_click'));
    });
  };

  setupAuthorCardTracking();
  document.addEventListener('astro:page-load', setupAuthorCardTracking);
</script>

<style>
  .founder-author {
    width: min(100%, 900px);
    display: grid;
    grid-template-columns: minmax(170px, 0.34fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
    margin: clamp(76px, 9vw, 118px) auto 0;
    border-block: 1px solid rgba(89, 106, 130, 0.34);
    padding-block: clamp(28px, 4vw, 44px);
  }

  .founder-author__portrait {
    aspect-ratio: 4 / 5;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 13px;
    border-radius: 8px;
    padding: 18px;
    background:
      radial-gradient(circle at 50% 34%, rgba(103, 217, 255, 0.12), transparent 34%),
      linear-gradient(145deg, rgba(15, 38, 57, 0.94), rgba(5, 12, 20, 0.98));
    color: rgba(226, 234, 243, 0.58);
    text-align: center;
  }

  .founder-author__portrait strong {
    color: rgba(238, 245, 250, 0.28);
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 560;
    letter-spacing: -0.04em;
  }

  .founder-author__portrait span {
    max-width: 18ch;
    font-size: 0.57rem;
    line-height: 1.5;
  }

  .founder-author__copy { min-width: 0; }

  .founder-author__role {
    display: block;
    margin-bottom: 10px;
    color: rgba(103, 217, 255, 0.7);
    font-size: 0.62rem;
  }

  .founder-author h2 {
    margin-bottom: 13px;
    font-size: clamp(1.8rem, 3vw, 2.7rem);
    font-weight: 540;
    letter-spacing: -0.035em;
  }

  .founder-author p {
    max-width: 54ch;
    margin-bottom: 18px;
    color: rgba(226, 234, 243, 0.74);
    font-size: 0.92rem;
    line-height: 1.62;
  }

  @media (max-width: 620px) {
    .founder-author {
      grid-template-columns: 112px minmax(0, 1fr);
      gap: 22px;
      align-items: start;
    }

    .founder-author__portrait { min-height: 140px; }
  }

  @media (max-width: 440px) {
    .founder-author {
      grid-template-columns: 1fr;
    }

    .founder-author__portrait {
      width: min(100%, 220px);
      aspect-ratio: 4 / 3;
    }
  }
</style>
