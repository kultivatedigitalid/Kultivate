---
import VideoLessonCard from './VideoLessonCard.astro';
import { getLearningLessons, type LearningCategory, type LearningLocale } from '../../data/learning';

interface Props {
  locale: LearningLocale;
  serviceId: LearningCategory;
}

const { locale, serviceId } = Astro.props;
const lessons = getLearningLessons(serviceId).slice(0, 3);
const copy = locale === 'id'
  ? {
      kicker: 'RELATED FREE LEARNING',
      title: 'Pelajari konteks sebelum menentukan pekerjaan',
      body: 'Gunakan materi berikut untuk memahami fondasi keputusan. Tidak ada formulir atau jawaban yang perlu dikirim.',
      all: 'Lihat semua materi gratis',
      roadmap: 'Temukan prioritas melalui roadmap'
    }
  : {
      kicker: 'RELATED FREE LEARNING',
      title: 'Learn the context before defining the work',
      body: 'Use these lessons to understand the foundations behind the decision. There is no form to complete and no answers to send.',
      all: 'View all free learning',
      roadmap: 'Find your priority with the roadmap'
    };
---

<section class="service-learning flow-section" aria-labelledby="service-learning-title">
  <div class="container">
    <header class="service-learning__header">
      <span class="section-kicker">{copy.kicker}</span>
      <h2 id="service-learning-title">{copy.title}</h2>
      <p>{copy.body}</p>
    </header>

    <div class="service-learning__lessons">
      {lessons.map((lesson, index) => (
        <VideoLessonCard lesson={lesson} locale={locale} context="service" index={index} />
      ))}
    </div>

    <div class="service-learning__links">
      <a class="link-hover-arrow" href={'/' + locale + '/services/#free-learning'}>
        <span>{copy.all}</span><span aria-hidden="true">→</span>
      </a>
      <a class="link-hover-arrow" href={'/' + locale + '/services/#website-growth-roadmap'}>
        <span>{copy.roadmap}</span><span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .service-learning { padding: clamp(84px, 10vw, 144px) 0; background: transparent; }
  .service-learning__header { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(260px, 0.7fr); gap: clamp(28px, 6vw, 92px); align-items: end; margin-bottom: clamp(54px, 7vw, 88px); }
  .service-learning__header .section-kicker { grid-column: 1 / -1; margin-bottom: -12px; }
  .service-learning__header h2 { max-width: 15ch; margin: 0; font-size: clamp(2.45rem, 1.8rem + 2.5vw, 4.8rem); font-weight: 520; letter-spacing: -0.045em; line-height: 0.98; text-wrap: balance; }
  .service-learning__header > p { max-width: 48ch; color: rgba(201, 211, 223, 0.76); line-height: 1.65; }
  .service-learning__lessons { margin-left: clamp(0px, 6vw, 96px); }
  .service-learning__links { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 18px 34px; margin-top: 42px; }

  @media (max-width: 760px) {
    .service-learning__header { grid-template-columns: minmax(0, 1fr); gap: 22px; }
    .service-learning__header .section-kicker { grid-column: auto; margin-bottom: 5px; }
    .service-learning__lessons { margin-left: 0; }
    .service-learning__links { justify-content: flex-start; }
  }
</style>
