---
import { getLearningSeries, type LearningLocale } from '../../data/learning';
import { editorialItems } from '../../data/editorial';

interface Props {
  locale: LearningLocale;
  serviceId: string;
}

const { locale, serviceId } = Astro.props;
const series = getLearningSeries().find((item) => item.category === serviceId);
const serviceLabels: Record<string, string> = { seo: 'SEO', 'web-services': 'Web Services', 'visual-strategy': 'Visual Strategy', 'social-media-management': 'Social Media Management' };
const serviceLabel = serviceLabels[serviceId];
// Internal provenance: provisional bridge to existing editorial content.
const articleCategory = serviceId === 'visual-strategy' ? 'Strategy' : 'Content';
const article = editorialItems[locale].find(item => item.category === articleCategory) ?? editorialItems[locale][0];
const copy = locale === 'id'
  ? {
      kicker: 'LEARN',
      title: `Pahami konteks ${serviceLabel} sebelum menentukan arah`,
      body: 'Mulai dari course yang paling dekat dengan masalah di atas. Materinya membantu Anda memahami pertanyaan penting sebelum memilih scope pekerjaan.',
      cta: series ? `Mulai ${series.title.id}` : 'Jelajahi Learn',
    }
  : {
      kicker: 'LEARN',
      title: `Understand the ${serviceLabel} context before choosing a direction`,
      body: 'Start with the course closest to the problems above. It helps you understand the important questions before choosing a scope of work.',
      cta: series ? `Start ${series.title.en}` : 'Explore Learn',
    };
if (!series) {
  copy.kicker = locale === 'id' ? 'INSIGHT TERKAIT' : 'RELATED INSIGHT';
  copy.title = article.title;
  copy.body = serviceId === 'visual-strategy'
    ? (locale === 'id' ? 'Sebelum menentukan arah visual, perjelas prioritas bisnis yang harus didukungnya. Artikel ini membantu Anda memulai dari keputusan tersebut.' : 'Before choosing a visual direction, clarify the business priority it needs to support. This article helps you start with that decision.')
    : (locale === 'id' ? 'Pertanyaan pelanggan dapat menjadi dasar tema dan ritme publikasi social media. Mulai dari prinsip konten dalam artikel ini.' : 'Customer questions can guide social media themes and publishing rhythm. Start with the content principles in this article.');
  copy.cta = locale === 'id' ? 'Baca artikel' : 'Read article';
}
const destination = series ? `/${locale}/learn/${series.slug}/` : `/${locale}/insights/${article.slug}/`;
---

<aside class="service-learning-link flow-section" aria-labelledby={`service-learning-${serviceId}`}>
  <div class="container">
    <div class="service-learning-link__layout" data-reveal>
      <div>
        <span class="section-kicker">{copy.kicker}</span>
        <h2 id={`service-learning-${serviceId}`}>{copy.title}</h2>
      </div>
      <div>
        <p>{copy.body}</p>
        <a class="link-hover-arrow" href={destination}>
          <span>{copy.cta}</span><span aria-hidden="true">&#8594;</span>
        </a>
      </div>
    </div>
  </div>
</aside>

<style>
  .service-learning-link {
    padding: clamp(62px, 7vw, 96px) 0;
  }

  .service-learning-link__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(280px, 0.58fr);
    gap: clamp(38px, 9vw, 132px);
    align-items: end;
    padding: clamp(32px, 5vw, 58px) 0;
    border-block: 1px solid rgba(126, 153, 178, 0.22);
  }

  .service-learning-link .section-kicker {
    display: block;
    margin-bottom: 16px;
  }

  .service-learning-link h2 {
    max-width: 17ch;
    font-size: clamp(2rem, 3.5vw, 3.85rem);
    font-weight: 520;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .service-learning-link p {
    max-width: 50ch;
    margin-bottom: 24px;
    color: rgba(201, 211, 223, 0.76);
    line-height: 1.65;
  }

  @media (max-width: 760px) {
    .service-learning-link__layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 26px;
    }
  }
</style>
