---
import VideoLessonCard from './VideoLessonCard.astro';
import { getLearningLessons, type LearningCategory, type LearningLocale } from '../../data/learning';

interface Props { locale: LearningLocale; }
const { locale } = Astro.props;

const pathways: Array<{ id: LearningCategory; title: string; description: string }> = locale === 'id'
  ? [
      {
        id: 'seo',
        title: 'Ditemukan dengan konteks yang tepat',
        description: 'Pelajari hubungan antara demand, struktur halaman, technical SEO, serta AEO & GEO tanpa memisahkannya dari keputusan bisnis.'
      },
      {
        id: 'web-services',
        title: 'Mengubah perhatian menjadi tindakan',
        description: 'Pelajari kapan website perlu diperbaiki, dibangun ulang, atau dimigrasikan agar pengalaman, trust, dan next step bekerja lebih baik.'
      }
    ]
  : [
      {
        id: 'seo',
        title: 'Get found in the right context',
        description: 'Learn how demand, page structure, technical SEO, and AEO & GEO connect to business decisions.'
      },
      {
        id: 'web-services',
        title: 'Turn attention into action',
        description: 'Learn when to fix, rebuild, or migrate a website so experience, trust, and the next step work better.'
      }
    ];

const copy = locale === 'id'
  ? {
      kicker: 'FREE LEARNING',
      title: 'Mulai dari pemahaman, bukan asumsi',
      body: 'Materi gratis ini disusun berdasarkan dua layanan utama kami. Mulai dari pengantar yang paling relevan, lalu lanjutkan sesuai masalah yang sedang Anda hadapi.',
      introduction: 'Pengantar materi gratis',
      continue: 'Lanjutkan pembelajaran',
      services: 'Layanan',
      roadmap: 'Website Growth Roadmap',
      unsure: 'Belum yakin mulai dari mana? Temukan prioritas Anda'
    }
  : {
      kicker: 'FREE LEARNING',
      title: 'Start with understanding, not assumptions',
      body: 'These free materials are organized around our two core services. Begin with the most relevant introduction, then continue with the problem you are trying to solve.',
      introduction: 'Introduction to the free material',
      continue: 'Continue learning',
      services: 'Services',
      roadmap: 'Website Growth Roadmap',
      unsure: 'Not sure where to start? Find your priority'
    };

const pathwayGroups = pathways.map((pathway) => {
  const lessons = getLearningLessons(pathway.id);
  const featured = lessons.find((lesson) => lesson.featured) ?? lessons[0];

  return {
    ...pathway,
    featured,
    remaining: lessons.filter((lesson) => lesson.id !== featured.id)
  };
});

const lessonCount = (count: number) => locale === 'id' ? `${count} materi` : `${count} lessons`;
---

<section id="free-learning" class="free-learning-hub flow-section" aria-labelledby="free-learning-title" data-free-learning>
  <div class="container">
    <nav class="learning-jumps text-mono" aria-label={locale === 'id' ? 'Bagian halaman layanan' : 'Services page sections'}>
      <a href="#services-list">{copy.services}</a>
      <span aria-hidden="true">/</span>
      <a href="#free-learning" aria-current="location">Free Learning</a>
      <span aria-hidden="true">/</span>
      <a href="#website-growth-roadmap" data-learning-roadmap-link>{copy.roadmap}</a>
    </nav>

    <header class="learning-header">
      <span class="section-kicker">{copy.kicker}</span>
      <h2 id="free-learning-title">{copy.title}</h2>
      <p>{copy.body}</p>
    </header>

    <div class="learning-pathways">
      {pathwayGroups.map((pathway, pathwayIndex) => (
        <section class="learning-pathway" aria-labelledby={'pathway-' + pathway.id}>
          <header class="pathway-header">
            <div class="pathway-title">
              <span class="pathway-index text-mono">{String(pathwayIndex + 1).padStart(2, '0')} / {pathway.id === 'seo' ? 'SEO' : 'WEB SERVICES'}</span>
              <h3 id={'pathway-' + pathway.id}>{pathway.title}</h3>
              <p>{pathway.description}</p>
            </div>
            <span class="pathway-count text-mono">{lessonCount(pathway.remaining.length + 1)}</span>
          </header>

          <div class="pathway-featured" data-reveal>
            <VideoLessonCard
              lesson={pathway.featured}
              locale={locale}
              context="hub"
              index={0}
              display="featured"
              eyebrow={copy.introduction}
            />
          </div>

          <div class="pathway-library">
            <div class="pathway-library__header">
              <span class="text-mono">{copy.continue}</span>
              <span class="text-mono">{lessonCount(pathway.remaining.length)}</span>
            </div>
            <div class="pathway-lessons">
              {pathway.remaining.map((lesson, index) => (
                <VideoLessonCard
                  lesson={lesson}
                  locale={locale}
                  context="hub"
                  index={index + 1}
                  display="standard"
                />
              ))}
            </div>
          </div>
        </section>
      ))}
    </div>

    <a class="learning-roadmap-link link-hover-arrow" href="#website-growth-roadmap" data-learning-roadmap-link>
      <span>{copy.unsure}</span><span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<script>
  import { trackFunnelEvent } from '../../scripts/funnel-analytics';

  const setupLearningHub = () => {
    document.querySelectorAll<HTMLElement>('[data-free-learning]').forEach((root) => {
      if (root.dataset.learningReady === 'true') return;
      root.dataset.learningReady = 'true';

      const recordView = () => {
        if (root.dataset.viewTracked === 'true') return;
        root.dataset.viewTracked = 'true';
        trackFunnelEvent('free_learning_view');
      };

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          recordView();
          observer.disconnect();
        }, { threshold: 0.15 });
        observer.observe(root);
      } else {
        recordView();
      }

      root.querySelectorAll('[data-learning-roadmap-link]').forEach((link) => {
        link.addEventListener('click', () => {
          trackFunnelEvent('free_learning_to_roadmap_click');
        });
      });
    });
  };

  setupLearningHub();
  document.addEventListener('astro:page-load', setupLearningHub);
</script>

<style>
  .free-learning-hub {
    position: relative;
    scroll-margin-top: 82px;
    margin-top: -2px;
    padding: clamp(70px, 8vw, 112px) 0 clamp(96px, 11vw, 154px);
    overflow: hidden;
    background: transparent;
  }

  .free-learning-hub::before {
    content: '';
    position: absolute;
    inset: 4% 0 5%;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 62% 20% at 88% 20%, rgba(103, 217, 255, 0.065), transparent 76%),
      radial-gradient(ellipse 70% 18% at 10% 72%, rgba(70, 134, 183, 0.09), transparent 78%);
  }

  .free-learning-hub > .container {
    position: relative;
    z-index: 1;
  }

  .learning-jumps {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 14px;
    margin-bottom: clamp(62px, 8vw, 102px);
    color: rgba(169, 194, 211, 0.56);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .learning-jumps a { color: inherit; }
  .learning-jumps a[aria-current='location'] { color: var(--signal-ice); }

  .learning-header {
    display: grid;
    grid-template-columns: minmax(0, 1.16fr) minmax(280px, 0.64fr);
    gap: clamp(34px, 7vw, 104px);
    align-items: end;
    margin-bottom: clamp(78px, 10vw, 126px);
  }

  .learning-header .section-kicker {
    grid-column: 1 / -1;
    margin-bottom: -12px;
  }

  .learning-header h2 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2.8rem, 2rem + 3vw, 5.7rem);
    font-weight: 520;
    letter-spacing: -0.048em;
    line-height: 0.94;
    text-wrap: balance;
  }

  .learning-header > p {
    max-width: 48ch;
    color: rgba(201, 211, 223, 0.76);
    line-height: 1.68;
  }

  .learning-pathways {
    display: grid;
    gap: clamp(116px, 14vw, 190px);
  }

  .learning-pathway {
    min-width: 0;
    border-top: 1px solid rgba(89, 106, 130, 0.34);
    padding-top: clamp(30px, 4vw, 48px);
  }

  .pathway-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 32px;
    align-items: start;
    margin-bottom: clamp(42px, 6vw, 72px);
  }

  .pathway-title { min-width: 0; }

  .pathway-index {
    display: block;
    margin-bottom: 18px;
    color: rgba(103, 217, 255, 0.72);
    font-size: 0.64rem;
  }

  .pathway-header h3 {
    max-width: 18ch;
    margin-bottom: 15px;
    font-size: clamp(2.15rem, 1.55rem + 2vw, 3.8rem);
    font-weight: 520;
    letter-spacing: -0.04em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .pathway-header p {
    max-width: 64ch;
    color: rgba(201, 211, 223, 0.7);
    line-height: 1.62;
  }

  .pathway-count {
    padding-top: 3px;
    color: rgba(201, 211, 223, 0.48);
    white-space: nowrap;
  }

  .pathway-featured {
    width: min(100%, 1180px);
  }

  .pathway-library {
    margin-top: clamp(58px, 7vw, 88px);
  }

  .pathway-library__header {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    border-block: 1px solid rgba(89, 106, 130, 0.28);
    padding-block: 16px;
    color: rgba(201, 211, 223, 0.52);
  }

  .pathway-lessons {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 42px);
    padding-top: clamp(30px, 4vw, 46px);
  }

  .learning-roadmap-link {
    width: fit-content;
    max-width: 100%;
    margin: clamp(84px, 10vw, 132px) 0 0 auto;
    font-size: clamp(1rem, 0.92rem + 0.4vw, 1.25rem);
  }

  @media (max-width: 980px) {
    .pathway-lessons {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .pathway-lessons > :global(:last-child) {
      grid-column: 1 / -1;
      width: min(100%, calc(50% - 12px));
    }
  }

  @media (max-width: 760px) {
    .learning-header { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .learning-header .section-kicker { grid-column: auto; margin-bottom: 6px; }
    .pathway-header { grid-template-columns: minmax(0, 1fr); gap: 18px; }
    .pathway-count { padding-top: 0; }
    .pathway-lessons { grid-template-columns: minmax(0, 1fr); }
    .pathway-lessons > :global(:last-child) { grid-column: auto; width: auto; }
    .learning-roadmap-link { margin-left: 0; }
  }
</style>
