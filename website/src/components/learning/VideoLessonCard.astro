---
import type { LearningLesson, LearningLocale } from '../../data/learning';

interface Props {
  lesson: LearningLesson;
  locale: LearningLocale;
  context?: 'hub' | 'service';
  index?: number;
}

const { lesson, locale, context = 'hub', index = 0 } = Astro.props;
const categoryLabel = lesson.category === 'seo' ? 'SEO' : 'Web Services';
const hasVideo = lesson.videoId.trim().length > 0;
const title = lesson.title[locale];
const playLabel = locale === 'id' ? 'Putar: ' + title : 'Play: ' + title;
---

<article
  id={'lesson-' + lesson.id}
  class:list={['lesson-card', { 'lesson-card--featured': lesson.featured }]}
  data-video-lesson
  data-video-id={hasVideo ? lesson.videoId : undefined}
  data-lesson-id={lesson.id}
  data-category={lesson.category}
  data-learning-context={context}
>
  <div class="lesson-card__visual">
    {hasVideo ? (
      <button class="lesson-card__play" type="button" data-video-load aria-label={playLabel}>
        {lesson.poster && <img src={lesson.poster} alt="" width="1280" height="720" loading="lazy" decoding="async" />}
        <span class="lesson-card__signal" aria-hidden="true"><span></span></span>
      </button>
    ) : (
      <div class="lesson-card__graphic" aria-hidden="true">
        <span>{String(index + 1).padStart(2, '0')}</span>
        <i></i><i></i><i></i>
      </div>
    )}
  </div>

  <div class="lesson-card__body">
    <div class="lesson-card__meta text-mono">
      <span>{categoryLabel}</span>
      {lesson.duration && <span>{lesson.duration}</span>}
    </div>
    <h3>{title}</h3>
    <p>{lesson.summary[locale]}</p>
    <div class="lesson-card__outcome">
      <span class="text-mono">{locale === 'id' ? 'HASIL BELAJAR' : 'TAKEAWAY'}</span>
      <p>{lesson.outcome[locale]}</p>
    </div>
  </div>
</article>

<script>
  import { trackFunnelEvent } from '../../scripts/funnel-analytics';

  const setupVideoLessons = () => {
    document.querySelectorAll<HTMLElement>('[data-video-lesson]').forEach((card) => {
      if (card.dataset.videoReady === 'true') return;
      card.dataset.videoReady = 'true';

      card.querySelector<HTMLButtonElement>('[data-video-load]')?.addEventListener('click', (event) => {
        const button = event.currentTarget as HTMLButtonElement;
        const videoId = card.dataset.videoId;
        if (!videoId) return;

        const context = card.dataset.learningContext;
        trackFunnelEvent(
          context === 'service' ? 'service_learning_video_click' : 'free_learning_video_click',
          { lesson_id: card.dataset.lessonId ?? '', category: card.dataset.category ?? '' }
        );

        const iframe = document.createElement('iframe');
        iframe.src = 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(videoId) + '?autoplay=1&rel=0';
        iframe.title = button.getAttribute('aria-label')?.replace(/^Play: |^Putar: /, '') ?? 'Video lesson';
        iframe.loading = 'lazy';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        button.replaceWith(iframe);
      });
    });
  };

  setupVideoLessons();
  document.addEventListener('astro:page-load', setupVideoLessons);
</script>

<style>
  .lesson-card {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(180px, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(22px, 3.5vw, 48px);
    align-items: start;
    padding-block: clamp(24px, 3.4vw, 42px);
    border-top: 1px solid rgba(126, 153, 178, 0.18);
  }

  .lesson-card__visual {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 6px;
    background: linear-gradient(145deg, rgba(13, 35, 54, 0.96), rgba(5, 12, 20, 0.98));
  }

  .lesson-card__play,
  .lesson-card__graphic,
  .lesson-card__visual :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .lesson-card__play { position: relative; display: grid; place-items: center; color: var(--cloud-white); cursor: pointer; }
  .lesson-card__play img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.62; }
  .lesson-card__signal { position: relative; z-index: 1; width: 58px; aspect-ratio: 1; display: grid; place-items: center; border: 1px solid rgba(214, 239, 250, 0.52); border-radius: 50%; background: rgba(4, 11, 18, 0.62); }
  .lesson-card__signal span { width: 0; height: 0; margin-left: 4px; border-block: 7px solid transparent; border-left: 11px solid currentColor; }
  .lesson-card__play:focus-visible { outline: 2px solid var(--cyan-glow); outline-offset: -3px; }

  .lesson-card__graphic { position: relative; padding: 16px; }
  .lesson-card__graphic > span { color: rgba(213, 230, 241, 0.48); font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.12em; }
  .lesson-card__graphic i { position: absolute; left: 15%; right: 15%; height: 1px; background: linear-gradient(90deg, transparent, rgba(103, 217, 255, 0.54), transparent); }
  .lesson-card__graphic i:nth-of-type(1) { top: 44%; }
  .lesson-card__graphic i:nth-of-type(2) { top: 57%; left: 24%; right: 7%; opacity: 0.64; }
  .lesson-card__graphic i:nth-of-type(3) { top: 70%; left: 8%; right: 34%; opacity: 0.36; }

  .lesson-card__body { min-width: 0; }
  .lesson-card__meta { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-bottom: 14px; color: rgba(169, 194, 211, 0.62); font-size: 0.64rem; }
  .lesson-card__meta span + span::before { content: '·'; margin-right: 18px; }
  .lesson-card h3 { max-width: 27ch; margin-bottom: 14px; font-size: clamp(1.35rem, 1.05rem + 1vw, 2rem); font-weight: 540; letter-spacing: -0.026em; line-height: 1.1; text-wrap: balance; }
  .lesson-card__body > p { max-width: 55ch; color: rgba(201, 211, 223, 0.76); font-size: 0.94rem; line-height: 1.62; }
  .lesson-card__outcome { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 18px; margin-top: 22px; padding-top: 18px; border-top: 1px solid rgba(126, 153, 178, 0.12); }
  .lesson-card__outcome > span { color: rgba(103, 217, 255, 0.7); font-size: 0.59rem; }
  .lesson-card__outcome p { max-width: 44ch; color: rgba(226, 234, 243, 0.86); font-size: 0.88rem; line-height: 1.5; }

  @media (hover: hover) and (pointer: fine) {
    .lesson-card__play:hover .lesson-card__signal { border-color: var(--cyan-glow); background: rgba(8, 24, 37, 0.78); }
  }

  @media (max-width: 620px) {
    .lesson-card { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .lesson-card__visual { max-width: 480px; }
    .lesson-card__outcome { grid-template-columns: minmax(0, 1fr); gap: 8px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lesson-card__play * { transition: none !important; }
  }
</style>
