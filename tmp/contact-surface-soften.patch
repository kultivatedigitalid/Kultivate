diff --git a/website/src/pages/en/contact.astro b/website/src/pages/en/contact.astro
--- a/website/src/pages/en/contact.astro
+++ b/website/src/pages/en/contact.astro
@@ -285,7 +285,7 @@
     min-width: 0;
     max-width: 100%;
     padding: 14px 16px;
-    background: rgba(7, 16, 26, 0.32);
+    background: rgba(7, 16, 26, 0.18);
     border: 0;
     border-radius: 10px;
@@ -309,7 +309,7 @@
